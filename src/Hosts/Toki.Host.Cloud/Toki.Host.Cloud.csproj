<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
    <UserSecretsId>toki-host-cloud</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Certificates" />
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
  </ItemGroup>
  <ItemGroup>
    <!-- TK-152: the DGII XSDs of the receiver (acknowledgement, approval) and of the e-CF types the store already validates (linked, not copied). -->
    <EmbeddedResource Include="Fe\Schemas\*.xsd" LogicalName="Toki.Fe.Schemas.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Modules\Fiscal\Toki.Fiscal\Schemas\e-CF 3*.xsd" LogicalName="Toki.Fe.Schemas.%(Filename)%(Extension)" Link="Fe\Schemas\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Read-only: the event payloads the stores upload (deserialized with the same JSON options as the node outbox). -->
    <ProjectReference Include="..\..\BuildingBlocks\Toki.BuildingBlocks\Toki.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\Modules\Sales\Toki.Sales.Contracts\Toki.Sales.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\CashRegister\Toki.CashRegister.Contracts\Toki.CashRegister.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Inventory\Toki.Inventory.Contracts\Toki.Inventory.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Fiscal\Toki.Fiscal.Contracts\Toki.Fiscal.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Toki.Identity.Contracts\Toki.Identity.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Purchasing\Toki.Purchasing.Contracts\Toki.Purchasing.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Customers\Toki.Customers.Contracts\Toki.Customers.Contracts.csproj" />
    <ProjectReference Include="..\..\Modules\Sync\Toki.Sync.Contracts\Toki.Sync.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Toki.Cloud.Tests" />
  </ItemGroup>
</Project>
