{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4173 --strictPort",
      "startServerReadyPattern": "4173",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/carniceria",
        "http://localhost:4173/colmado",
        "http://localhost:4173/deli",
        "http://localhost:4173/e-cf",
        "http://localhost:4173/certificacion",
        "http://localhost:4173/descargar",
        "http://localhost:4173/precios",
        "http://localhost:4173/comparar",
        "http://localhost:4173/novedades",
        "http://localhost:4173/privacidad"
      ],
      "numberOfRuns": 1,
      "settings": { "formFactor": "mobile", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:seo": ["error", { "minScore": 1 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        { "matchingUrlPattern": "^http://localhost:4173/$", "assertions": { "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }] } },
        { "matchingUrlPattern": "^http://localhost:4173/.+", "assertions": { "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }] } }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": "./.lighthouseci" }
  }
}
