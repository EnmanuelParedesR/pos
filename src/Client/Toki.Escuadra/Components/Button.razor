<button type="@Type" class="@Classes" disabled="@Disabled" @onclick="OnClick" @attributes="Attributes">
    @ChildContent
    @if (Shortcut is not null)
    {
        <Keycap>@Shortcut</Keycap>
    }
</button>

@code {
    public enum Variants { Normal, Primary, Danger, Ghost }

    [Parameter] public Variants Variant { get; set; }
    /// <summary>The key that does the same, shown as a keycap.</summary>
    [Parameter] public string? Shortcut { get; set; }
    /// <summary>72 px: actions that move money (Cobrar, Confirmar cobro).</summary>
    [Parameter] public bool Money { get; set; }
    [Parameter] public bool Wide { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }

    private string Classes => "esc-button"
        + Variant switch { Variants.Primary => " esc-button--primary", Variants.Danger => " esc-button--danger", Variants.Ghost => " esc-button--ghost", _ => "" }
        + (Money ? " esc-button--money" : "") + (Wide ? " esc-button--wide" : "");
}
