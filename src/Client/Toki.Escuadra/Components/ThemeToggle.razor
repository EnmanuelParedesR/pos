@* Admin theme (TK-183): automático (the system's) → claro → oscuro, remembered on this device by escuadra.js (localStorage). *@
@inject IJSRuntime JS

<button type="button" class="@Class" title="@($"Tema: {Label}. Cambiar a {NextLabel}")" aria-label="@($"Tema: {Label}. Cambiar a {NextLabel}")" @onclick="NextAsync">
    <Icon Name="@IconName" Size="@Size" />@if (ShowLabel) { <span class="esc-side__label">Tema: @Label</span> }
</button>

@code {
    [Parameter] public string Class { get; set; } = "esc-side__item";
    [Parameter] public bool ShowLabel { get; set; } = true;
    [Parameter] public int Size { get; set; } = 20;

    private string _theme = "system";

    private string Label => Name(_theme);
    private string NextLabel => Name(Next(_theme));
    private string IconName => _theme switch { "light" => "sun", "dark" => "moon", _ => "monitor" };

    private static string Next(string theme) => theme switch { "system" => "light", "light" => "dark", _ => "system" };
    private static string Name(string theme) => theme switch { "light" => "claro", "dark" => "oscuro", _ => "automático" };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _theme = await JS.InvokeAsync<string?>("escuadra.getTheme") ?? "system";
        StateHasChanged();
    }

    private async Task NextAsync()
    {
        _theme = Next(_theme);
        await JS.InvokeVoidAsync("escuadra.setTheme", _theme);
    }
}
