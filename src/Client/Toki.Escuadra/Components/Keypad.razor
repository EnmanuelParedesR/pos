<div class="esc-keypad" role="group" aria-label="Teclado numérico">
    @foreach (var k in Digits)
    {
        <button type="button" @onclick="() => OnKey.InvokeAsync(k)">@k</button>
    }
    @if (WithDot)
    {
        <button type="button" @onclick='() => OnKey.InvokeAsync(".")'>.</button>
    }
    else
    {
        <button type="button" @onclick='() => OnKey.InvokeAsync("clear")' aria-label="Limpiar">C</button>
    }
    <button type="button" @onclick='() => OnKey.InvokeAsync("0")'>0</button>
    <button type="button" @onclick='() => OnKey.InvokeAsync("backspace")' aria-label="Borrar">⌫</button>
</div>

@code {
    private static readonly string[] Digits = ["7", "8", "9", "4", "5", "6", "1", "2", "3"];

    [Parameter] public bool WithDot { get; set; }
    /// <summary>"0".."9", ".", "backspace" or "clear".</summary>
    [Parameter] public EventCallback<string> OnKey { get; set; }

    /// <summary>Applies a key to a text the way every keypad in Toki does.</summary>
    public static string Apply(string current, string key, int max = 12) => key switch
    {
        "backspace" => current.Length > 0 ? current[..^1] : current,
        "clear" => "",
        "." when current.Contains('.', StringComparison.Ordinal) => current,
        _ when current.Length >= max => current,
        _ => current + key,
    };
}
