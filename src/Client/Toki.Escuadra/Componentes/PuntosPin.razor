<div class="esc-pin" role="img" aria-label="@($"{Largo} de {Maximo} dígitos")">
    @for (var i = 0; i < Maximo; i++)
    {
        <span class="@(i < Largo ? "lleno" : "")"></span>
    }
</div>

@code {
    [Parameter] public int Largo { get; set; }
    [Parameter] public int Maximo { get; set; } = 4;
}
