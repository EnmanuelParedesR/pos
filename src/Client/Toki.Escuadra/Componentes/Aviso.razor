@* Inline notice: the register never stops for a modal when a code is not found or a label repeats. *@
<div class="esc-aviso esc-aviso--@Tipo.ToString().ToLowerInvariant()" role="@(Tipo is Tipos.Error or Tipos.Aviso ? "alert" : "status")">
    <Icono Nombre="@(Tipo switch { Tipos.Exito => "check", Tipos.Info => "info", _ => "alerta" })" />
    <div class="esc-aviso__cuerpo">
        <div>@Titulo</div>
        @if (ChildContent is not null)
        {
            <div class="esc-aviso__detalle">@ChildContent</div>
        }
    </div>
    @Accion
</div>

@code {
    public enum Tipos { Error, Aviso, Exito, Info }

    [Parameter] public Tipos Tipo { get; set; } = Tipos.Error;
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Accion { get; set; }
}
