@* Logo C5: the tag with the winking eye. On the dark frame the word is light; on light surfaces it is dark. *@
<span class="esc-logo" style="font-size:@(Tamano * 7 / 10)px; color:@(SobreMarco ? "#F1F3F5" : "var(--texto)")">
    <svg role="img" aria-label="Toki" width="@Tamano" height="@Tamano" viewBox="0 0 120 120">
        <path d="M44 24 H96 Q104 24 104 32 V88 Q104 96 96 96 H44 L16 60 Z" fill="#0B5CAD" stroke="#0B5CAD" stroke-width="6" stroke-linejoin="round"></path>
        <circle cx="35" cy="60" r="8" fill="#FFFFFF"></circle>
        <circle cx="32.5" cy="60" r="3.8" fill="#14181D"></circle>
        <path d="M70 36 V76 Q70 84 78 84 H86 M58 50 H86" fill="none" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    @if (ConNombre)
    {
        <span aria-hidden="true">toki</span>
    }
</span>

@code {
    [Parameter] public int Tamano { get; set; } = 22;
    [Parameter] public bool ConNombre { get; set; } = true;
    [Parameter] public bool SobreMarco { get; set; }
}
