<div class="esc-teclado" role="group" aria-label="Teclado numérico">
    @foreach (var t in Digitos)
    {
        <button type="button" @onclick="() => OnTecla.InvokeAsync(t)">@t</button>
    }
    @if (ConPunto)
    {
        <button type="button" @onclick='() => OnTecla.InvokeAsync(".")'>.</button>
    }
    else
    {
        <button type="button" @onclick='() => OnTecla.InvokeAsync("limpiar")' aria-label="Limpiar">C</button>
    }
    <button type="button" @onclick='() => OnTecla.InvokeAsync("0")'>0</button>
    <button type="button" @onclick='() => OnTecla.InvokeAsync("borrar")' aria-label="Borrar">⌫</button>
</div>

@code {
    private static readonly string[] Digitos = ["7", "8", "9", "4", "5", "6", "1", "2", "3"];

    [Parameter] public bool ConPunto { get; set; }
    /// <summary>"0".."9", ".", "borrar" or "limpiar".</summary>
    [Parameter] public EventCallback<string> OnTecla { get; set; }

    /// <summary>Applies a key to a text the way every keypad in Toki does.</summary>
    public static string Aplicar(string actual, string tecla, int maximo = 12) => tecla switch
    {
        "borrar" => actual.Length > 0 ? actual[..^1] : actual,
        "limpiar" => "",
        "." when actual.Contains('.', StringComparison.Ordinal) => actual,
        _ when actual.Length >= maximo => actual,
        _ => actual + tecla,
    };
}
