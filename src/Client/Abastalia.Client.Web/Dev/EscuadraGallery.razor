@page "/dev/escuadra"
@layout DevLayout
@using Abastalia.Escuadra
@using Abastalia.Escuadra.Components
@* TK-243: every Escuadra piece in each of its states, for visual review (Development only: Program.cs adds this assembly to the router).
   The register is light only (docs/sistema-de-diseno.md); the back office is shown light and dark side by side. *@

<div class="esc-page">
    <h1 class="esc-title">Escuadra · galería</h1>
    <p class="esc-subtitle">Solo en desarrollo. La caja es siempre clara; la administración se ve en claro y en oscuro.</p>

    <h2 class="esc-label">Barra de estado</h2>
    <header class="esc-status-bar">
        <div class="esc-status-bar__group">
            <Logo OnFrame="true" /><span style="font-weight:600">Caja 1</span><span>Yudelka M.</span><span class="muted">Turno abierto 8:02 a. m.</span>
        </div>
        <div class="esc-status-bar__group">
            <span class="muted">e-CF en cola: 0</span>
            <span class="esc-offline">e-CF en cola: 7</span>
            <span class="esc-status-bar__device muted"><Icon Name="scale" Size="16" />Balanza conectada</span>
            <span class="esc-status-bar__device muted"><Icon Name="printer" Size="16" />Impresora configurada</span>
            <span class="esc-status-bar__device esc-offline"><Icon Name="printer" Size="16" />Impresora sin respuesta</span>
            <span class="muted">En línea</span>
            <span class="esc-offline">Sin conexión con el servidor · reintentando</span>
        </div>
    </header>

    <h2 class="esc-label">Barra de teclas</h2>
    <nav class="esc-key-bar" aria-label="Teclas">
        <button type="button"><Keycap>F3</Keycap> Cantidad</button>
        <button type="button"><Keycap>F4</Keycap> Precio</button>
        <button type="button" disabled><Keycap>F7</Keycap> Descuento</button>
        <button type="button"><Keycap>F9</Keycap> Caja</button>
    </nav>

    <h2 class="esc-label">Botones y teclas</h2>
    <div class="esc-row">
        <Button>Normal</Button>
        <Button Variant="Button.Variants.Primary" Shortcut="Enter">Principal</Button>
        <Button Variant="Button.Variants.Danger">Peligro</Button>
        <Button Variant="Button.Variants.Ghost">Fantasma</Button>
        <Button Disabled="true">Desactivado</Button>
        <Keycap>F2</Keycap><Keycap>Esc</Keycap><Keycap>Supr</Keycap>
    </div>
    <div style="max-width:380px"><Button Variant="Button.Variants.Primary" Money="true" Wide="true" Shortcut="F12">Cobrar</Button></div>

    <h2 class="esc-label">Campo de escaneo, chips y teclado</h2>
    <label class="esc-card sale__scan-frame" style="max-width:520px">
        <Icon Name="barcode" />
        <input class="sale__scanner" placeholder="Escanee o escriba el código o PLU" aria-label="Código de barras o PLU" />
        <Keycap>F2</Keycap>
    </label>
    <div class="esc-row">
        <button type="button" class="esc-chip" aria-pressed="true">Res</button>
        <button type="button" class="esc-chip" aria-pressed="false">Cerdo</button>
        <button type="button" class="esc-chip" aria-pressed="false">Embutidos</button>
    </div>
    <div class="esc-row" style="align-items:flex-start">
        <div style="width:240px"><Keypad /></div>
        <div style="width:240px"><Keypad WithDot="true" /></div>
        <div class="esc-col"><PinDots Length="0" /><PinDots Length="2" /><PinDots Length="4" /></div>
    </div>

    <h2 class="esc-label">Lectura de balanza</h2>
    <div class="esc-col">
        @foreach (var s in Enum.GetValues<ScaleReadout.States>())
        {
            <ScaleReadout Pounds="@(s == ScaleReadout.States.Empty ? 0m : 1.755m)" State="s" />
        }
    </div>

    <h2 class="esc-label">Mosaico, líneas y totales</h2>
    <div class="sale__tiles" style="max-width:520px">
        <button type="button" class="esc-tile"><span class="esc-tile__name">Chuleta ahumada</span><span class="esc-tile__price">RD$ 185.00 / lb</span></button>
        <button type="button" class="esc-tile"><span class="esc-tile__name">Salami Induveca</span><span class="esc-tile__price">RD$ 210.00</span></button>
    </div>
    <div class="esc-card" style="max-width:420px">
        <ol class="sale__lines">
            <li class="sale__line"><div><div style="font-weight:600">Salami Induveca</div><div class="esc-subtitle">1 × 210.00</div></div><div class="esc-num">210.00</div></li>
            <li class="sale__line selected" aria-current="true"><div><div style="font-weight:600">Chuleta ahumada</div><div class="esc-subtitle">1.755 lb × 185.00</div></div><div class="esc-num">324.68</div></li>
            <li class="sale__line invalid"><div><div style="font-weight:600">Queso</div><div class="esc-error-help">El descuento es mayor que la línea. Cámbielo con F7.</div></div><div class="esc-num">-5.00</div></li>
        </ol>
        <div class="sale__totals">
            <ScaleReadout Pounds="1.755m" State="ScaleReadout.States.Stable" />
            <div class="esc-row" style="justify-content:space-between;align-items:baseline"><span class="esc-label">Total · 3 líneas</span><Money Value="529.68m" Size="44" /></div>
            <div class="esc-label">Devuelta</div><Money Value="470.32m" Size="52" />
        </div>
    </div>

    <h2 class="esc-label">Estado y avisos en línea</h2>
    <div class="esc-row">
        <span class="esc-pill esc-pill--success">Pagada</span><span class="esc-pill esc-pill--warning">Pendiente</span>
        <span class="esc-pill esc-pill--error">Rechazada</span><span class="esc-pill esc-pill--neutral">Consumo</span>
    </div>
    <Notice Kind="Notice.Kinds.Error" Title="No se encontró el código 7460000000017.">Búsquelo en las categorías o escriba su PLU.</Notice>
    <Notice Kind="Notice.Kinds.Warning" Title="Esta etiqueta ya está en la venta.">Cada etiqueta de peso se cobra una sola vez.</Notice>
    <Notice Kind="Notice.Kinds.Success" Title="Venta guardada · E320000000001" />
    <Notice Kind="Notice.Kinds.Info" Title="Venta anulada antes de cobrar." />
    <div><Button OnClick="() => _dialog = true">Abrir diálogo</Button></div>

    <h2 class="esc-label">Administración · claro y oscuro</h2>
    <div class="esc-row" style="align-items:stretch">
        <div class="esc-admin" style="flex:1 1 420px;padding:16px">@Admin</div>
        <div class="esc-admin" data-theme="dark" style="flex:1 1 420px;padding:16px">@Admin</div>
    </div>
</div>

@if (_dialog)
{
    <Dialog Title="¿Anular esta venta?" Subtitle="Se borran todas las líneas." OnClose="() => _dialog = false">
        <Footer>
            <Button OnClick="() => _dialog = false" Shortcut="Esc">No, seguir vendiendo</Button>
            <Button Variant="Button.Variants.Danger" Shortcut="Enter">Sí, anular</Button>
        </Footer>
    </Dialog>
}

@code {
    private bool _dialog;
    private string _period = "today";

    private static readonly BarChart.Point[] Week =
    [
        new("L", "Lunes", 18_500m, 16_000m), new("M", "Martes", 21_300m, 22_000m), new("M", "Miércoles", 0m, 9_000m),
        new("J", "Jueves", 25_800m, 19_500m, IsCurrent: true),
    ];

    private RenderFragment Admin => @<div class="esc-col" style="gap:16px">
        <ThemeToggle Class="esc-button" />
        <div class="esc-row">
            <Button>Normal</Button><Button Variant="Button.Variants.Primary">Principal</Button><Button Variant="Button.Variants.Danger">Peligro</Button>
        </div>
        <Segmented Label="Periodo" Options="@([("today", "Hoy"), ("yesterday", "Ayer"), ("week", "7 días"), ("month", "Mes")])" Value="@_period" ValueChanged="v => _period = v" />
        <div class="esc-row"><Delta Current="112" Previous="100" /><Delta Current="88" Previous="100" /><Delta Current="100" Previous="100" /></div>
        <Field Label="Nombre" Hint="Como sale en la factura."><input class="esc-input" value="Carnicería La Esquina" /></Field>
        <Field Label="RNC" Error="El RNC tiene 9 dígitos."><input class="esc-input" aria-invalid="true" value="1312" /></Field>
        <div class="esc-row">
            <span class="esc-pill esc-pill--success">Al día</span><span class="esc-pill esc-pill--warning">Por vencer</span><span class="esc-pill esc-pill--error">Faltante</span>
        </div>
        <Notice Kind="Notice.Kinds.Info" Title="Hay 3 cosas para revisar." />
        <BarChart Label="Ventas de la semana" Points="Week" />
        <span style="color:var(--data-1)"><Sparkline Values="@([3m, 5m, 4m, 8m, 7m, 10m])" /></span>
        <Skeleton Width="60%" />
        <EmptyState Title="Todavía no hay compras">Registre la primera en Compras.</EmptyState>
    </div>;
}
