@inject AbastaliaApi Api
@inject Cart Cart
@inject Approver Approver
@inject Peripherals Peripherals

<Dialog Title="Cobrar" Subtitle="@($"{Cart.LineCount} {(Cart.LineCount == 1 ? "línea" : "líneas")} · {(Cart.Customer?.Name ?? Cart.ManualName ?? "cliente de contado")}")" Wide="true" OnClose="Cancel" OnKey="KeyAsync">
    <ChildContent>
        <div class="checkout">
            <div class="checkout__left">
                <div>
                    <div class="esc-label">Total a cobrar</div>
                    <Money Value="_total" Size="72" />
                </div>
                @if (_payments.Count > 0)
                {
                    <div class="esc-card esc-card--padded esc-col" style="gap:4px">
                        @foreach (var p in _payments)
                        {
                            <div class="esc-row" style="justify-content:space-between">
                                <span>@Names.PaymentMethod(p.Method)</span>
                                <span class="esc-row">
                                    @Format.Amount(p.Amount)
                                    <Button Variant="Button.Variants.Ghost" Disabled="_sending" aria-label="@($"Quitar el pago de {Format.Amount(p.Amount)}")" OnClick="() => RemovePayment(p)"><Icon Name="x" /></Button>
                                </span>
                            </div>
                        }
                        <div class="esc-row" style="justify-content:space-between;font-weight:700"><span>Falta</span><span>@Format.Amount(Pending)</span></div>
                    </div>
                }
                <div class="checkout__methods" role="group" aria-label="Forma de pago">
                    @foreach (var (m, key) in Methods)
                    {
                        <button type="button" class="esc-button" aria-pressed="@(m == _method ? "true" : "false")" @onmousedown:preventDefault @onclick="() => Choose(m)">
                            <span>@Names.PaymentMethod(m)</span><Keycap>@key</Keycap>
                        </button>
                    }
                </div>
                @if (_method == PaymentMethod.Cash)
                {
                    <div class="esc-label">Devuelta</div>
                    <Money Value="Change" Size="52" />
                }
                @if (Peripherals.Printer is not null)
                {
                    @* Remembered on this PC: a store that hands out few receipts turns it off once. *@
                    <label class="esc-row" style="gap:8px;min-height:48px">
                        <input type="checkbox" style="width:22px;height:22px" checked="@Peripherals.Settings.PrintAfterSale" @onchange="PrintChangedAsync" /> Imprimir factura
                    </label>
                }
            </div>

            <div class="checkout__right">
                @if (_method == PaymentMethod.Cash)
                {
                    <label class="esc-field">
                        <span>Efectivo recibido (pesos enteros)</span>
                        @* maxlength: a barcode scanned here by habit never becomes a seven-billion-peso payment (escuadra.js also ignores the burst). *@
                        <input @ref="_input" data-no-scan class="esc-input esc-input--large esc-num" inputmode="numeric" maxlength="7" @bind="_received" @bind:event="oninput" data-select-on-focus />
                    </label>
                    @if (TooMuchCash)
                    {
                        <div class="esc-error-help">Es más de RD$ 2,000 por encima del total. Revise lo recibido.</div>
                    }
                    <div class="esc-row">
                        @foreach (var quick in QuickAmounts)
                        {
                            <button type="button" class="esc-chip" @onmousedown:preventDefault @onclick="() => Suggest(quick)">@Format.Amount(quick)</button>
                        }
                    </div>
                    <Keypad OnKey="CashKey" />
                }
                else
                {
                    <label class="esc-field">
                        <span>Monto</span>
                        <input @ref="_input" data-no-scan class="esc-input esc-input--large esc-num" inputmode="decimal" @bind="_amount" @bind:event="oninput" data-select-on-focus />
                    </label>
                    @if (_method is PaymentMethod.Card or PaymentMethod.Transfer)
                    {
                        var card = _method == PaymentMethod.Card;
                        <Field Label="@((card ? "Número de aprobación" : "Número de la transferencia") + (_referenceRequired ? "" : " (opcional)"))"
                               Hint="@(MissingReference ? (card ? "Escriba el número de aprobación del verifone para cobrar." : "Escriba el número de la transferencia para cobrar.") : null)">
                            <input @ref="_referenceInput" class="esc-input" maxlength="60" @bind="_reference" @bind:event="oninput" aria-required="@(_referenceRequired ? "true" : "false")" />
                        </Field>
                    }
                    @if (_method == PaymentMethod.OnAccount && Cart.Customer is { } c)
                    {
                        <div class="esc-subtitle">Debe @Format.WithCurrency(c.Debt) de un límite de @Format.WithCurrency(c.CreditLimit).</div>
                    }
                    @if (CurrentAmount < Pending)
                    {
                        <Button Disabled="MissingReference" OnClick="AddPayment">Agregar este pago y cobrar el resto con otro medio</Button>
                    }
                }
            </div>
        </div>
        @if (_total <= 0)
        {
            <Notice Kind="Notice.Kinds.Info" Title="Esta venta queda en RD$ 0.00.">Se registra con su comprobante y sin cobro. Confirme para terminarla.</Notice>
        }
        @if (_notice is not null)
        {
            <Notice Kind="_noticeKind" Title="@_notice" />
        }
    </ChildContent>
    <Footer>
        <Button OnClick="Cancel" Shortcut="Esc" Disabled="_sending">Volver a la venta</Button>
        <Button Variant="Button.Variants.Primary" Money="true" Shortcut="F12" Disabled="@(!CanConfirm || _sending)" OnClick="ConfirmAsync">
            @(_sending ? "Guardando…" : "Confirmar cobro")
        </Button>
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public Guid ShiftId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SaleRegistered> OnSold { get; set; }

    private decimal _total;
    private PaymentMethod _method = PaymentMethod.Cash;
    private string _received = "", _amount = "";
    private string? _reference, _notice;
    private Notice.Kinds _noticeKind = Notice.Kinds.Error;
    private bool _sending, _suggested, _focusInput = true;
    /// <summary>R11 A16: the store asks for the card authorization or transfer number (on unless the owner turned it off); the server refuses
    /// the sale without it, so the checkout does not let it through (e2e 2026-10-16: the field said "opcional").</summary>
    private bool _referenceRequired = true;
    private readonly List<Payment> _payments = [];
    private readonly List<Guid> _approvals = [];
    private ElementReference _input, _referenceInput;

    private IEnumerable<(PaymentMethod, string)> Methods
    {
        get
        {
            yield return (PaymentMethod.Cash, "F5");
            yield return (PaymentMethod.Card, "F6");
            yield return (PaymentMethod.Transfer, "F7");
            if (Cart.Customer is { CreditLimit: > 0 }) yield return (PaymentMethod.OnAccount, "F8");
            if (Cart.Customer is { CreditBalance: > 0 }) yield return (PaymentMethod.CreditBalance, "F9");
        }
    }

    private decimal Pending => Math.Max(0, _total - _payments.Sum(p => p.Amount));
    /// <summary>Cash is handed over in whole pesos; the centavos of the total stay in the drawer as rounding.</summary>
    private decimal MinimumCash => Math.Ceiling(Pending);
    private decimal Received => Format.ParseNumber(_received) ?? 0;
    private decimal CurrentAmount => _method == PaymentMethod.Cash ? Received : Format.ParseNumber(_amount) ?? 0;
    private decimal Change => Math.Max(0, Math.Floor(Received - Pending));
    /// <summary>Nobody hands over more than one extra RD$ 2,000 bill: more is a typo or a scanned code.</summary>
    private bool TooMuchCash => Received > MinimumCash + 2000;
    // TK-239: a RD$ 0 sale (100 % discount) is confirmed without payments.
    private bool MissingReference => _referenceRequired && _method is PaymentMethod.Card or PaymentMethod.Transfer && string.IsNullOrWhiteSpace(_reference);
    private bool CanConfirm => _total == 0 || (_method == PaymentMethod.Cash
        ? Received >= MinimumCash && Received == Math.Floor(Received) && !TooMuchCash
        : CurrentAmount == Pending && Pending > 0 && !MissingReference);

    private IEnumerable<decimal> QuickAmounts => new[] { MinimumCash, Math.Ceiling(Pending / 100) * 100, Math.Ceiling(Pending / 500) * 500, Math.Ceiling(Pending / 1000) * 1000, 2000m }
        .Where(v => v >= MinimumCash).Distinct().Order().Take(5);

    protected override void OnInitialized()
    {
        _total = Cart.Total;
        // An order's deposit waits in the customer's credit balance (TK-193): it pays first, the rest as usual.
        var deposit = Cart.Customer is { CreditBalance: > 0 } c ? Math.Min(Cart.Deposit, c.CreditBalance) : 0;
        if (deposit >= _total && _total > 0) Choose(PaymentMethod.CreditBalance);
        else if (deposit > 0) _payments.Add(new Payment(PaymentMethod.CreditBalance, deposit));
        Suggest(MinimumCash);
        if (Cart.CheckoutUncertain)
            Fail(Notice.Kinds.Warning, "El último intento de cobro no recibió respuesta. Confirme de nuevo: si ya se guardó, no se cobra dos veces.");
    }

    protected override async Task OnInitializedAsync() =>
        _referenceRequired = (await Api.GetAsync<BusinessProfile>("/api/settings/business")).Value?.RequirePaymentReference ?? true;

    // The field is focused after the render that shows it (switching cash ↔ card replaces the input).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusInput) return;
        _focusInput = false;
        await _input.FocusAsync();
    }

    private void Choose(PaymentMethod m)
    {
        if (m != _method) _reference = null; // a card's approval number never travels to a transfer
        _method = m;
        _amount = (m == PaymentMethod.CreditBalance && Cart.Customer is { } c ? Math.Min(c.CreditBalance, Pending) : Pending)
            .ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        Suggest(MinimumCash);
        (_notice, _focusInput) = (null, true);
    }

    /// <summary>A suggested amount: the first keypad press replaces it instead of appending to it.</summary>
    private void Suggest(decimal amount) => (_received, _suggested) = (amount.ToString(System.Globalization.CultureInfo.InvariantCulture), true);

    private void CashKey(string k)
    {
        _received = Keypad.Apply(_suggested ? "" : _received, k);
        _suggested = false;
    }

    private void AddPayment()
    {
        if (CurrentAmount <= 0 || CurrentAmount >= Pending || MissingReference) return;
        _payments.Add(new Payment(_method, Math.Round(CurrentAmount, 2), string.IsNullOrWhiteSpace(_reference) ? null : _reference.Trim()));
        _reference = null;
        _method = PaymentMethod.Cash;
        Suggest(MinimumCash);
        _focusInput = true;
    }

    /// <summary>A partial payment typed wrong or declined (a card) comes off without leaving the checkout.</summary>
    private void RemovePayment(Payment p)
    {
        if (_sending) return;
        _payments.Remove(p);
        Suggest(MinimumCash);
        if (_method != PaymentMethod.Cash) _amount = Pending.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        var m = Methods.FirstOrDefault(x => x.Item2 == e.Key);
        if (m.Item2 is not null) Choose(m.Item1);
        else if (e.Key is "F12" or "Enter" && MissingReference) await _referenceInput.FocusAsync(); // Enter on the amount goes on to the number still missing
        else if (e.Key is "F12" or "Enter" && CanConfirm) await ConfirmAsync();
    }

    private async Task ConfirmAsync()
    {
        if (_sending || !CanConfirm) return;
        _sending = true;
        _notice = null;
        List<Payment> payments = _total == 0 ? [] : _payments.Append(new Payment(_method, _method == PaymentMethod.Cash ? Received : CurrentAmount,
            string.IsNullOrWhiteSpace(_reference) ? null : _reference.Trim())).ToList();

        // Up to one supervisor per permission the sale needs (price change, big discount, credit over the limit).
        for (var attempt = 0; attempt < 4; attempt++)
        {
            var r = await Api.PostAsync<SaleRegistered>("/api/sales", Cart.ToRegisterSale(ShiftId, payments, _total, _approvals));
            if (r.Value is { } sale)
            {
                await OnSold.InvokeAsync(sale);
                return;
            }
            var p = r.Problem!;
            if (p.IsUncertain)
            {
                // The server may have saved it: the same SaleId is retried, and the cart stays locked until someone asks.
                Cart.CheckoutUncertain = true;
                Fail(Notice.Kinds.Warning, "No se sabe si la venta se guardó. Confirme de nuevo cuando vuelva la conexión: no se cobra dos veces.");
                return;
            }
            if (p.PermissionRequired is { } permission)
            {
                var id = await Approver.RequestAsync(permission, Cart.SaleId, $"Venta de {Format.WithCurrency(_total)}", p.ApprovalSummary);
                if (id is null) { Fail(Notice.Kinds.Warning, "Sin la autorización no se puede cobrar así. Quite el cambio o pida a otro supervisor."); return; }
                _approvals.Add(id.Value);
                continue;
            }
            if (p.Code == "Sales.DuplicateId")
            {
                // The id belongs to another sale (the cart cannot change while a checkout is uncertain, so it is not this one).
                Cart.NewSaleId();
                continue;
            }
            if (p.Code == "Sales.TotalChanged" && Format.ParseNumber(p.Error("total")) is { } correct)
            {
                // A price changed (or the server rounds its own way): the lines take the current prices, the cashier confirms the server's total.
                var ids = string.Join("&", Cart.Lines.Select(l => l.ProductId).Distinct().Select(id => $"ids={id}"));
                if ((await Api.GetAsync<List<ProductPrice>>($"/api/inventory/products/prices?{ids}")).Value is { } prices) Cart.UpdatePrices(prices);
                _total = correct;
                if (_payments.Sum(x => x.Amount) >= _total) _payments.Clear(); // they would pay more than the new total
                if (_method == PaymentMethod.Cash && Received < MinimumCash) Suggest(MinimumCash);
                else if (_method != PaymentMethod.Cash) _amount = Pending.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
                Fail(Notice.Kinds.Warning, $"El total correcto es {Format.WithCurrency(correct)}. Revíselo con el cliente y confirme de nuevo.");
                return;
            }
            Fail(p.Kind, p.Code switch
            {
                "Inventory.OutOfStock" => "No hay existencia suficiente de un producto. Un supervisor puede permitir vender sin existencia en Productos.",
                "Customers.CreditLimitExceeded" => "El cliente pasa su límite de crédito.",
                // TK-363: the cashier cannot load ranges; a 31 can still go out as consumer, a 32 waits for the owner.
                "Fiscal.NoSequence" when Cart.DocumentType == EcfType.FiscalCredit31 =>
                    "No quedan comprobantes de crédito fiscal. Si el cliente acepta, cambie el comprobante a Consumo (F6) y cobre. Avise al dueño.",
                "Fiscal.NoSequence" => "No quedan comprobantes de consumo: no se puede facturar. La venta sigue abierta. Avise al dueño (Administración → Configuración → Comprobantes).",
                "Fiscal.MissingIssuerRnc" => "Falta el RNC del negocio en Configuración.",
                "Sales.RncRequired" => "Esta factura necesita el RNC o la cédula del cliente (F6).",
                "Sales.ReferenceRequired" => "Escriba el número de autorización de la tarjeta o de la transferencia.",
                "Sales.DuplicateScaleLabel" => "Esa etiqueta está dos veces en la venta; quite una.",
                _ => p.Message,
            });
            return;
        }
        Fail(Notice.Kinds.Error, "No se pudo completar la autorización. Intente de nuevo.");
    }

    private Task PrintChangedAsync(ChangeEventArgs e) => Peripherals.SaveAsync(Peripherals.Settings with { PrintAfterSale = e.Value is true });

    private void Fail(Notice.Kinds kind, string message) => (_noticeKind, _notice, _sending) = (kind, message, false);

    /// <summary>Leaving after an uncertain checkout asks the server first: a saved sale is shown as sold, never lost or charged twice.</summary>
    private async Task Cancel()
    {
        if (_sending) return;
        if (Cart.CheckoutUncertain)
        {
            _sending = true;
            var saved = await Api.SavedSaleAsync(Cart.SaleId);
            _sending = false;
            if (saved.Value is { } sale)
            {
                await OnSold.InvokeAsync(sale);
                return;
            }
            if (saved.Ok) Cart.CheckoutUncertain = false; // never saved: the cart can change again
        }
        await OnClose.InvokeAsync();
    }
}
