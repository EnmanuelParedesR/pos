@* Finds a product by name, PLU or barcode while typing; Enter takes the first one (a scanner ends with Enter). Used by transfers and purchases. *@
@inject AbastaliaApi Api

<div class="picker">
    <label class="esc-search">
        <Icon Name="search" Size="18" />
        <input placeholder="@Placeholder" aria-label="@Placeholder" @bind="_search" @bind:event="oninput" @bind:after="SearchAsync" @onkeydown="KeyDown" />
    </label>
    @if (_results.Count > 0)
    {
        <ul class="picker__list" role="listbox" aria-label="Productos encontrados">
            @foreach (var p in _results)
            {
                <li role="option" aria-selected="false">
                    <button type="button" @onclick="() => PickAsync(p)">
                        <span style="font-weight:600">@p.Name</span>
                        <span class="esc-muted">@p.Category · @(p.Unit == "Pound" ? "por libra" : "por unidad")</span>
                    </button>
                </li>
            }
        </ul>
    }
    else if (_searched && !string.IsNullOrWhiteSpace(_search))
    {
        <div class="picker__none esc-muted">Nada coincide con “@_search”.</div>
    }
</div>

@code {
    [Parameter] public string Placeholder { get; set; } = "Agregar producto: nombre, PLU o código";
    [Parameter] public EventCallback<ProductSummary> OnPick { get; set; }

    private string? _search;
    private bool _searched;
    private List<ProductSummary> _results = [];
    private CancellationTokenSource? _typing;

    private async Task SearchAsync()
    {
        _typing?.Cancel();
        _typing = new CancellationTokenSource();
        try { await Task.Delay(200, _typing.Token); } catch (TaskCanceledException) { return; }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(_search)) { (_results, _searched) = ([], false); return; }
        var r = await Api.GetAsync<List<ProductSummary>>($"/api/inventory/products?search={Uri.EscapeDataString(_search.Trim())}");
        (_results, _searched) = ([.. (r.Value ?? []).Where(p => p.IsActive).Take(8)], true);
    }

    private async Task KeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        _typing?.Cancel();
        await LoadAsync();
        if (_results.Count > 0) await PickAsync(_results[0]);
    }

    private async Task PickAsync(ProductSummary p)
    {
        (_search, _results, _searched) = (null, [], false);
        await OnPick.InvokeAsync(p);
    }
}
