@* The invoice as the thermal printer prints it, and Imprimir to print it again (no drawer: a reprint takes no cash). *@
@inject Peripherals Peripherals
@inject BusinessLogo Logo
<Dialog Title="@($"Factura {Receipt.ENcf}")" Subtitle="@(Receipt.IsVoided ? "ANULADA" : null)" OnClose="OnClose">
    <ChildContent>
        <div class="receipt" aria-label="Factura">
            @if (_logo is { } logo)
            {
                @* TK-280: the dots this printer gets, at their share of the paper (576 dots on 80 mm, 384 on 58 mm). *@
                <img class="receipt__logo" src="@BusinessLogo.BmpDataUrl(logo)" alt="Logo del negocio" style="width:@(logo.Width * 100 / Dots)%" />
            }
            <div class="center" style="font-weight:700">@Receipt.BusinessName</div>
            @if (Receipt.Rnc is not null) { <div class="center">RNC @Receipt.Rnc</div> }
            @if (Receipt.Address is not null) { <div class="center">@Receipt.Address</div> }
            @if (Receipt.Phone is not null) { <div class="center">Tel. @Receipt.Phone</div> }
            <hr />
            <div class="center" style="font-weight:700">@Receipt.DocumentType</div>
            <div class="row"><span>@(Receipt.ENcf.StartsWith('B') ? "NCF" : "e-NCF")</span><span>@Receipt.ENcf</span></div>
            <div class="row"><span>Factura</span><span>#@Receipt.Number</span></div>
            @if (Receipt.SequenceExpiresOn is { } expires) { <div class="row"><span>Válido hasta</span><span>@expires.ToString("dd-MM-yyyy", System.Globalization.CultureInfo.InvariantCulture)</span></div> }
            @* localDateTime is already store time even though it carries a Z: shown as is. *@
            <div class="row"><span>Fecha</span><span>@Receipt.LocalDateTime.ToString("dd/MM/yyyy h:mm tt", System.Globalization.CultureInfo.GetCultureInfo("es-DO"))</span></div>
            <div class="row"><span>@Receipt.Register</span><span>@Receipt.Cashier</span></div>
            @if (Receipt.Customer is not null)
            {
                <div class="row"><span>Cliente</span><span>@Receipt.Customer</span></div>
                @if (Receipt.CustomerRnc is not null) { <div class="row"><span>RNC</span><span>@Receipt.CustomerRnc</span></div> }
            }
            <hr />
            @foreach (var l in Receipt.Lines)
            {
                <div>@l.Description</div>
                <div class="row"><span>&nbsp;&nbsp;@Format.Quantity(l.Quantity, l.Unit) × @Format.Amount(l.Price)</span><span>@Format.Amount(l.Total)</span></div>
                @if (l.Discount > 0) { <div class="row"><span>&nbsp;&nbsp;Descuento</span><span>−@Format.Amount(l.Discount)</span></div> }
            }
            <hr />
            @* Subtotal is the base without ITBIS after the discount, so the discount goes first and the base + ITBIS lines add up to the total. *@
            @if (Receipt.Discount > 0) { <div class="row"><span>Descuento aplicado</span><span>−@Format.Amount(Receipt.Discount)</span></div> }
            <div class="row"><span>Base sin ITBIS</span><span>@Format.Amount(Receipt.Subtotal)</span></div>
            @foreach (var i in Receipt.Itbis)
            {
                <div class="row"><span>@i.Rate</span><span>@Format.Amount(i.Itbis)</span></div>
            }
            <div class="row" style="font-weight:700;font-size:16px"><span>TOTAL</span><span>RD$ @Format.Amount(Receipt.Total)</span></div>
            <hr />
            @foreach (var p in Receipt.Payments)
            {
                <div class="row"><span>@p.Method</span><span>@Format.Amount(p.Received ?? p.Amount)</span></div>
            }
            @if (Receipt.Change > 0) { <div class="row"><span>Devuelta</span><span>@Format.Amount(Receipt.Change)</span></div> }
            <hr />
            @if (Receipt.SecurityCode.Length > 0) { <div class="center">Código de seguridad: @Receipt.SecurityCode</div> }
            @if (Receipt.SignedAt is { } signed) { <div class="center">Fecha de firma: @signed.ToString("dd-MM-yyyy HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</div> }
            @if (Receipt.ContingencyLegend is not null) { <div class="center" style="margin-top:8px;font-weight:700">@Receipt.ContingencyLegend</div> }
            @if (Receipt.DgiiStatus is not null) { <div class="center">@Receipt.DgiiStatus</div> }
            @if (Receipt.Footer is not null) { <div class="center" style="margin-top:8px">@Receipt.Footer</div> }
        </div>
    </ChildContent>
    <Footer>
        @if (_message is not null)
        {
            <span class="esc-muted" role="status" style="margin-right:auto">@_message</span>
        }
        @if (Peripherals.Printer is not null)
        {
            <Button Disabled="_printing" OnClick="PrintAsync"><Icon Name="printer" /> @(_printing ? "Imprimiendo…" : "Imprimir")</Button>
        }
        <Button Variant="Button.Variants.Primary" Shortcut="Esc" OnClick="OnClose">Cerrar</Button>
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public Receipt Receipt { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _printing;
    private ReceiptLogo? _logo;
    private int Width => Peripherals.Settings.Printer?.Width == 58 ? 58 : 80;
    private int Dots => Width == 58 ? 384 : 576;

    protected override async Task OnParametersSetAsync() => _logo = Peripherals.Settings.PrintLogo ? await Logo.RasterAsync(Receipt.LogoVersion, Width) : null;
    private string? _message;

    private async Task PrintAsync()
    {
        _printing = true;
        var receipt = await Logo.ForPrinterAsync(Receipt, Peripherals.Settings);
        var ok = await Peripherals.TryAsync(p => p.PrintAsync(receipt, false, CancellationToken.None));
        (_printing, _message) = (false, ok ? "Factura enviada a la impresora." : "No se pudo imprimir. Revise el papel y que la impresora esté encendida.");
    }
}
