@inject AbastaliaApi Api

@* TK-233: the owner of a store not yet issuing e-CF asks Abastalia staff to walk them through the DGII certification (docs/servicio-certificacion.md).
   The request goes straight to the cloud, which e-mails Abastalia staff; the owner sees it arrived and where it is. *@
<section class="esc-card esc-card--padded" aria-labelledby="accompaniment-title">
    <div class="esc-card__head">
        <h2 id="accompaniment-title" class="esc-card__title">Acompañamiento en la certificación</h2>
        @if (_state?.Request is { } shown)
        {
            var (text, pill) = StatusName(shown.Status);
            <span class="esc-pill esc-pill--@pill">@text</span>
        }
    </div>
    <p class="esc-muted">Un técnico de Abastalia le guía por sesión remota, en dos citas, hasta que la DGII autorice la tienda. Cuando haga falta su clave de la
        Oficina Virtual (OFV), la escribe usted: <b>Abastalia nunca se la pide</b>. Al agendar la primera cita le enviamos por correo la lista de lo que debe preparar.</p>
    @if (_message is not null)
    {
        <p role="status" class="@(_error ? "esc-error" : "esc-muted")">@_message</p>
    }

    @if (_state is { Connected: false })
    {
        <Notice Kind="Notice.Kinds.Info" Title="Conecte la tienda a la nube para pedirlo">
            La solicitud llega a Abastalia por la nube. <a href="admin/settings?section=cloud">Conectar en Configuración → Nube</a>, o escríbanos por WhatsApp.
        </Notice>
    }
    else if (_state?.Request is { } r && IsOpen(r.Status))
    {
        <p role="status"><b>Solicitud enviada</b> el @Format.Date(r.CreatedUtc). @(r.Session1Utc is null ? $"Un técnico le escribirá al {r.Phone} para agendar la primera cita." : "")</p>
        <dl class="esc-dl">
            <dt>Contacto</dt><dd>@r.ContactName · @r.Phone</dd>
            @if (r.PreferredTimes.Length > 0) { <dt>Horario preferido</dt><dd>@r.PreferredTimes</dd> }
            @if (r.Session1Utc is { } s1) { <dt>Cita 1</dt><dd>@Format.Date(s1)</dd> }
            @if (r.Session2Utc is { } s2) { <dt>Cita 2</dt><dd>@Format.Date(s2)</dd> }
        </dl>
    }
    else if (_state is not null)
    {
        <form @onsubmit="SendAsync" novalidate>
            <div class="esc-form-grid">
                <Field Label="Nombre de contacto" Error="@_nameError">
                    <input class="esc-input" maxlength="100" @bind="_name" aria-invalid="@(_nameError is null ? "false" : "true")" />
                </Field>
                <Field Label="Teléfono o WhatsApp" Error="@_phoneError">
                    <input class="esc-input" inputmode="tel" maxlength="30" @bind="_phone" aria-invalid="@(_phoneError is null ? "false" : "true")" />
                </Field>
                <Field Label="Horario preferido" Hint="Opcional. Ejemplo: mañanas de lunes a viernes.">
                    <input class="esc-input" maxlength="200" @bind="_times" />
                </Field>
            </div>
            <div class="esc-form-actions"><Button Type="submit" Variant="Button.Variants.Primary" Disabled="_sending">@(_sending ? "Enviando…" : "Solicitar acompañamiento")</Button></div>
        </form>
    }
</section>

@code {
    private AccompanimentState? _state;
    private string? _name, _phone, _times, _message, _nameError, _phoneError;
    private bool _sending, _error;

    private static bool IsOpen(string status) => status is not ("Certified" or "Cancelled");

    public static (string Text, string Pill) StatusName(string status) => status switch
    {
        "New" => ("Nueva", "warning"),
        "Scheduled" => ("Agendada", "brand"),
        "Session1Done" => ("Sesión 1 hecha", "brand"),
        "Session2Done" => ("Sesión 2 hecha", "brand"),
        "Certified" => ("Certificada", "success"),
        "Cancelled" => ("Cancelada", "neutral"),
        _ => (status, "neutral"),
    };

    protected override async Task OnInitializedAsync()
    {
        var r = await Api.GetAsync<AccompanimentState>("/api/fiscal/accompaniment");
        if (r.Problem is { } p) (_error, _message) = (true, p.Message);
        _state = r.Value;
        (_name, _phone) = (_state?.SuggestedName, _state?.SuggestedPhone);
    }

    private async Task SendAsync()
    {
        _nameError = string.IsNullOrWhiteSpace(_name) ? "Escriba con quién hablamos." : null;
        _phoneError = _phone?.Trim().Length is >= 7 and <= 30 ? null : "Escriba un teléfono (7 a 30 caracteres).";
        if (_nameError is not null || _phoneError is not null) return;
        _sending = true;
        var r = await Api.PostAsync<AccompanimentRequest>("/api/fiscal/accompaniment", new { ContactName = _name, Phone = _phone, PreferredTimes = _times });
        _sending = false;
        (_error, _message) = (r.Problem is not null, r.Problem?.Message ?? "Solicitud enviada: un técnico de Abastalia le escribirá para agendar.");
        if (r.Value is { } sent) _state = _state! with { Request = sent };
    }
}
