@inject AbastaliaApi Api

@* TK-238: the DGII environment, changed here instead of in appsettings. Simulado → TesteCF → CerteCF → Producción; each step lists what is
   missing, asks for an explicit confirmation and is audited. Applies at once. *@
<section class="esc-card esc-card--padded" aria-labelledby="mode-title">
    <div class="esc-card__head">
        <h2 id="mode-title" class="esc-card__title">Ambiente de la DGII</h2>
        @if (_state is { } s)
        {
            <span class="esc-card__aside">@Names.FiscalEnvironment(s.Environment)@(s.Saved ? "" : " (de la instalación)")</span>
        }
    </div>
    <p class="esc-muted">Simulado no envía nada. Pre-certificación y Certificación son ambientes de prueba de la DGII. En Producción cada comprobante tiene valor fiscal.</p>
    @if (_message is not null)
    {
        <p role="status" class="@(_error ? "esc-error" : "esc-muted")">@_message</p>
    }
    @if (_state is { } state)
    {
        <div class="esc-row" role="radiogroup" aria-label="Ambiente">
            @foreach (var t in state.Targets)
            {
                <button type="button" role="radio" class="esc-chip" aria-checked="@(_target == t.Environment ? "true" : "false")" aria-pressed="@(_target == t.Environment ? "true" : "false")"
                        disabled="@(t.Environment == state.Environment)" @onclick="() => Pick(t.Environment)">@Names.FiscalEnvironment(t.Environment)</button>
            }
        </div>
        @if (Target is { } target)
        {
            @if (target.Blockers.Count > 0)
            {
                <p>Antes de pasar a <b>@Names.FiscalEnvironment(target.Environment)</b> falta:</p>
                <ul class="esc-error" aria-label="Lo que falta">@foreach (var b in target.Blockers) { <li>@b</li> }</ul>
            }
            else
            {
                <label class="esc-check"><input type="checkbox" @bind="_confirmed" />
                    @(target.Environment == "eCF"
                        ? "Entiendo que desde ahora cada comprobante va a la DGII con valor fiscal y sale en el 607."
                        : $"Quiero pasar la tienda a {Names.FiscalEnvironment(target.Environment)}.")</label>
                <div class="esc-form-actions"><Button Variant="Button.Variants.Primary" Disabled="@(!_confirmed || _sending)" OnClick="ChangeAsync">Cambiar ambiente</Button></div>
            }
        }
    }
</section>

@code {
    /// <summary>The page reloads its queue and the other panels after a change.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private FiscalModeState? _state;
    private string? _target, _message;
    private bool _confirmed, _sending, _error;

    private FiscalModeTarget? Target => _state?.Targets.Find(t => t.Environment == _target);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() => _state = (await Api.GetAsync<FiscalModeState>("/api/fiscal/mode")).Value ?? _state;

    private void Pick(string env) => (_target, _confirmed, _message) = (env, false, null);

    private async Task ChangeAsync()
    {
        if (Target is not { Blockers.Count: 0 } t || !_confirmed) return;
        _sending = true;
        var r = await Api.PutAsync<Empty>("/api/fiscal/mode", new { t.Environment, Confirm = true });
        _sending = false;
        (_error, _message) = (r.Problem is not null, r.Problem?.Message ?? $"Listo: la tienda está en {Names.FiscalEnvironment(t.Environment)}.");
        (_target, _confirmed) = (null, false);
        await LoadAsync();
        if (r.Ok) await Changed.InvokeAsync();
    }
}
