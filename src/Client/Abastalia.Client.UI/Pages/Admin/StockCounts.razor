@page "/admin/inventory/counts"
@inject AbastaliaApi Api
@inject Session Session
@inject Approver Approver

<Admin Title="Conteo físico" Subtitle="Se cuenta a ciegas: quien cuenta no ve lo que dice el sistema. Las diferencias salen al aplicarlo.">
    <Actions>
        @if (_sheet is null)
        {
            <Button Variant="Button.Variants.Primary" OnClick="NewCount"><Icon Name="plus" /> Nuevo conteo</Button>
        }
        else
        {
            <Button OnClick="BackAsync"><Icon Name="chevron-left" Size="18" /> Todos los conteos</Button>
        }
    </Actions>
    <ChildContent>
        <SectionTabs Label="Inventario" Tabs="SectionTabs.Inventory(Session)" />
        @if (_message is not null)
        {
            <Notice Kind="_messageKind" Title="@_message" />
        }

        @if (_sheet is { } sheet)
        {
            var counted = sheet.Lines.Count(l => Value(l) is not null);
            <div class="esc-card" style="padding:16px 20px">
                <div class="esc-card__head" style="margin:0">
                    <div>
                        <h2 class="esc-card__title">@Describe(sheet.WarehouseId, _sheetCategory)</h2>
                        <span class="esc-muted">@counted de @sheet.Lines.Length contados · lo que no se cuente se queda como está</span>
                    </div>
                    <div class="esc-row" style="gap:8px">
                        <Button Disabled="@(_sending || !Dirty)" OnClick="SaveAsync">@(_sending ? "Guardando…" : Dirty ? "Guardar lo contado" : "Guardado")</Button>
                        <Button Variant="Button.Variants.Primary" Disabled="@(_sending || counted == 0)" OnClick="Review">Revisar y aplicar</Button>
                    </div>
                </div>
            </div>
            <label class="esc-search">
                <Icon Name="search" Size="18" />
                <input placeholder="Buscar producto en el conteo" aria-label="Buscar producto en el conteo" @bind="_search" @bind:event="oninput" />
            </label>
            <div class="esc-card esc-table-wrap esc-table-wrap--tall">
                <table class="esc-table">
                    <thead><tr><th>Producto</th><th class="esc-num">Contado</th></tr></thead>
                    <tbody>
                        @foreach (var l in sheet.Lines.Where(l => string.IsNullOrWhiteSpace(_search) || l.Product.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase)))
                        {
                            var bad = _invalid.Contains(l.ProductId);
                            <tr>
                                <td style="font-weight:600">@l.Product<span class="esc-table__sub">@(l.Unit == UnitOfMeasure.Pound ? "En libras" : "En unidades enteras")</span>
                                    @if (bad) { <span class="esc-field__error" role="alert"><Icon Name="alert" Size="14" />@(l.Unit == UnitOfMeasure.Unit ? "Unidades enteras, 0 o más." : "Un número, 0 o más.")</span> }
                                </td>
                                <td class="esc-num">
                                    <input class="esc-input cell-input" inputmode="decimal" aria-label="@($"Contado de {l.Product}")" placeholder="—"
                                           value="@_entered.GetValueOrDefault(l.ProductId)" @onchange="e => Enter(l, e.Value?.ToString())" aria-invalid="@(bad ? "true" : "false")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (sheet.Lines.Length == 0)
                {
                    <EmptyState Icon="package" Title="Este conteo no tiene productos">No había productos activos en esa categoría al empezarlo.</EmptyState>
                }
            </div>
        }
        else
        {
            <div class="esc-card esc-table-wrap">
                <table class="esc-table esc-table--wide">
                    <thead><tr><th>Conteo</th><th class="esc-hide-sm">Empezó</th><th class="esc-num">Contados</th><th>Estado</th><th class="esc-table__chev esc-hide-sm"><span class="esc-visually-hidden">Abrir</span></th></tr></thead>
                    <tbody>
                        @if (_counts is null)
                        {
                            @for (var i = 0; i < 3; i++)
                            {
                                <tr><td><Skeleton Width="180px" /></td><td class="esc-hide-sm"><Skeleton Width="120px" /></td><td><Skeleton Width="50px" /></td><td><Skeleton Width="80px" /></td><td class="esc-hide-sm"></td></tr>
                            }
                        }
                        else
                        {
                            @foreach (var c in _counts)
                            {
                                var open = c.Status == StockCountStatus.Open;
                                <tr class="@(open ? "selectable" : "")" tabindex="@(open ? "0" : null)" @onclick="() => open ? OpenAsync(c) : Task.CompletedTask"
                                    @onkeydown='e => open && e.Key == "Enter" ? OpenAsync(c) : Task.CompletedTask'>
                                    <td style="font-weight:600">@Describe(c.WarehouseId, c.CategoryId)<span class="esc-table__sub esc-only-sm">@Format.Date(c.CreatedUtc)</span></td>
                                    <td class="esc-hide-sm">@Format.Date(c.CreatedUtc)</td>
                                    <td class="esc-num">@c.CountedCount de @c.LineCount</td>
                                    <td>
                                        @if (open) { <span class="esc-pill esc-pill--warning">Abierto</span> }
                                        else { <span class="esc-pill esc-pill--success">Aplicado</span><span class="esc-table__sub">@(c.AppliedUtc is { } a ? Format.Date(a) : "")</span> }
                                    </td>
                                    <td class="esc-table__chev esc-hide-sm">@if (open) { <Icon Name="chevron-right" Size="18" /> }</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                @if (_counts is { Count: 0 })
                {
                    <EmptyState Icon="package" Title="Todavía no hay conteos">Empiece con “Nuevo conteo”: puede contar toda la tienda o una sola categoría.</EmptyState>
                }
            </div>
        }

        @if (_starting)
        {
            <Dialog Title="Nuevo conteo" Subtitle="Se cuentan todos los productos activos del almacén, o solo los de una categoría." OnClose="() => _starting = false">
                <ChildContent>
                    @if (_warehouses.Count > 1)
                    {
                        <Field Label="Almacén">
                            <select class="esc-select" @bind="_newWarehouse">
                                @foreach (var w in _warehouses) { <option value="@w.Id">@w.Name</option> }
                            </select>
                        </Field>
                    }
                    <Field Label="Categoría" Hint="Contar por partes es más fácil: hoy Res, mañana Cerdo.">
                        <select class="esc-select" @bind="_newCategory">
                            <option value="">Todas las categorías</option>
                            @foreach (var c in _categories) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </Field>
                    @if (_error is not null) { <Notice Title="@_error" /> }
                </ChildContent>
                <Footer>
                    <Button OnClick="() => _starting = false" Shortcut="Esc">Cancelar</Button>
                    <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="StartAsync">Empezar a contar</Button>
                </Footer>
            </Dialog>
        }

        @if (_reviewing && _sheet is { } s)
        {
            var counted = s.Lines.Count(l => Value(l) is not null);
            <Dialog Title="¿Aplicar el conteo?" Subtitle="@Describe(s.WarehouseId, _sheetCategory)" OnClose="() => _reviewing = false">
                <ChildContent>
                    <dl class="esc-dl">
                        <dt>Productos contados</dt><dd>@counted</dd>
                        <dt>Sin contar (no cambian)</dt><dd>@(s.Lines.Length - counted)</dd>
                    </dl>
                    <Notice Kind="Notice.Kinds.Info" Title="La existencia de cada producto contado pasa a ser lo contado.">
                        Lo que se vendió después de contar se descuenta igual. Al aplicarlo verá las diferencias y cuánto valen; no se puede deshacer.
                    </Notice>
                    @if (!Session.Can("inventory.adjust"))
                    {
                        <span class="esc-muted">Lo autoriza un supervisor con su PIN.</span>
                    }
                    @if (_error is not null) { <Notice Title="@_error" /> }
                </ChildContent>
                <Footer>
                    <Button OnClick="() => _reviewing = false" Shortcut="Esc">Seguir contando</Button>
                    <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="ApplyAsync">@(_sending ? "Aplicando…" : "Aplicar conteo")</Button>
                </Footer>
            </Dialog>
        }

        @if (_result is { } result)
        {
            <Dialog Title="Conteo aplicado" Subtitle="@(result.Differences.Length == 0 ? "Todo lo contado cuadró con el sistema." : $"{result.Differences.Length} {(result.Differences.Length == 1 ? "producto tenía" : "productos tenían")} diferencia.")" Wide="true" OnClose="() => _result = null">
                <ChildContent>
                    @* The value at cost only comes with costs.view (TK-201). *@
                    @if (result.DifferenceValue is { } value && value != 0)
                    {
                        <Notice Kind="@(value < 0 ? Notice.Kinds.Error : Notice.Kinds.Warning)"
                                Title="@($"{(value < 0 ? "Faltó" : "Sobró")} mercancía por {Format.WithCurrency(Math.Abs(value))} al costo")" />
                    }
                    @if (result.Differences.Length > 0)
                    {
                        <div class="esc-table-wrap">
                            <table class="esc-table">
                                <thead><tr><th>Producto</th><th class="esc-num esc-hide-sm">Sistema</th><th class="esc-num esc-hide-sm">Contado</th><th class="esc-num">Diferencia</th>@if (result.DifferenceValue is not null) { <th class="esc-num">Valor</th> }</tr></thead>
                                <tbody>
                                    @foreach (var d in result.Differences.OrderBy(d => d.Value ?? d.Difference))
                                    {
                                        var unit = _sheet?.Lines.FirstOrDefault(l => l.ProductId == d.ProductId)?.Unit ?? UnitOfMeasure.Unit;
                                        <tr>
                                            <td style="font-weight:600">@d.Product</td>
                                            <td class="esc-num esc-hide-sm">@AdminNames.Stock(d.SystemStock, unit)</td>
                                            <td class="esc-num esc-hide-sm">@AdminNames.Stock(d.Counted, unit)</td>
                                            <td class="esc-num" style="font-weight:600;white-space:nowrap">@AdminNames.Signed(d.Difference, unit)</td>
                                            @if (d.Value is { } v) { <td class="esc-num" style="color:@(v < 0 ? "var(--error)" : "var(--text)")">@Format.Amount(v)</td> }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </ChildContent>
                <Footer><Button Variant="Button.Variants.Primary" Shortcut="Esc" OnClick="CloseResultAsync">Listo</Button></Footer>
            </Dialog>
        }
    </ChildContent>
</Admin>

@code {
    private List<Warehouse> _warehouses = [];
    private List<Category> _categories = [];
    private List<StockCountSummary>? _counts;
    private StockCountSheet? _sheet;
    private Guid? _sheetCategory;
    private StockCountApplied? _result;
    private readonly Dictionary<Guid, string> _entered = [], _saved = [];
    private readonly HashSet<Guid> _invalid = [];
    private string? _search, _message, _error, _newWarehouse, _newCategory;
    private Notice.Kinds _messageKind = Notice.Kinds.Error;
    private bool _starting, _reviewing, _sending;

    private bool Dirty => _entered.Any(e => _saved.GetValueOrDefault(e.Key) != e.Value);

    protected override async Task OnInitializedAsync()
    {
        _warehouses = (await Api.GetAsync<List<Warehouse>>("/api/inventory/warehouses")).Value ?? [];
        _categories = (await Api.GetAsync<List<Category>>("/api/inventory/categories")).Value ?? [];
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var r = await Api.GetAsync<List<StockCountSummary>>("/api/inventory/stock-counts");
        _counts = r.Value ?? [];
        if (r.Problem is { } p) (_message, _messageKind) = (p.Message, p.Kind);
    }

    private string Describe(Guid warehouse, Guid? category)
    {
        var what = category is { } c ? _categories.Find(x => x.Id == c)?.Name ?? "Una categoría" : "Todo";
        return _warehouses.Count > 1 ? $"{what} · {_warehouses.Find(w => w.Id == warehouse)?.Name}" : what;
    }

    private decimal? Value(StockCountLine l) => _entered.TryGetValue(l.ProductId, out var t) ? Format.ParseNumber(t) : null;

    private void NewCount() => (_starting, _error, _newCategory, _newWarehouse) = (true, null, "", (_warehouses.Find(w => w.IsMain) ?? _warehouses.FirstOrDefault())?.Id.ToString());

    private async Task StartAsync()
    {
        _sending = true;
        var r = await Api.PostAsync<StockCountStarted>("/api/inventory/stock-counts",
            new StartStockCount(Guid.TryParse(_newWarehouse, out var w) ? w : null, Guid.TryParse(_newCategory, out var c) ? c : null));
        _sending = false;
        if (r.Value is not { } started) { _error = r.Problem!.Message; return; }
        _starting = false;
        await LoadAsync();
        if (_counts!.Find(x => x.Id == started.StockCountId) is { } count) await OpenAsync(count);
    }

    private async Task OpenAsync(StockCountSummary c)
    {
        var r = await Api.GetAsync<StockCountSheet>($"/api/inventory/stock-counts/{c.Id}");
        if (r.Value is not { } sheet) { (_message, _messageKind) = (r.Problem!.Message, r.Problem.Kind); return; }
        (_sheet, _sheetCategory, _message, _search) = (sheet, c.CategoryId, null, null);
        _entered.Clear();
        _invalid.Clear();
        foreach (var l in sheet.Lines.Where(l => l.Counted is not null)) _entered[l.ProductId] = AdminNames.Number(l.Counted!.Value);
        _saved.Clear();
        foreach (var e in _entered) _saved[e.Key] = e.Value;
    }

    private void Enter(StockCountLine l, string? text)
    {
        _invalid.Remove(l.ProductId);
        if (string.IsNullOrWhiteSpace(text)) { _entered.Remove(l.ProductId); return; }
        _entered[l.ProductId] = text.Trim();
        var v = Format.ParseNumber(text);
        if (v is not >= 0 || (l.Unit == UnitOfMeasure.Unit && v != Math.Truncate(v.Value))) _invalid.Add(l.ProductId);
    }

    /// <summary>Sends what changed since the last save. False when something typed is not a valid quantity.</summary>
    private async Task<bool> SaveAsync()
    {
        if (_sheet is not { } sheet) return false;
        if (_invalid.Count > 0) { (_message, _messageKind) = ("Hay cantidades que no son válidas. Corríjalas para guardar.", Notice.Kinds.Error); return false; }
        var changed = _entered.Where(e => _saved.GetValueOrDefault(e.Key) != e.Value).ToList();
        if (changed.Count == 0) return true;
        _sending = true;
        var r = await Api.PutAsync<Empty>($"/api/inventory/stock-counts/{sheet.Id}/lines",
            new RecordCount([.. changed.Select(e => new CountedLine(e.Key, Format.ParseNumber(e.Value)!.Value))]));
        _sending = false;
        if (r.Problem is { } p) { (_message, _messageKind) = (p.Message, p.Kind); return false; }
        foreach (var e in changed) _saved[e.Key] = e.Value;
        _message = null;
        return true;
    }

    private void Review() => (_reviewing, _error) = (true, null);

    private async Task ApplyAsync()
    {
        if (_sheet is not { } sheet || !await SaveAsync()) { _reviewing = false; return; }
        _sending = true;
        var r = await Approver.WithSupervisorAsync(approval => Api.PostAsync<StockCountApplied>($"/api/inventory/stock-counts/{sheet.Id}/apply", new ApplyStockCount(approval)),
            sheet.Id, "Aplicar el conteo físico");
        _sending = false;
        if (r.Value is not { } applied)
        {
            if (r.Problem?.Code != "Cancelled") _error = r.Problem?.Message;
            return;
        }
        (_reviewing, _result) = (false, applied);
    }

    private async Task CloseResultAsync()
    {
        (_result, _sheet) = (null, null);
        await LoadAsync();
    }

    private async Task BackAsync()
    {
        if (Dirty && !await SaveAsync()) return;
        _sheet = null;
        await LoadAsync();
    }
}
