@page "/admin/audit"
@inject AbastaliaApi Api
@using Microsoft.JSInterop
@inject IJSRuntime JS

@* TK-213: who did what and when (audit.view). Newest first, 100 at a time; the whole period downloads as CSV. *@
<Admin Title="Auditoría" Subtitle="Quién hizo qué y cuándo. Cada registro queda encadenado: si alguien lo borra o lo cambia en la base de datos, se nota.">
    <Actions>
        <Button Disabled="_downloading" aria-label="Descargar la auditoría en CSV" OnClick="DownloadAsync"><Icon Name="arrow-down" Size="16" /> @(_downloading ? "Preparando…" : "CSV")</Button>
    </Actions>
    <ChildContent>
        <section class="esc-card esc-card--padded">
            <div class="esc-row" style="gap:12px;align-items:flex-end">
                <label class="esc-field" style="flex:0 1 170px"><span>Desde</span><input class="esc-input" type="date" aria-label="Desde" @bind="_from" @bind:after="LoadAsync" /></label>
                <label class="esc-field" style="flex:0 1 170px"><span>Hasta</span><input class="esc-input" type="date" aria-label="Hasta" @bind="_to" @bind:after="LoadAsync" /></label>
                <label class="esc-field" style="flex:1 1 180px"><span>Usuario</span>
                    <select class="esc-select" aria-label="Usuario" @bind="_user" @bind:after="LoadAsync">
                        <option value="">Todos</option>
                        @foreach (var u in _users) { <option value="@u.Id">@u.Name</option> }
                    </select>
                </label>
                <label class="esc-field" style="flex:1 1 220px"><span>Acción</span>
                    <select class="esc-select" aria-label="Acción" @bind="_action" @bind:after="LoadAsync">
                        <option value="">Todas</option>
                        @foreach (var a in AdminNames.AuditActions.OrderBy(a => a.Value, StringComparer.CurrentCulture)) { <option value="@a.Key">@a.Value</option> }
                    </select>
                </label>
            </div>
        </section>
        @if (_message is not null)
        {
            <Notice Kind="_messageKind" Title="@_message" />
        }

        <div class="esc-card esc-table-wrap esc-table-wrap--tall">
            <table class="esc-table esc-table--wide">
                <thead><tr><th>Fecha</th><th>Acción</th><th class="esc-hide-sm">Quién</th><th class="esc-hide-sm">Sobre</th><th></th></tr></thead>
                <tbody>
                    @if (_loading)
                    {
                        @for (var i = 0; i < 6; i++)
                        {
                            <tr><td><Skeleton Width="110px" /></td><td><Skeleton Width="140px" /></td><td class="esc-hide-sm"><Skeleton Width="100px" /></td><td class="esc-hide-sm"><Skeleton Width="90px" /></td><td></td></tr>
                        }
                    }
                    else
                    {
                        @foreach (var r in _rows)
                        {
                            var open = _open.Contains(r.Sequence);
                            <tr class="selectable" tabindex="0" aria-expanded="@(open ? "true" : "false")" @onclick="() => Toggle(r.Sequence)" @onkeydown='e => { if (e.Key == "Enter") Toggle(r.Sequence); }'>
                                <td>@Format.Date(r.DateUtc)</td>
                                <td><span style="font-weight:600">@AdminNames.AuditAction(r.Action)</span><span class="esc-table__sub esc-only-sm esc-muted">@Who(r)</span></td>
                                <td class="esc-hide-sm">@Who(r)</td>
                                <td class="esc-hide-sm esc-muted">@AdminNames.AuditResource(r.ResourceType)</td>
                                <td class="esc-num esc-muted"><span class="audit-chevron @(open ? "audit-chevron--open" : "")"><Icon Name="chevron-right" Size="16" /></span></td>
                            </tr>
                            @if (open)
                            {
                                <tr class="audit-detail">
                                    <td colspan="5">
                                        <dl class="esc-dl">
                                            <dt>Registro</dt><dd>#@r.Sequence · @r.Action</dd>
                                            @if (r.ResourceId is { } id) { <dt>@AdminNames.AuditResource(r.ResourceType)</dt><dd class="esc-muted">@id</dd> }
                                        </dl>
                                        <pre class="audit-data">@Pretty(r.Data)</pre>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
            @if (!_loading && _rows.Count == 0)
            {
                <EmptyState Icon="shield" Title="No hay registros con estos filtros">Pruebe con otras fechas, otro usuario u otra acción.</EmptyState>
            }
            @if (_more)
            {
                <div class="esc-table-foot"><Button Disabled="_loading" OnClick="MoreAsync">Ver más</Button></div>
            }
        </div>
    </ChildContent>
</Admin>

@code {
    private const int PageSize = 100; // the API's

    private DateOnly _from = Format.Today.AddDays(-6), _to = Format.Today;
    private string _user = "", _action = "";
    private List<AuditUser> _users = [];
    private List<AuditRow> _rows = [];
    private readonly HashSet<long> _open = [];
    private bool _loading = true, _more, _downloading;
    private int _page = 1;
    private string? _message;
    private Notice.Kinds _messageKind;

    protected override async Task OnInitializedAsync()
    {
        _users = (await Api.GetAsync<List<AuditUser>>("/api/audit/users")).Value ?? [];
        await LoadAsync();
    }

    private string Query => $"from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}" + (_user == "" ? "" : $"&userId={_user}") + (_action == "" ? "" : $"&action={Uri.EscapeDataString(_action)}");

    private async Task LoadAsync()
    {
        (_page, _loading) = (1, true);
        _open.Clear();
        _rows = await PageAsync(1);
        _loading = false;
    }

    private async Task MoreAsync()
    {
        _loading = true;
        _rows.AddRange(await PageAsync(++_page));
        _loading = false;
    }

    private async Task<List<AuditRow>> PageAsync(int page)
    {
        var r = await Api.GetAsync<List<AuditRow>>($"/api/audit?{Query}&page={page}");
        (_messageKind, _message) = (Notice.Kinds.Error, r.Problem is { } p ? Explain(p) : null);
        var items = r.Value ?? [];
        _more = items.Count == PageSize;
        return items;
    }

    private async Task DownloadAsync()
    {
        _downloading = true;
        var file = await Api.GetAsync<FileDownload>($"/api/audit?{Query}&format=csv");
        _downloading = false;
        if (file.Value is { } f)
        {
            await JS.InvokeVoidAsync("escuadra.download", f.FileName, f.ContentType, f.Content);
            (_messageKind, _message) = (Notice.Kinds.Success, $"Listo: {f.FileName}");
        }
        else (_messageKind, _message) = (Notice.Kinds.Error, Explain(file.Problem!));
    }

    private static string Explain(Problem p) => p.Code == "Reports.InvalidPeriod"
        ? "Revise las fechas: “Desde” va antes de “Hasta” y el periodo es de un año como máximo."
        : p.Message;

    private void Toggle(long sequence)
    {
        if (!_open.Remove(sequence)) _open.Add(sequence);
    }

    /// <summary>"Ana" or "Ana · autorizó Pedro"; records without a user were done by Abastalia itself (a background job).</summary>
    private static string Who(AuditRow r) => (r.User ?? (r.UserId is null ? "Abastalia (automático)" : "Usuario borrado")) + (r.Supervisor is { } s ? $" · autorizó {s}" : "");

    /// <summary>The saved JSON, indented and with its accents back (the server escapes them).</summary>
    internal static string Pretty(string data)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(data);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, Indented);
        }
        catch (System.Text.Json.JsonException)
        {
            return data;
        }
    }

    private static readonly System.Text.Json.JsonSerializerOptions Indented = new()
    {
        WriteIndented = true, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
    };
}
