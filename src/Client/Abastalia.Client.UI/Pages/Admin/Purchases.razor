@page "/admin/purchasing"
@inject AbastaliaApi Api
@inject Session Session
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable

<Admin Title="Compras" Subtitle="Mercancía que entra con factura. Al recibirla sube la existencia y se actualiza el costo promedio.">
    <Actions>
        <Segmented Label="Periodo" Options="Periods.Options" Value="@_period" ValueChanged="ChangePeriodAsync" />
        @* TK-224: the invoice goes to the cloud's AI; one fills the form, several become drafts to review one by one. *@
        <label class="esc-button" style="cursor:pointer" title="Suba el PDF o la foto de una factura y se llena el formulario, o elija varias y cada una queda en borrador. Usted revisa antes de recibir.">
            <Icon Name="sparkles" /> @(_reading ? "Leyendo factura…" : "Leer factura con IA")
            <Microsoft.AspNetCore.Components.Forms.InputFile style="display:none" accept=".pdf,.jpg,.jpeg,.png,.webp,.xml" multiple OnChange="ReadInvoiceAsync" disabled="@_reading" />
        </label>
        <Button Variant="Button.Variants.Primary" OnClick="NewAsync"><Icon Name="plus" /> Nueva compra</Button>
    </Actions>
    <ChildContent>
        <SectionTabs Label="Compras" Tabs="SectionTabs.Purchasing(Session)" />
        @if (_notice is not null)
        {
            <Notice Kind="Notice.Kinds.Success" Title="@_notice" />
        }
        @if (_readError is not null)
        {
            <Notice Title="@_readError" />
        }
        @* TK-248: the month's AI readings of the business (the cloud counts them); an XML e-CF never uses one. *@
        @if (_quota is { Remaining: 0 } spent)
        {
            <Notice Kind="Notice.Kinds.Warning" Title="@($"Ya usó las {spent.Limit} lecturas de facturas con IA de este mes. Se renuevan el {spent.ResetsOn:dd/MM/yyyy}.")">
                @(spent.AddOn ? "Mientras, suba el XML del e-CF o escriba la compra a mano." : "Para leer más, pida a Abastalia el servicio adicional de lectura de facturas. Mientras, suba el XML del e-CF o escriba la compra a mano.")
            </Notice>
        }
        else if (_quota is { } quota)
        {
            <p class="esc-muted" style="margin:0 0 8px">Lecturas con IA este mes: le quedan @quota.Remaining de @quota.Limit.@(quota.AddOn ? "" : " Con el servicio adicional puede leer más.")</p>
        }
        @if (_batch is { } batch)
        {
            @* TK-224: several invoices at once, read one after the other; each becomes a draft the person opens, checks and receives. *@
            <section class="esc-card" style="margin-bottom:16px" aria-label="Facturas leídas en lote">
                <div style="display:flex;align-items:center;gap:12px;padding:12px 16px">
                    <div style="flex:1" aria-live="polite">
                        <strong>@BatchTitle(batch)</strong>
                        <span class="esc-table__sub">Nada se recibe solo: abra cada borrador, compárelo con la factura y recíbalo.</span>
                    </div>
                    @if (!_reading) { <Button Variant="Button.Variants.Ghost" OnClick="() => _batch = null">Cerrar lista</Button> }
                </div>
                @if (_batchStop is not null) { <Notice Kind="Notice.Kinds.Warning" Title="@_batchStop" /> }
                <div class="esc-table-wrap">
                    <table class="esc-table">
                        <thead><tr><th>Factura</th><th class="esc-hide-sm">Estado</th><th class="esc-table__chev"><span class="esc-visually-hidden">Revisar</span></th></tr></thead>
                        <tbody>
                            @foreach (var item in batch)
                            {
                                var (pill, label) = BatchStatus(item);
                                <tr>
                                    <td>
                                        <span style="font-weight:600">@(item.Draft?.Review.SupplierName ?? item.Name)</span><span class="esc-table__sub">@BatchDetail(item)</span>
                                        <span class="esc-only-sm"><span class="esc-pill @pill">@label</span></span>
                                    </td>
                                    <td class="esc-hide-sm"><span class="esc-pill @pill">@label</span></td>
                                    <td class="esc-num">
                                        @if (item.Draft is not null && !item.Done)
                                        {
                                            <button type="button" class="esc-button esc-button--small" aria-label="@($"Revisar {item.Name}")" @onclick="() => ReviewAsync(item)">Revisar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        @if (_purchases is { Count: > 0 })
        {
            var posted = _purchases.Where(p => p.Status == "Posted").ToList();
            var drafts = _purchases.Count(p => p.Status == "Draft");
            <span class="esc-muted">@posted.Count @(posted.Count == 1 ? "compra recibida" : "compras recibidas") · @Format.WithCurrency(posted.Sum(p => p.Total))@(drafts > 0 ? $" · {drafts} en borrador" : "")</span>
        }
        <div class="esc-card esc-table-wrap esc-table-wrap--tall">
            <table class="esc-table esc-table--wide">
                <thead><tr><th>Suplidor</th><th class="esc-hide-sm">Fecha</th><th class="esc-hide-sm">NCF</th><th>Estado</th><th class="esc-hide-sm">Pago</th><th class="esc-num">Total</th><th class="esc-table__chev esc-hide-sm"><span class="esc-visually-hidden">Abrir</span></th></tr></thead>
                <tbody>
                    @if (_purchases is null)
                    {
                        @for (var i = 0; i < 5; i++)
                        {
                            <tr><td><Skeleton Width="170px" /></td><td class="esc-hide-sm"><Skeleton Width="80px" /></td><td class="esc-hide-sm"><Skeleton Width="110px" /></td><td><Skeleton Width="80px" /></td><td class="esc-hide-sm"><Skeleton Width="70px" /></td><td><Skeleton /></td><td class="esc-hide-sm"></td></tr>
                        }
                    }
                    else
                    {
                        @foreach (var p in _purchases)
                        {
                            <tr class="selectable" tabindex="0" @onclick="() => OpenAsync(p.Id)" @onkeydown='e => e.Key == "Enter" ? OpenAsync(p.Id) : Task.CompletedTask' style="@(p.Status == "Voided" ? "color:var(--text-3)" : "")">
                                <td><span style="font-weight:600">@p.Supplier</span><span class="esc-table__sub">Compra #@p.Number<span class="esc-only-sm"> · @AdminNames.Day(p.InvoiceDate)</span></span></td>
                                <td class="esc-hide-sm" style="white-space:nowrap">@AdminNames.Day(p.InvoiceDate)</td>
                                <td class="esc-hide-sm" style="font-variant-numeric:tabular-nums">@(p.Ncf is { Length: > 0 } ? p.Ncf : "Sin NCF")</td>
                                <td><span class="esc-pill @(p.Status switch { "Posted" => "esc-pill--success", "Draft" => "esc-pill--warning", _ => "esc-pill--neutral" })">@AdminNames.PurchaseStatus(p.Status)</span></td>
                                <td class="esc-hide-sm">@AdminNames.Terms(p.Terms)</td>
                                <td class="esc-num" style="font-weight:600">@Format.Amount(p.Total)</td>
                                <td class="esc-table__chev esc-hide-sm"><Icon Name="chevron-right" Size="18" /></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_purchases is { Count: 0 })
            {
                <EmptyState Icon="truck" Title="No hay compras en este periodo">@(_message ?? "Registre la factura del suplidor con “Nueva compra”: la mercancía entra al inventario al recibirla.")</EmptyState>
            }
        </div>

        @if (_editing is { } f)
        {
            <Dialog Title="@(f.Number is { } n ? $"Compra #{n} (borrador)" : "Nueva compra")" Subtitle="Copie la factura del suplidor. Los costos van sin ITBIS." Wide="true" OnClose="() => _editing = null">
                <ChildContent>
                    @if (f.Review.Count > 0)
                    {
                        <Notice Kind="Notice.Kinds.Warning" Title="@(f.FromEcf ? "Tomada del e-CF del suplidor: elija los productos que falten antes de guardar" : "Leída con IA: compare todo con la factura antes de guardar")">
                            <ul style="margin:0;padding-left:18px">@foreach (var w in f.Review) { <li>@w</li> }</ul>
                        </Notice>
                    }
                    @if (f.AttachmentName is { } invoice)
                    {
                        @* TK-224: the draft is checked against the invoice it was read from. *@
                        <p style="margin:0 0 12px"><Button class="esc-button esc-button--small" OnClick="() => DownloadAttachmentAsync(f.Id)"><Icon Name="receipt" Size="16" /> Ver factura original (@invoice)</Button></p>
                    }
                    <SupplierFields Suppliers="_suppliers" @bind-SupplierId="f.SupplierId" @bind-Ncf="f.Ncf" @bind-Date="f.Date" @bind-NcfOverrideReason="f.NcfOverrideReason" Errors="_errors" />
                    @if (_warehouses.Count > 1)
                    {
                        <Field Label="Entra a">
                            <select class="esc-select" @bind="f.Warehouse">
                                @foreach (var w in _warehouses.Where(w => w.IsActive)) { <option value="@w.Id">@w.Name</option> }
                            </select>
                        </Field>
                    }
                    <ProductPicker OnPick="AddAsync" />
                    <div class="esc-table-wrap">
                        <table class="esc-table">
                            <thead><tr><th>Producto</th><th class="esc-num">Cantidad</th><th class="esc-num">Costo sin ITBIS</th><th class="esc-hide-sm">ITBIS</th><th class="esc-num esc-hide-sm">Subtotal</th><th class="esc-table__chev"><span class="esc-visually-hidden">Quitar</span></th></tr></thead>
                            <tbody>
                                @foreach (var l in f.Lines)
                                {
                                    <tr>
                                        <td style="font-weight:600">@l.Name
                                            @if (l.Error is not null) { <span class="esc-field__error" role="alert"><Icon Name="alert" Size="14" />@l.Error</span> }
                                        </td>
                                        <td class="esc-num" style="white-space:nowrap"><input class="esc-input cell-input" style="width:90px" inputmode="decimal" aria-label="@($"Cantidad de {l.Name}")" @bind="l.Quantity" @bind:event="oninput" @bind:after="() => l.Error = null" /> @(l.Unit == "Pound" ? "lb" : "")</td>
                                        <td class="esc-num"><input class="esc-input cell-input" inputmode="decimal" aria-label="@($"Costo de {l.Name}")" @bind="l.Cost" @bind:event="oninput" @bind:after="() => l.Error = null" /></td>
                                        <td class="esc-hide-sm">
                                            <select class="esc-select" style="width:auto;min-height:40px" aria-label="@($"ITBIS de {l.Name}")" @bind="l.Rate">
                                                <option value="@ItbisRate.General18">18 %</option>
                                                <option value="@ItbisRate.Reduced16">16 %</option>
                                                <option value="@ItbisRate.Zero">0 %</option>
                                                <option value="@ItbisRate.Exempt">Exento</option>
                                            </select>
                                        </td>
                                        <td class="esc-num esc-hide-sm">@Format.Amount(l.Subtotal)</td>
                                        <td class="esc-table__chev"><button type="button" class="esc-button esc-button--ghost esc-button--small" aria-label="@($"Quitar {l.Name}")" @onclick="() => f.Lines.Remove(l)"><Icon Name="x" Size="16" /></button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (f.Lines.Count == 0)
                        {
                            <EmptyState Icon="package" Title="Agregue los productos de la factura">@(_errors.ContainsKey("lines") ? "La compra necesita al menos un producto." : "Búsquelos arriba por nombre, PLU o código de barras.")</EmptyState>
                        }
                    </div>
                    <dl class="totals">
                        <dt>Subtotal</dt><dd>@Format.Amount(f.Lines.Sum(l => l.Subtotal))</dd>
                        <dt>ITBIS</dt><dd>@Format.Amount(f.Lines.Sum(l => l.Itbis))</dd>
                        <dt>Total</dt><dd class="totals__grand">@Format.WithCurrency(f.Lines.Sum(l => l.Subtotal + l.Itbis))</dd>
                    </dl>
                    <TermsFields @bind-Terms="f.Terms" @bind-Method="f.Method" @bind-CreditDays="f.CreditDays" Error="@_errors.GetValueOrDefault("days")" />
                    <div class="esc-form-grid">
                        <Field Label="Total de la factura" Error="@_errors.GetValueOrDefault("invoiceTotal")" Hint="Opcional: si la factura dice otro total por centavos, escríbalo y se usa ese.">
                            <input class="esc-input esc-num" inputmode="decimal" @bind="f.InvoiceTotal" @bind:after='() => _errors.Remove("invoiceTotal")' />
                        </Field>
                        <Field Label="Nota" Hint="Opcional.">
                            <input class="esc-input" maxlength="500" @bind="f.Notes" />
                        </Field>
                    </div>
                    @if (_error is not null) { <Notice Title="@_error" /> }
                </ChildContent>
                <Footer>
                    @if (f.Saved)
                    {
                        <Button Variant="Button.Variants.Ghost" Disabled="_sending" OnClick="() => DiscardAsync(f)">Descartar borrador</Button>
                        <span class="esc-spacer"></span>
                    }
                    <Button OnClick="() => _editing = null" Shortcut="Esc">Cancelar</Button>
                    <Button Disabled="_sending" OnClick="() => SaveAsync(post: false)">Guardar borrador</Button>
                    <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="() => SaveAsync(post: true)">@(_sending ? "Guardando…" : "Recibir mercancía")</Button>
                </Footer>
            </Dialog>
        }

        @if (_shown is { } d)
        {
            <Dialog Title="@($"Compra #{d.Number} · {d.SupplierName}")" Subtitle="@($"NCF {d.Ncf} · {AdminNames.Day(d.InvoiceDate)} · {AdminNames.Terms(d.Terms.ToString())}{(d.DueDate is { } due ? $", vence {AdminNames.Day(due)}" : "")}")" Wide="true" OnClose="() => _shown = null">
                <ChildContent>
                    @if (d.Status == "Voided") { <Notice Kind="Notice.Kinds.Warning" Title="Anulada">@d.VoidReason</Notice> }
                    <div class="esc-table-wrap">
                        <table class="esc-table">
                            <thead><tr><th>Producto</th><th class="esc-num">Cantidad</th><th class="esc-num esc-hide-sm">Costo</th><th class="esc-hide-sm">ITBIS</th><th class="esc-num">Subtotal</th></tr></thead>
                            <tbody>
                                @foreach (var l in d.Lines)
                                {
                                    <tr><td style="font-weight:600">@l.Description</td><td class="esc-num">@AdminNames.Number(l.Quantity)</td><td class="esc-num esc-hide-sm">@Format.Amount(l.UnitCost)</td><td class="esc-hide-sm">@Names.Itbis(l.ItbisRate.ToString())</td><td class="esc-num">@Format.Amount(l.Subtotal)</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <dl class="totals">
                        <dt>Subtotal</dt><dd>@Format.Amount(d.Subtotal)</dd>
                        <dt>ITBIS</dt><dd>@Format.Amount(d.Itbis)</dd>
                        <dt>Total</dt><dd class="totals__grand">@Format.WithCurrency(d.Total)</dd>
                    </dl>
                    @if (d.Notes is { Length: > 0 }) { <p class="esc-muted">@d.Notes</p> }
                    @if (d.AttachmentName is { } attached)
                    {
                        <p><Button class="esc-button esc-button--small" OnClick="() => DownloadAttachmentAsync(d.Id)">Factura original (@attached)</Button></p>
                    }
                    @if (_voiding)
                    {
                        <Field Label="¿Por qué se anula? *" Hint="La mercancía sale del inventario. No se puede si ya tiene pagos.">
                            <input class="esc-input" maxlength="200" @bind="_voidReason" @bind:event="oninput" autofocus />
                        </Field>
                    }
                    @if (_error is not null) { <Notice Title="@_error" /> }
                </ChildContent>
                <Footer>
                    <Button OnClick="() => _shown = null" Shortcut="Esc">Cerrar</Button>
                    @if (d.Status != "Voided")
                    {
                        @if (_voiding)
                        {
                            <Button Variant="Button.Variants.Danger" Disabled="@(string.IsNullOrWhiteSpace(_voidReason) || _sending)" OnClick="() => VoidAsync(d)">Anular compra</Button>
                        }
                        else
                        {
                            <Button Variant="Button.Variants.Danger" OnClick="() => _voiding = true">Anular</Button>
                        }
                    }
                </Footer>
            </Dialog>
        }
    </ChildContent>
</Admin>

@code {
    private sealed class LineForm
    {
        public Guid ProductId; public Guid? PresentationId; public string Name = "", Unit = "Unit"; public string? Quantity, Cost, Error; public ItbisRate Rate = ItbisRate.General18;
        public decimal Subtotal => Math.Round((Format.ParseNumber(Quantity) ?? 0) * (Format.ParseNumber(Cost) ?? 0), 2, MidpointRounding.AwayFromZero);
        public decimal Itbis => Math.Round(Subtotal * (Rate switch { ItbisRate.General18 => 0.18m, ItbisRate.Reduced16 => 0.16m, _ => 0m }), 2, MidpointRounding.AwayFromZero);
    }

    private sealed class PurchaseForm
    {
        public Guid Id = Guid.CreateVersion7(); public long? Number; public bool Saved; public Guid? SupplierId; public string? Ncf, Warehouse, CreditDays, InvoiceTotal, Notes, NcfOverrideReason;
        public DateOnly Date = Format.Today; public PaymentTerms Terms = PaymentTerms.Credit; public SupplierPaymentMethod? Method = SupplierPaymentMethod.Cash;
        public List<LineForm> Lines = [];
        /// <summary>What to check after the AI read the invoice (TK-224).</summary>
        public List<string> Review = [];
        /// <summary>TK-240: filled from the supplier's e-CF (exact) instead of the AI.</summary>
        public bool FromEcf;
        /// <summary>The original invoice already attached to the saved draft.</summary>
        public string? AttachmentName;
        /// <summary>TK-240: the uploaded invoice, attached to the purchase when it is saved.</summary>
        public (byte[] Content, string ContentType, string Name)? Original;
    }

    [SupplyParameterFromQuery(Name = "fromEcf")] public Guid? FromReceived { get; set; }

    private List<PurchaseSummary>? _purchases;
    private List<Supplier> _suppliers = [];
    private List<Warehouse> _warehouses = [];
    private PurchaseForm? _editing;
    private PurchaseDetail? _shown;
    private string _period = "month";
    private string? _message, _error, _notice, _voidReason, _readError;
    private bool _sending, _voiding, _reading;
    private InvoiceReadingQuota? _quota;
    private readonly Dictionary<string, string> _errors = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await LoadQuotaAsync();
        // TK-240: "Registrar compra" on a received e-CF opens the form filled from it.
        if (FromReceived is not { } id) return;
        var r = await Api.PostAsync<InvoiceRead>("/api/purchasing/purchases/from-ecf", new { ReceivedId = id });
        if (r.Value is { } read) await FillAsync(read, null);
        else _readError = r.Problem?.Message;
    }

    private async Task ChangePeriodAsync(string period)
    {
        _period = period;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _purchases = null;
        var (from, to) = Periods.Range(_period);
        var r = await Api.GetAsync<List<PurchaseSummary>>($"/api/purchasing/purchases?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}");
        (_purchases, _message) = (r.Value ?? [], r.Problem?.Message);
    }

    /// <summary>Null when the store is not connected to the cloud: then nothing is shown.</summary>
    private async Task LoadQuotaAsync() => _quota = (await Api.GetAsync<InvoiceReadingQuota>("/api/purchasing/purchases/read-invoice/quota")).Value;

    private async Task LoadChoicesAsync()
    {
        _suppliers = (await Api.GetAsync<List<Supplier>>("/api/purchasing/suppliers")).Value ?? [];
        _warehouses = (await Api.GetAsync<List<Warehouse>>("/api/inventory/warehouses")).Value ?? [];
    }

    private async Task NewAsync()
    {
        (_error, _notice) = (null, null);
        _errors.Clear();
        await LoadChoicesAsync();
        _editing = new PurchaseForm { Warehouse = _warehouses.Find(w => w.IsMain)?.Id.ToString() };
    }

    private async Task OpenAsync(Guid id)
    {
        (_error, _notice, _voiding, _voidReason) = (null, null, false, null);
        var r = await Api.GetAsync<PurchaseDetail>($"/api/purchasing/purchases/{id}");
        if (r.Value is not { } d) { _message = r.Problem?.Message; return; }
        if (d.Status != "Draft") { _shown = d; return; }
        _errors.Clear();
        await LoadChoicesAsync();
        _editing = new PurchaseForm
        {
            Id = d.Id, Number = d.Number, Saved = true, SupplierId = d.SupplierId, Ncf = d.Ncf, Date = d.InvoiceDate, Terms = d.Terms, Method = d.Method ?? SupplierPaymentMethod.Cash,
            Warehouse = (d.WarehouseId ?? _warehouses.Find(w => w.IsMain)?.Id)?.ToString(), Notes = d.Notes, AttachmentName = d.AttachmentName,
            // A draft from the DGII Excel (TK-223) has the invoice total and no products yet.
            InvoiceTotal = d.Lines.Length == 0 && d.Total > 0 ? AdminNames.Number(d.Total) : null,
            Lines = [.. d.Lines.Select(l => new LineForm { ProductId = l.ProductId, PresentationId = l.PresentationId, Name = l.Description, Quantity = AdminNames.Number(l.Quantity), Cost = AdminNames.Number(l.UnitCost), Rate = l.ItbisRate })],
        };
    }

    /// <summary>TK-224: the AI's reading fills a new purchase form; lines it could not match to a product are listed for the person to add.
    /// Several files go one by one, each to its own draft (<see cref="ReadBatchAsync"/>).</summary>
    private async Task ReadInvoiceAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        (_error, _notice, _readError) = (null, null, null);
        if (e.FileCount > MaxBatch) { _readError = $"Elija hasta {MaxBatch} facturas a la vez."; return; }
        if (e.FileCount > 1) { await ReadBatchAsync(e.GetMultipleFiles(MaxBatch)); return; }
        if (await ReadFileAsync(e.File) is not { } original) { _readError = "La factura pasa de 4 MB: tome la foto con menos resolución."; return; }
        _reading = true;
        var r = await Api.PostAsync<InvoiceRead>("/api/purchasing/purchases/read-invoice",
            new { File = Convert.ToBase64String(original.Content), original.ContentType, FileName = original.Name }, TimeSpan.FromSeconds(90));
        _reading = false;
        await LoadQuotaAsync();
        if (r.Value is not { } read) { _readError = r.Problem?.Message; return; }
        await FillAsync(read, original);
    }

    /// <summary>Null when the file passes 4 MB. An e-CF XML goes as XML whatever the browser says.</summary>
    private static async Task<(byte[] Content, string ContentType, string Name)?> ReadFileAsync(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        using var copy = new MemoryStream();
        try
        {
            await using var stream = file.OpenReadStream(4_000_000);
            await stream.CopyToAsync(copy);
        }
        catch (IOException) { return null; }
        return (copy.ToArray(), file.Name.EndsWith(".xml", StringComparison.OrdinalIgnoreCase) ? "application/xml" : file.ContentType, file.Name);
    }

    private const int MaxBatch = 20;

    private sealed class BatchItem(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        public readonly Microsoft.AspNetCore.Components.Forms.IBrowserFile File = file;
        public (byte[] Content, string ContentType, string Name)? Original;
        public InvoiceDraft? Draft;
        public string? Error;
        public bool Reading, Waiting, Done;
        /// <summary>The purchase opened from it, so saving or discarding that purchase marks it reviewed.</summary>
        public Guid? FormId;
        public string Name => File.Name;
    }

    private List<BatchItem>? _batch;
    private string? _batchStop;
    private bool _left;

    public void Dispose() => _left = true;

    /// <summary>TK-224: one after the other (the cloud limits readings per minute and per month). A spent quota, a store without the cloud or a busy
    /// cloud stops the batch: the files left are listed as not read. The drafts are never received here.</summary>
    private async Task ReadBatchAsync(IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile> files)
    {
        (_batch, _batchStop, _reading) = ([.. files.Select(f => new BatchItem(f))], null, true);
        foreach (var item in _batch)
        {
            if (_left || _batchStop is not null) break;
            item.Reading = true;
            StateHasChanged();
            await DraftAsync(item);
            item.Reading = item.Waiting = false;
        }
        _reading = false;
        await LoadQuotaAsync();
        await LoadAsync();
    }

    private async Task DraftAsync(BatchItem item)
    {
        if (await ReadFileAsync(item.File) is not { } original) { item.Error = "Pasa de 4 MB: tome la foto con menos resolución."; return; }
        item.Original = original;
        for (var attempt = 1; ; attempt++)
        {
            var r = await Api.PostAsync<InvoiceDraft>("/api/purchasing/purchases/draft-from-invoice",
                new { File = Convert.ToBase64String(original.Content), original.ContentType, FileName = original.Name }, TimeSpan.FromSeconds(90));
            if (r.Value is { } draft) { (item.Draft, item.FormId) = (draft, draft.PurchaseId); return; }
            // The per-minute limit: wait it out once, then stop.
            if (r.Problem is { Code: "Purchasing.AiBusy" } && attempt == 1 && !_left)
            {
                item.Waiting = true;
                StateHasChanged();
                await Task.Delay(TimeSpan.FromMinutes(1));
                item.Waiting = false;
                continue;
            }
            if (r.Problem is { Code: "Purchasing.AiQuotaExceeded" or "Purchasing.AiBusy" or "Purchasing.AiNeedsCloud" or "Purchasing.AiUnreachable" } or { IsUncertain: true })
                _batchStop = $"{r.Problem.Message} Las facturas que faltan no se leyeron.";
            else item.Error = r.Problem?.Message;
            return;
        }
    }

    private static string BatchTitle(List<BatchItem> batch)
    {
        if (batch.FindIndex(b => b.Reading) is var i and >= 0) return $"Leyendo factura {i + 1} de {batch.Count}…";
        var read = batch.Count(b => b.Draft is not null);
        var pending = batch.Count(b => b.Draft is not null && !b.Done);
        return $"{read} de {batch.Count} facturas leídas" + (pending > 0 ? $" · {pending} por revisar" : read > 0 ? " · todas revisadas" : "");
    }

    private (string Pill, string Label) BatchStatus(BatchItem b) => b switch
    {
        { Waiting: true } => ("esc-pill--neutral", "Esperando un minuto…"),
        { Reading: true } => ("esc-pill--neutral", "Leyendo…"),
        { Done: true } => ("esc-pill--success", "Revisada"),
        { Draft.PurchaseId: not null } => ("esc-pill--warning", "Borrador por revisar"),
        { Draft: not null } => ("esc-pill--warning", "Falta el suplidor"),
        { Error: not null } => ("esc-pill--error", "No se leyó"),
        _ => ("esc-pill--neutral", _reading ? "En espera" : "Sin leer"),
    };

    private static string BatchDetail(BatchItem b) => b switch
    {
        { Error: { } error } => error,
        { Draft.Review: { } r } =>
            $"{b.Name}{(r.Total is { } t ? $" · {Format.WithCurrency(t)}" : "")} · {r.Warnings.Length} {(r.Warnings.Length == 1 ? "aviso" : "avisos")}",
        _ => "",
    };

    /// <summary>A draft opens with what to check; an invoice without a supplier fills a new form, as one read alone.</summary>
    private async Task ReviewAsync(BatchItem item)
    {
        var read = item.Draft!.Review;
        if (item.Draft.PurchaseId is not { } id)
        {
            await FillAsync(read, item.Original);
            item.FormId = _editing!.Id;
            return;
        }
        await OpenAsync(id);
        if (_editing is { } f) (f.Review, f.FromEcf) = (ReviewOf(read, []), read.Source == "ecf");
    }

    private static List<string> ReviewOf(InvoiceRead read, IEnumerable<string> missing) =>
    [
        $"Proveedor leído: {read.SupplierName ?? "?"} (RNC {read.SupplierRnc ?? "?"}) · Total {(read.Total is { } total ? Format.WithCurrency(total) : "?")} · Seguridad {read.Confidence:P0}",
        .. read.Warnings,
        .. missing,
    ];

    private async Task FillAsync(InvoiceRead read, (byte[] Content, string ContentType, string Name)? original)
    {
        await NewAsync();
        var f = _editing!;
        (f.FromEcf, f.Original) = (read.Source == "ecf", original);
        (f.SupplierId, f.Ncf, f.InvoiceTotal) = (read.SupplierId, read.Ncf, read.Total is { } t ? AdminNames.Number(t) : null);
        if (read.Date is { } date) f.Date = date;
        f.Lines.AddRange(read.Lines.Where(l => l.ProductId is not null).Select(l => new LineForm
        {
            ProductId = l.ProductId!.Value, Name = l.ProductName ?? l.Description, Quantity = l.Quantity is { } q ? AdminNames.Number(q) : null,
            Cost = l.UnitCost is { } c ? AdminNames.Number(c) : null, Rate = l.ItbisRate ?? ItbisRate.General18,
        }));
        f.Review = ReviewOf(read,
            read.Lines.Where(l => l.ProductId is null).Select(l => $"Agregue: {l.Description} ({(l.Quantity is { } q ? AdminNames.Number(q) : "?")} × {(l.UnitCost is { } c ? Format.Amount(c) : "?")})"));
    }

    /// <summary>Adds the product with its last cost and ITBIS; a product already in the list is not repeated.</summary>
    private async Task AddAsync(ProductSummary p)
    {
        if (_editing is not { } f) return;
        _errors.Remove("lines");
        if (f.Lines.Any(l => l.ProductId == p.Id)) return;
        var line = new LineForm { ProductId = p.Id, Name = p.Name, Unit = p.Unit, Rate = Enum.TryParse<ItbisRate>(p.ItbisRate, out var rate) ? rate : ItbisRate.General18 };
        f.Lines.Add(line);
        if ((await Api.GetAsync<ProductDetail>($"/api/inventory/products/{p.Id}")).Value is { Cost: > 0 and var cost }) line.Cost = AdminNames.Number(Math.Round(cost, 2));
    }

    private async Task SaveAsync(bool post)
    {
        if (_editing is not { } f) return;
        _errors.Clear();
        _error = null;
        SupplierFields.Validate(f.SupplierId, f.Ncf, f.Date, _errors, ncfOptional: !post);
        if (f.Lines.Count == 0) _errors["lines"] = "Agregue al menos un producto.";
        foreach (var l in f.Lines)
        {
            l.Error = Format.ParseNumber(l.Quantity) is not > 0 ? "Escriba la cantidad."
                : Format.ParseNumber(l.Cost) is not >= 0 ? "Escriba el costo sin ITBIS."
                : null;
        }
        var days = TermsFields.Days(f.Terms, f.CreditDays, _errors);
        decimal? invoiceTotal = null;
        if (!string.IsNullOrWhiteSpace(f.InvoiceTotal) && (invoiceTotal = Format.ParseNumber(f.InvoiceTotal)) is not > 0) _errors["invoiceTotal"] = "Escriba un número o déjelo vacío.";
        if (_errors.Count > 0 || f.Lines.Any(l => l.Error is not null)) return;

        var body = new SavePurchase(f.SupplierId!.Value, (f.Ncf ?? "").Trim().ToUpperInvariant(), f.Date, f.Terms,
            [.. f.Lines.Select(l => new PurchaseLineInput(l.ProductId, l.PresentationId, Format.ParseNumber(l.Quantity)!.Value, Format.ParseNumber(l.Cost)!.Value, l.Rate))],
            Guid.TryParse(f.Warehouse, out var w) ? w : null, days, string.IsNullOrWhiteSpace(f.Notes) ? null : f.Notes.Trim(), null, invoiceTotal,
            f.Saved ? null : f.Id, f.Terms == PaymentTerms.Cash ? f.Method : null, f.NcfOverrideReason);
        _sending = true;
        var saved = f.Saved ? await Api.PutAsync<PurchaseSaved>($"/api/purchasing/purchases/{f.Id}", body) : await Api.PostAsync<PurchaseSaved>("/api/purchasing/purchases", body);
        if (saved.Problem is { } p)
        {
            _sending = false;
            if (!SupplierFields.Explain(p, _errors)) _error = p.Code == "Purchasing.InvoiceTotalMismatch" ? $"{p.Message} O deje vacío el total de la factura." : p.Message;
            return;
        }
        f.Saved = true;
        // TK-240: the original invoice goes with the purchase, once. The person picked it, so it replaces an earlier one; the server takes its type from the bytes.
        if (f.Original is { } o)
        {
            var attached = await Api.PutAsync<Empty>($"/api/purchasing/purchases/{f.Id}/attachment",
                new { File = Convert.ToBase64String(o.Content), o.ContentType, FileName = o.Name });
            if (attached.Problem is { } notAttached)
            {
                _sending = false;
                _error = $"Se guardó el borrador, pero no se pudo adjuntar la factura: {notAttached.Message}";
                return;
            }
            f.Original = null;
        }
        if (post && (await Api.PostAsync<Empty>($"/api/purchasing/purchases/{f.Id}/post")).Problem is { } notPosted)
        {
            _sending = false;
            _error = $"Se guardó el borrador, pero no se pudo recibir: {notPosted.Message}";
            return;
        }
        _sending = false;
        var supplier = _suppliers.Find(s => s.Id == f.SupplierId)?.Name;
        _notice = post ? $"Compra de {supplier} recibida: la mercancía ya está en el inventario." : $"Borrador de {supplier} guardado. Recíbalo cuando llegue la mercancía.";
        MarkReviewed(f);
        _editing = null;
        await LoadAsync();
    }

    private async Task DiscardAsync(PurchaseForm f)
    {
        _sending = true;
        var r = await Api.PostAsync<Empty>($"/api/purchasing/purchases/{f.Id}/void", new VoidReason("Borrador descartado"));
        _sending = false;
        if (r.Problem is { } p) { _error = p.Message; return; }
        MarkReviewed(f);
        (_editing, _notice) = (null, "Borrador descartado.");
        await LoadAsync();
    }

    private void MarkReviewed(PurchaseForm f)
    {
        if (_batch?.Find(b => b.FormId == f.Id) is { } item) item.Done = true;
    }

    private async Task DownloadAttachmentAsync(Guid id)
    {
        var file = await Api.GetAsync<FileDownload>($"/api/purchasing/purchases/{id}/attachment");
        if (file.Value is { } f) await JS.InvokeVoidAsync("escuadra.download", f.FileName, f.ContentType, f.Content);
        else _error = file.Problem?.Message;
    }

    private async Task VoidAsync(PurchaseDetail d)
    {
        _sending = true;
        var r = await Api.PostAsync<Empty>($"/api/purchasing/purchases/{d.Id}/void", new VoidReason(_voidReason!.Trim()));
        _sending = false;
        if (r.Problem is { } p) { _error = p.Message; return; }
        (_shown, _notice) = (null, $"Compra #{d.Number} anulada.");
        await LoadAsync();
    }
}
