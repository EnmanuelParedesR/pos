@page "/admin/settings"
@inject AbastaliaApi Api
@inject Session Session
@inject Peripherals Peripherals
@inject NodeCertificatePin Pin
@inject BusinessLogo Logo

<Admin Title="Configuración" Subtitle="Los datos del negocio, las cajas, los comprobantes y quién puede entrar.">
    <div class="esc-tabs" role="tablist" aria-label="Secciones">
        @foreach (var s in Sections)
        {
            <button type="button" role="tab" aria-selected="@(s == _section ? "true" : "false")" @onclick="() => GoAsync(s)">@Label(s)</button>
        }
    </div>
    @if (_message is not null)
    {
        <Notice Kind="_messageKind" Title="@_message" />
    }

    <div class="esc-settings">
    @switch (_section)
    {
        case Section.Business when _business is not null:
            <form class="esc-card esc-setting" @onsubmit="SaveBusinessAsync" novalidate>
                <div class="esc-setting__about"><h2>Datos del negocio</h2><p>Salen en la factura y en los reportes para la DGII.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-form-grid">
                        <Field Label="Nombre del negocio" Wide="true" Error="@Err("name")">
                            <input class="esc-input" maxlength="150" @bind="_business.Name" @bind:after='() => Clear("name")' aria-invalid="@Invalid("name")" />
                        </Field>
                        <Field Label="RNC" Error="@Err("rnc")" Hint="@(_registryName is { } dgii ? $"En el padrón de la DGII: {dgii}" : "9 u 11 números, sin guiones.")">
                            <input class="esc-input" inputmode="numeric" maxlength="11" @bind="_business.Rnc" @bind:after="RncChangedAsync" aria-invalid="@Invalid("rnc")" />
                        </Field>
                        <Field Label="Teléfono">
                            <input class="esc-input" maxlength="30" @bind="_business.Phone" />
                        </Field>
                        <Field Label="Dirección" Wide="true">
                            <input class="esc-input" maxlength="200" @bind="_business.Address" />
                        </Field>
                        <Field Label="Pie de la factura" Wide="true" Hint="Por ejemplo: ¡Gracias por su compra!">
                            <input class="esc-input" maxlength="500" @bind="_business.ReceiptFooter" />
                        </Field>
                        <Field Label="Descuento máximo sin supervisor (%)" Error="@Err("discount")" Hint="Más que esto pide el PIN de un supervisor.">
                            <input class="esc-input esc-num" inputmode="decimal" @bind="_business.DiscountCap" @bind:after='() => Clear("discount")' aria-invalid="@Invalid("discount")" />
                        </Field>
                        <label class="esc-check"><input type="checkbox" @bind="_business.RequireReference" /> Pedir el número de autorización en pagos con tarjeta o transferencia</label>
                    </div>
                    <div class="esc-form-actions"><Button Type="submit" Variant="Button.Variants.Primary">Guardar cambios</Button></div>
                </div>
            </form>
            @* TK-280: the logo goes on its own card: it is saved as soon as it is picked, not with "Guardar cambios". *@
            <section class="esc-card esc-setting" aria-labelledby="logo-title">
                <div class="esc-setting__about"><h2 id="logo-title">Logo</h2><p>Sale arriba en la factura impresa, en la representación impresa de los comprobantes electrónicos y en su catálogo en línea.</p></div>
                <div class="esc-setting__body">
                    @if (_logoUrl is not null)
                    {
                        <div class="esc-logo-preview">
                            <figure><img src="@_logoUrl" alt="Logo de @_business.Name" /><figcaption>Así se ve en la pantalla y en el catálogo</figcaption></figure>
                            @if (_logoRaster is { } raster)
                            {
                                <figure class="esc-logo-preview__paper"><img src="@BusinessLogo.BmpDataUrl(raster)" alt="El logo como sale en la impresora" style="width:@(raster.Width * 100 / 576)%" /><figcaption>Así sale en el rollo de 80 mm (un solo color)</figcaption></figure>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="esc-muted">Todavía no hay logo. La factura sale con el nombre del negocio arriba.</p>
                    }
                    <Field Label="@(_logoUrl is null ? "Imagen (PNG o JPG)" : "Cambiar el logo (PNG o JPG)")" Error="@Err("logo")" Hint="Se guarda al elegirla. Hasta 512 KB, mejor en fondo blanco o transparente y con buen contraste: la impresora térmica imprime en un solo color.">
                        <Microsoft.AspNetCore.Components.Forms.InputFile class="esc-input" accept=".png,.jpg,.jpeg,image/png,image/jpeg" OnChange="UploadLogoAsync" disabled="@_sending" />
                    </Field>
                    @if (_logoUrl is not null)
                    {
                        <div class="esc-form-actions"><Button Disabled="_sending" OnClick="RemoveLogoAsync"><Icon Name="x" Size="16" /> @(_removingLogo ? "¿Quitar el logo? Toque otra vez" : "Quitar el logo")</Button></div>
                    }
                </div>
            </section>
            @* The approval policy is settings.manage (TK-213), so it lives with the business data, not with Cajas (registers.manage). *@
            <form class="esc-card esc-setting" @onsubmit="SaveApprovalsAsync" novalidate>
                <div class="esc-setting__about"><h2>Autorizaciones</h2><p>Pedir autorización de supervisor para… Si nadie supervisa (por ejemplo, un colmado de una persona), apáguelas: quien atiende lo hace solo y queda igual en la auditoría.</p></div>
                <div class="esc-setting__body">
                    <fieldset class="esc-col" style="gap:0;border:0;padding:0;margin:0" aria-label="Pedir autorización de supervisor para">
                        @foreach (var rule in _approvals)
                        {
                            @* R8 #5: an action your role cannot do stays as it is; turning it off would let you (and anyone) do it alone. *@
                            var locked = rule.Required && !Session.Can(rule.Permission);
                            <label class="esc-check"><input type="checkbox" role="switch" checked="@rule.Required" disabled="@locked" @onchange="e => _approvals[_approvals.IndexOf(rule)] = rule with { Required = (bool)e.Value! }" /> @Approver.Explain(rule.Permission)@(locked ? " (su rol no la permite: no la puede apagar)" : "")</label>
                        }
                    </fieldset>
                    <span class="esc-muted">Una acción apagada la hace sola cualquier persona que pueda usar la caja, no solo usted.</span>
                    <div class="esc-form-actions"><Button Type="submit" Variant="Button.Variants.Primary" Disabled="_sending">Guardar autorizaciones</Button></div>
                </div>
            </form>
            break;

        case Section.Registers:
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Cajas</h2><p>Cada caja abre y cierra su propio turno. Su licencia permite @(_features?.Registers.ToString() ?? "varias").</p></div>
                <div class="esc-setting__body">
                    <div class="esc-table-wrap">
                        <table class="esc-table">
                            <thead><tr><th>Caja</th><th class="esc-hide-sm">Estado</th><th class="esc-hide-sm esc-num">Fondo estándar</th><th><span class="esc-visually-hidden">Acción</span></th></tr></thead>
                            <tbody>
                                @foreach (var register in _registers)
                                {
                                    @if (_floatFor == register.Id)
                                    {
                                        <tr><td colspan="4" style="padding-top:8px;padding-bottom:8px;height:auto">
                                            <form class="esc-row" style="align-items:flex-start" @onsubmit="() => SaveStandardFloatAsync(register)" novalidate>
                                                <Field Label="@($"Fondo estándar de {register.Name}")" Error="@Err("float")" Hint="Abrir el turno con otro monto pide un supervisor. Déjelo vacío para no fijar uno.">
                                                    <input @ref="_inlineInput" class="esc-input esc-num" style="width:min(160px,100%)" inputmode="numeric" @bind="_floatTo" @bind:after='() => Clear("float")' aria-invalid="@Invalid("float")" />
                                                </Field>
                                                <Button Type="submit" Variant="Button.Variants.Primary" style="margin-top:25px">Guardar</Button>
                                                <Button OnClick="() => _floatFor = null" style="margin-top:25px">Cancelar</Button>
                                            </form>
                                        </td></tr>
                                    }
                                    else if (_renaming == register.Id)
                                    {
                                        <tr><td colspan="4" style="padding-top:8px;padding-bottom:8px;height:auto">
                                            <form class="esc-row" style="align-items:flex-start" @onsubmit="() => RenameRegisterAsync(register)" novalidate>
                                                <Field Label="@($"Nuevo nombre de {register.Name}")" Error="@Err("rename")" Hint="Sale en la factura, en los cierres y en el panel.">
                                                    <input @ref="_inlineInput" class="esc-input" style="width:min(240px,100%)" maxlength="60" @bind="_renameTo" @bind:after='() => Clear("rename")' aria-invalid="@Invalid("rename")" autofocus />
                                                </Field>
                                                <Button Type="submit" Variant="Button.Variants.Primary" style="margin-top:25px">Guardar</Button>
                                                <Button OnClick="() => _renaming = null" style="margin-top:25px">Cancelar</Button>
                                            </form>
                                        </td></tr>
                                    }
                                    else
                                    {
                                        <tr><td><span style="font-weight:600">@register.Name</span><span class="esc-table__sub esc-only-sm esc-muted">@(register.Cashier is { } who ? $"Abierta · {who}" : "Cerrada") · Fondo @(register.StandardFloat is { } f ? Format.WithCurrency(f) : "sin fijar")</span></td>
                                            <td class="esc-hide-sm">@if (register.Cashier is { } q) { <span class="esc-pill esc-pill--success">Abierta · @q</span> } else { <span class="esc-pill esc-pill--neutral">Cerrada</span> }</td>
                                            <td class="esc-hide-sm esc-num" style="white-space:nowrap">@(register.StandardFloat is { } standard ? Format.WithCurrency(standard) : "Sin fijar")</td>
                                            <td><div class="esc-row" style="justify-content:flex-end;flex-wrap:nowrap;white-space:nowrap"><Button class="esc-button esc-button--small" aria-label="@($"Fondo estándar de {register.Name}")" OnClick="() => StartStandardFloat(register)">Fondo</Button>
                                                <Button class="esc-button esc-button--small" aria-label="@($"Cambiar el nombre de {register.Name}")" OnClick="() => StartRename(register)">Renombrar</Button></div></td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <form class="esc-row" style="align-items:flex-start" @onsubmit="CreateRegisterAsync" novalidate>
                        <Field Label="Nueva caja" Error="@Err("register")">
                            <input class="esc-input" style="width:240px" placeholder="Caja 3" maxlength="60" @bind="_newRegister" @bind:after='() => Clear("register")' aria-invalid="@Invalid("register")" />
                        </Field>
                        <Button Type="submit" style="margin-top:25px"><Icon Name="plus" /> Agregar caja</Button>
                    </form>
                </div>
            </section>
            break;

        case Section.FiscalSequences:
            <form class="esc-card esc-setting" @onsubmit="ImportCertificateAsync" novalidate>
                <div class="esc-setting__about"><h2>Certificado digital</h2><p>Con él se firman los comprobantes electrónicos. Escriba la contraseña una sola vez: abre el archivo y no se guarda.</p></div>
                <div class="esc-setting__body">
                    @if (_certificate is { Installed: true } cert)
                    {
                        @if (cert.ExpiresSoon)
                        {
                            <Notice Kind="Notice.Kinds.Warning" Title="@(cert.DaysLeft < 0 ? "El certificado venció" : $"El certificado vence en {cert.DaysLeft} {(cert.DaysLeft == 1 ? "día" : "días")}")">Renuévelo con la entidad certificadora e impórtelo aquí. Sin certificado vigente no se pueden firmar comprobantes.</Notice>
                        }
                        <dl class="esc-dl">
                            <dt>Titular</dt><dd>@cert.Subject</dd>
                            <dt>RNC o cédula</dt><dd>@(cert.TaxId ?? "No aparece en el certificado")</dd>
                            <dt>Emitido por</dt><dd>@cert.Issuer</dd>
                            <dt>Vence</dt><dd>@(cert.NotAfterUtc is { } until ? Format.ShortDate(until) : "")</dd>
                            <dt>En uso</dt><dd>@(cert.InUse ? "Sí: firma los comprobantes" : "Guardado: se usa cuando la tienda pase a la DGII")</dd>
                        </dl>
                    }
                    else
                    {
                        <p class="esc-muted">Todavía no hay certificado. Es el archivo .p12 que entrega la entidad certificadora (Avansi, Digifirma) a nombre del titular.</p>
                    }
                    <div class="esc-form-grid">
                        <Field Label="@(_certificate is { Installed: true } ? "Certificado nuevo (.p12 o .pfx)" : "Archivo (.p12 o .pfx)")" Error="@Err("certFile")">
                            <Microsoft.AspNetCore.Components.Forms.InputFile class="esc-input" accept=".p12,.pfx" OnChange="PickCertificateAsync" />
                        </Field>
                        <Field Label="Contraseña del certificado">
                            <input class="esc-input" type="password" autocomplete="off" maxlength="200" @bind="_certPassword" />
                        </Field>
                    </div>
                    <div class="esc-form-actions"><Button Type="submit" Variant="Button.Variants.Primary" Disabled="_sending">Importar certificado</Button></div>
                </div>
            </form>
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Comprobantes</h2><p>Las secuencias de e-NCF que autorizó la DGII. Le avisamos en el Resumen cuando queden pocos. Los envíos, los rechazos y las anulaciones están en <a href="admin/ecf">Comprobantes electrónicos</a>.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-table-wrap">
                        <table class="esc-table" style="min-width:560px">
                            <thead><tr><th>Tipo</th><th>Rango</th><th>Siguiente</th><th class="esc-num">Quedan</th><th>Vence</th></tr></thead>
                            <tbody>
                                @foreach (var s in _sequences)
                                {
                                    <tr><td style="font-weight:600">@Names.DocumentType(s.Type)@if (!s.Current) { <span class="esc-table__sub esc-muted">@Names.FiscalEnvironment(s.Environment)</span> }</td><td class="esc-muted">@s.From – @s.To</td><td>@s.Next</td>
                                        <td class="esc-num">@if (s.PercentUsed >= 80) { <span class="esc-pill esc-pill--warning">@s.Available</span> } else { @s.Available }</td>
                                        <td>@(s.ExpiresOn?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
                                }
                            </tbody>
                        </table>
                        @if (_sequences.Count == 0)
                        {
                            <EmptyState Icon="receipt" Title="No hay secuencias">Cargue las que autorizó la DGII para poder facturar.</EmptyState>
                        }
                    </div>
                </div>
            </section>
            <form class="esc-card esc-setting" @onsubmit="LoadSequenceAsync" novalidate>
                <div class="esc-setting__about"><h2>Cargar secuencia</h2><p>Copie los números tal como aparecen en la autorización de la DGII.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-form-grid">
                        <Field Label="Tipo">
                            <select class="esc-select" @bind="_seqType">
                                <option value="Consumer32">Consumo (E32)</option>
                                <option value="FiscalCredit31">Crédito fiscal (E31)</option>
                                <option value="CreditNote34">Nota de crédito (E34)</option>
                            </select>
                        </Field>
                        <Field Label="Desde (número)" Error="@Err("from")">
                            <input class="esc-input esc-num" inputmode="numeric" @bind="_seqFrom" @bind:after='() => Clear("from")' aria-invalid="@Invalid("from")" />
                        </Field>
                        <Field Label="Hasta (número)" Error="@Err("to")">
                            <input class="esc-input esc-num" inputmode="numeric" @bind="_seqTo" @bind:after='() => Clear("to")' aria-invalid="@Invalid("to")" />
                        </Field>
                        <Field Label="Vence el">
                            <input class="esc-input" type="date" @bind="_seqExpires" />
                        </Field>
                        <Field Label="Ambiente" Hint="Para cambiar de ambiente, cargue antes las secuencias del nuevo.">
                            <select class="esc-select" @bind="_seqEnvironment">
                                <option value="">El actual</option>
                                <option value="CerteCF">Certificación (CerteCF)</option>
                                <option value="eCF">Producción</option>
                            </select>
                        </Field>
                    </div>
                    <div class="esc-form-actions"><Button Type="submit" Variant="Button.Variants.Primary">Cargar secuencia</Button></div>
                </div>
            </form>
            <TaxpayerRegistryCard />
            break;

        case Section.Devices:
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Equipos</h2><p>Las PCs que pueden entrar a esta tienda. Si se pierde o se cambia una, revóquela.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-table-wrap">
                        <table class="esc-table">
                            <thead><tr><th>Equipo</th><th>Desde</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in _devices)
                                {
                                    <tr><td style="font-weight:600">@d.Name</td><td class="esc-muted">@Format.Date(d.CreatedUtc)</td>
                                        <td><span class="esc-pill @(d.IsRevoked ? "esc-pill--error" : "esc-pill--success")">@(d.IsRevoked ? "Revocado" : "Activo")</span></td>
                                        <td class="esc-num">@if (!d.IsRevoked) { <Button Variant="Button.Variants.Danger" class="esc-button esc-button--danger esc-button--small" OnClick="() => RevokeAsync(d)">@(_revoking == d.Id ? $"¿Revocar {d.Name}? Toque otra vez" : "Revocar")</Button> }</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
            <form class="esc-card esc-setting" @onsubmit="CreatePairingCodeAsync">
                <div class="esc-setting__about"><h2>Unir un equipo nuevo</h2><p>Genere un código y escríbalo en el equipo nuevo, en “Unir a una tienda”. Vale 10 minutos y sirve una vez.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-row" style="align-items:flex-end">
                        <Field Label="Nombre del equipo"><input class="esc-input" style="width:240px" placeholder="Caja 2" maxlength="100" @bind="_newDevice" /></Field>
                        <Button Type="submit" Variant="Button.Variants.Primary">Generar código</Button>
                    </div>
                    @if (_pairingCode is { } pc)
                    {
                        <div class="esc-code" role="status">
                            <span class="esc-code__digits">@pc.Code[..4] @pc.Code[4..]</span>
                            <span class="esc-muted">Vence a las @Format.Time(pc.ExpiresUtc) · sirve una vez</span>
                            @if (Pin.IsPinned && NodeCertificatePin.Fingerprint(Pin.Seen) is { } fingerprint)
                            {
                                <span class="esc-muted">Huella del servidor: <strong>@fingerprint</strong> · el equipo nuevo debe mostrar la misma</span>
                            }
                        </div>
                    }
                </div>
            </form>
            break;

        case Section.Hardware:
            <form class="esc-card esc-setting" @onsubmit="SaveHardwareAsync" novalidate>
                <div class="esc-setting__about"><h2>Equipos de la caja</h2><p>La impresora, la gaveta y la balanza conectadas a esta PC. Se guardan en esta PC; cada caja tiene los suyos.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-form-grid">
                        <Field Label="Impresora" Wide="true" Hint="El nombre como aparece en Windows, o el puerto (COM4) si es serial. Vacío: sin impresora.">
                            <input class="esc-input" maxlength="200" @bind="_hardware.Printer" />
                        </Field>
                        <Field Label="Papel">
                            <select class="esc-select" @bind="_hardware.Width">
                                <option value="80">80 mm (48 letras)</option>
                                <option value="58">58 mm (32 letras)</option>
                            </select>
                        </Field>
                        <Field Label="Velocidad de la impresora" Hint="Solo si está en un puerto COM.">
                            <input class="esc-input esc-num" inputmode="numeric" @bind="_hardware.PrinterBaud" />
                        </Field>
                        <Field Label="Balanza: puerto" Hint="COM3, por ejemplo. Vacío: el peso se escribe.">
                            <input class="esc-input" maxlength="20" @bind="_hardware.ScalePort" />
                        </Field>
                        <Field Label="Balanza: protocolo">
                            <select class="esc-select" @bind="_hardware.Protocol">
                                <option value="@ScaleProtocol.Cas">CAS (PD-II, ER)</option>
                                <option value="@ScaleProtocol.Toledo8217">Toledo 8217</option>
                                <option value="@ScaleProtocol.Continuous">Envío continuo</option>
                            </select>
                        </Field>
                        <Field Label="Velocidad de la balanza">
                            <input class="esc-input esc-num" inputmode="numeric" @bind="_hardware.ScaleBaud" />
                        </Field>
                    </div>
                    <label class="esc-row" style="gap:8px"><input type="checkbox" style="width:22px;height:22px" @bind="_hardware.PrintAfterSale" /> Imprimir la factura al cobrar</label>
                    <label class="esc-row" style="gap:8px"><input type="checkbox" style="width:22px;height:22px" @bind="_hardware.PrintLogo" /> Imprimir el logo del negocio arriba de la factura</label>
                    <div class="esc-form-actions">
                        <Button Disabled="_sending" OnClick="TestPrinterAsync"><Icon Name="printer" /> Imprimir prueba</Button>
                        <Button Disabled="_sending" OnClick="TestScaleAsync">Leer balanza</Button>
                        <Button Type="submit" Variant="Button.Variants.Primary">Guardar</Button>
                    </div>
                </div>
            </form>
            break;

        case Section.Users:
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Usuarios</h2><p>Quién puede entrar y qué puede hacer. Cada persona entra con su código y su PIN.</p>
                    @if (_seats is { Limit: { } limit } seats)
                    {
                        @* TK-277: the license's cashiers, before the owner hits the limit. *@
                        <p><b>Cajeros activos: @seats.Used de @limit</b> que incluye su plan. El dueño no cuenta; desactivar a alguien libera su lugar.</p>
                    }</div>
                <div class="esc-setting__body">
                    <div class="esc-table-wrap">
                        <table class="esc-table">
                            <thead><tr><th>Nombre</th><th>Código</th><th>Rol</th><th>Estado</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var u in _users)
                                {
                                    <tr><td><span class="esc-person"><span class="esc-avatar" aria-hidden="true">@Names.Initials(u.Name)</span><span style="font-weight:600">@u.Name</span></span></td><td class="esc-muted">@u.Code</td><td>@u.Role</td>
                                        <td><span class="esc-pill @(!u.IsActive ? "esc-pill--neutral" : u.IsLocked ? "esc-pill--warning" : "esc-pill--success")">@(!u.IsActive ? "Inactivo" : u.IsLocked ? "Bloqueado" : "Activo")</span></td>
                                        @* TK-277: disabling frees a cashier seat and keeps the person's history; nobody disables themselves. *@
                                        <td class="esc-num">@if (u.Id != Session.UserId)
                                        {
                                            <Button class="esc-button esc-button--small" aria-label="@($"{(u.IsActive ? "Desactivar" : "Activar")} a {u.Name}")" OnClick="() => ToggleUserAsync(u)">@(u.IsActive ? "Desactivar" : "Activar")</Button>
                                        }</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
            <form class="esc-card esc-setting" @onsubmit="CreateUserAsync" novalidate>
                <div class="esc-setting__about"><h2>Nuevo usuario</h2><p>El PIN lo puede cambiar la persona después. Use el rol Cajero para quien solo vende.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-form-grid">
                        <Field Label="Nombre" Error="@Err("userName")"><input class="esc-input" maxlength="100" @bind="_userName" @bind:after='() => Clear("userName")' aria-invalid="@Invalid("userName")" /></Field>
                        <Field Label="Código para entrar" Error="@Err("userCode")" Hint="Corto y fácil: yudelka, caja2…"><input class="esc-input" maxlength="20" @bind="_userCode" @bind:after='() => Clear("userCode")' aria-invalid="@Invalid("userCode")" /></Field>
                        <Field Label="PIN" Error="@Err("userPin")" Hint="De 4 a 8 números."><input class="esc-input" type="password" inputmode="numeric" maxlength="8" autocomplete="new-password" @bind="_userPin" @bind:after='() => Clear("userPin")' aria-invalid="@Invalid("userPin")" /></Field>
                        <Field Label="Rol">
                            <select class="esc-select" @bind="_userRole">
                                @foreach (var r in _roles) { <option value="@r.Id">@r.Name</option> }
                            </select>
                        </Field>
                    </div>
                    <div class="esc-form-actions"><Button Type="submit" Variant="Button.Variants.Primary">Crear usuario</Button></div>
                </div>
            </form>
            break;

        case Section.ScaleLabels:
            <ScaleLabelsSettings />
            break;

        case Section.Roles:
            <RolesSettings />
            break;

        case Section.Health:
            <HealthPanel />
            break;

        case Section.Updates:
            <UpdatesSettings />
            break;

        case Section.Backups:
            <BackupSettingsCard />
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Frase de los respaldos</h2><p>Los respaldos se cifran con esta frase. Guárdela fuera de la PC: sin ella no se pueden restaurar.</p></div>
                <div class="esc-setting__body">
                    <div class="esc-row" style="align-items:flex-start">
                        <Field Label="Frase" Error="@Err("passphrase")" Hint="Al menos 12 caracteres.">
                            <input class="esc-input" style="width:min(360px,100%)" type="password" maxlength="200" autocomplete="new-password" @bind="_passphrase" @bind:after='() => Clear("passphrase")' aria-invalid="@Invalid("passphrase")" />
                        </Field>
                        <Button OnClick="SavePassphraseAsync" style="margin-top:25px">Guardar frase</Button>
                    </div>
                </div>
            </section>
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Respaldos</h2><p>Una copia cifrada de todos los datos de la tienda. “Restaurar” reemplaza los datos de ahora por los de un respaldo.</p>
                    <div style="margin-top:12px"><Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="BackUpAsync">@(_sending ? "Respaldando… puede tardar unos minutos" : "Respaldar ahora")</Button></div></div>
                <div class="esc-setting__body">
                    <div class="esc-table-wrap">
                        <table class="esc-table">
                            <thead><tr><th>Fecha</th><th class="esc-hide-sm">Archivo</th><th class="esc-num">Tamaño</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var b in _backups)
                                {
                                    <tr><td style="font-weight:600">@Format.Date(b.DateUtc)<span class="esc-table__sub esc-only-sm esc-muted">@b.FileName</span></td><td class="esc-hide-sm esc-muted">@b.FileName</td>
                                        <td class="esc-num">@((b.Bytes / 1024d / 1024d).ToString("0.0")) MB</td>
                                        <td class="esc-num"><Button class="esc-button esc-button--small" aria-label="@($"Restaurar {b.FileName}")" OnClick="() => _restoring = b">Restaurar</Button></td></tr>
                                }
                            </tbody>
                        </table>
                        @if (_backups.Count == 0) { <EmptyState Icon="database" Title="Todavía no hay respaldos">Haga el primero con “Respaldar ahora”.</EmptyState> }
                    </div>
                </div>
            </section>
            @if (_restoring is { } restoring)
            {
                <RestoreBackupDialog Backup="restoring" OnClose="() => _restoring = null" />
            }
            break;

        case Section.Cloud:
            @if (_sync is { Connected: true } sync)
            {
                <section class="esc-card esc-setting">
                    <div class="esc-setting__about"><h2>Nube</h2><p>Las ventas y los cierres se suben solos al panel del dueño. Si no hay internet, se guardan y suben al volver.</p></div>
                    <div class="esc-setting__body">
                        <dl class="esc-dl">
                            <dt>Estado</dt><dd><span class="esc-pill esc-pill--success">Conectada</span></dd>
                            <dt>Último envío</dt><dd>@(sync.LastUploadUtc is { } u ? Format.Date(u) : "todavía ninguno")</dd>
                            <dt>Pendientes por subir</dt><dd>@sync.PendingEvents</dd>
                        </dl>
                        @if (sync.LastError is { } err)
                        {
                            <Notice Kind="Notice.Kinds.Warning" Title="El último envío falló; se reintenta solo.">@err</Notice>
                        }
                        <div><Button Variant="Button.Variants.Danger" OnClick="DisconnectCloudAsync">@(_disconnecting ? "¿Desconectar? Toque otra vez" : "Desconectar de la nube")</Button></div>
                    </div>
                </section>
            }
            else
            {
                <form class="esc-card esc-setting" @onsubmit="ConnectCloudAsync">
                    <div class="esc-setting__about"><h2>Conectar a la nube</h2><p>En el panel de Abastalia (desde su celular o computadora): Tiendas → Conectar una caja. Escriba aquí el código de 8 números; vale 30 minutos.</p></div>
                    <div class="esc-setting__body">
                        <div class="esc-row" style="align-items:flex-end">
                            <Field Label="Código de conexión">
                                <input class="esc-input esc-input--large" style="width:240px;letter-spacing:0.3em" inputmode="numeric" maxlength="8" autocomplete="off" aria-label="Código de conexión" @bind="_cloudCode" @bind:event="oninput" />
                            </Field>
                            <Button Type="submit" Variant="Button.Variants.Primary" Disabled="@(_cloudCode?.Length != 8 || _sending)">Conectar</Button>
                        </div>
                    </div>
                </form>
            }
            break;

        case Section.License when _features is { } f:
            <section class="esc-card esc-setting">
                <div class="esc-setting__about"><h2>Licencia</h2><p>Su plan y lo que incluye.</p></div>
                <div class="esc-setting__body">
                    <dl class="esc-dl">
                        <dt>Estado</dt><dd><span class="esc-pill @(f.Status == "Active" ? "esc-pill--success" : "esc-pill--warning")">@Names.LicenseStatus(f.Status)</span></dd>
                        <dt>Plan</dt><dd>@(f.Plan ?? "Prueba")@(f.ExpiresUtc is { } v ? $" · vence el {Format.ShortDate(v)}" : "")</dd>
                        <dt>Cajas permitidas</dt><dd>@f.Registers</dd>
                        <dt>Funciones</dt><dd>@(f.Enabled.Length == 0 ? "Las básicas" : string.Join(", ", f.Enabled.Select(Names.Feature)))</dd>
                    </dl>
                    @if (Names.LicenseNote(f) is { } note)
                    {
                        <Notice Kind="@(f.Warning is null ? Notice.Kinds.Info : Notice.Kinds.Warning)" Title="@note">
                            @(f.Status == "Restricted"
                                ? "La venta, el e-CF, los reportes y los respaldos siguen en la PC principal y una caja. Ningún dato se pierde."
                                : "Durante la prueba todo funciona. Al terminar, Abastalia sigue vendiendo en modo Restringido: nunca se bloquea ni se pierden datos.")
                        </Notice>
                    }
                </div>
            </section>
            @if (Session.Can("settings.manage"))
            {
                @* TK-220: buying is getting the signed license from Abastalia staff (file or text) and installing it here: no reinstall, no data lost.
                   shortcut: no payment in the app; the owner pays Abastalia by WhatsApp or transfer. *@
                <form class="esc-card esc-setting" @onsubmit="InstallLicenseAsync">
                    <div class="esc-setting__about"><h2>@(f.Status is "Active" ? "Renovar o ampliar" : "Comprar licencia")</h2>
                        <p>Escríbale a Abastalia con el nombre y el RNC de su tienda. Le envían un archivo de licencia o un código: cárguelo aquí y queda activa al momento, con todas sus ventas.</p></div>
                    <div class="esc-setting__body">
                        <Field Label="Archivo de licencia (.jws)">
                            <Microsoft.AspNetCore.Components.Forms.InputFile class="esc-input" accept=".jws,.txt" OnChange="PickLicenseAsync" />
                        </Field>
                        <Field Label="O pegue el código de licencia" Error="@Err("license")">
                            <textarea class="esc-input" rows="3" aria-label="Código de licencia" aria-invalid="@Invalid("license")" @bind="_licenseText" @bind:event="oninput" @onfocus="@(() => Clear("license"))"></textarea>
                        </Field>
                        <div><Button Type="submit" Variant="Button.Variants.Primary" Disabled="@(string.IsNullOrWhiteSpace(_licenseText) || _sending)">Activar licencia</Button></div>
                    </div>
                </form>
            }
            @if (Session.Can("products.manage"))
            {
                <section class="esc-card esc-setting">
                    <div class="esc-setting__about"><h2>Datos de ejemplo</h2>
                        <p>Productos de muestra para probar la caja. Nunca entran en los reportes 606, 607 ni 608; los que llegue a vender quedan desactivados al quitarlos.</p></div>
                    <div class="esc-setting__body">
                        <p>@(_sample is { Products: > 0 } s ? $"Hay {s.Products} productos de ejemplo." : "No hay productos de ejemplo.")</p>
                        <div class="esc-row">
                            @if (_sample is { Products: > 0 })
                            {
                                <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="RemoveSampleDataAsync">Quitar datos de ejemplo</Button>
                            }
                            else
                            {
                                <Button Disabled="_sending" OnClick="LoadSampleDataAsync">Cargar datos de ejemplo</Button>
                            }
                        </div>
                    </div>
                </section>
            }
            break;
    }
    </div>
</Admin>

@code {
    private enum Section { None, Business, Registers, FiscalSequences, Devices, Hardware, ScaleLabels, Users, Roles, Backups, Cloud, License, Health, Updates }
    private sealed record SyncStatus(bool Connected, Guid? TenantId, Guid? StoreId, string? CloudUrl, DateTime? LastUploadUtc, int PendingEvents, string? LastError);
    private sealed class BusinessForm { public string Name = ""; public string? Rnc, Address, Phone, ReceiptFooter, DiscountCap; public bool RequireReference = true; }

    /// <summary>Opens a section from a link (the Resumen's "Cargar secuencia" → ?section=fiscal).</summary>
    [SupplyParameterFromQuery(Name = "section")] public string? Requested { get; set; }

    private static string Label(Section s) => s switch
    {
        Section.Business => "Negocio",
        Section.Registers => "Cajas",
        Section.FiscalSequences => "Comprobantes",
        Section.Devices => "Equipos",
        Section.Hardware => "Equipos de la caja",
        Section.ScaleLabels => "Balanza y etiquetas",
        Section.Users => "Usuarios",
        Section.Roles => "Roles y permisos",
        Section.Backups => "Respaldos",
        Section.Cloud => "Nube",
        Section.Health => "Salud",
        Section.Updates => "Actualizaciones",
        _ => "Licencia",
    };

    private Section[] Sections => [.. new Section?[]
    {
        Session.Can("settings.manage") ? Section.Business : null, Session.Can("registers.manage") ? Section.Registers : null,
        Session.Can("fiscal.manage") ? Section.FiscalSequences : null, Session.Can("devices.manage") ? Section.Devices : null, Session.Can("settings.manage") ? Section.Hardware : null,
        Session.Can("settings.manage") ? Section.ScaleLabels : null,
        Session.Can("users.manage") ? Section.Users : null, Session.Can("users.manage") ? Section.Roles : null,
        Session.Can("backups.manage") ? Section.Backups : null, Session.Can("settings.manage") ? Section.Cloud : null, Section.License, Session.Can("settings.manage") ? Section.Health : null,
        Session.Can("settings.manage") ? Section.Updates : null,
    }.OfType<Section>()];

    /// <summary>Configuración shows in the menu when any of its sections does (License alone is only informative).</summary>
    public static bool Allowed(Session s) =>
        new[] { "settings.manage", "registers.manage", "backups.manage", "fiscal.manage", "devices.manage", "users.manage" }.Any(s.Can);

    private Section _section;
    private string? _message;
    private Notice.Kinds _messageKind;
    private bool _sending;
    private BusinessForm? _business;
    private List<RegisterInfo> _registers = [];
    private List<ApprovalRule> _approvals = [];
    private string? _newRegister, _newDevice, _passphrase, _userName, _userCode, _userPin, _seqFrom, _seqTo;
    private string _seqType = "Consumer32";
    private DateOnly _seqExpires = Format.Today.AddYears(1);
    private List<EcfSequence> _sequences = [];
    private EcfCertificateStatus? _certificate;
    private byte[]? _certFile;
    private string? _certPassword;
    private List<Device> _devices = [];
    private PairingCode? _pairingCode;
    private Guid? _revoking;
    private List<User> _users = [];
    private CashierSeats? _seats;
    private List<Role> _roles = [];
    private Guid _userRole;
    private List<BackupFile> _backups = [];
    private BackupFile? _restoring;
    private LicenseFeatures? _features;
    private string? _licenseText;
    private SampleDataStatus? _sample;
    private SyncStatus? _sync;
    private string? _cloudCode;
    private readonly Dictionary<string, string> _errors = [];

    private string? Err(string field) => _errors.GetValueOrDefault(field);
    private string Invalid(string field) => _errors.ContainsKey(field) ? "true" : "false";
    private void Clear(string field) => _errors.Remove(field);

    protected override Task OnInitializedAsync() => GoAsync(Requested switch
    {
        "registers" when Sections.Contains(Section.Registers) => Section.Registers, // TK-281: "Crear una caja" from Abrir caja on the first day
        "fiscal" when Sections.Contains(Section.FiscalSequences) => Section.FiscalSequences,
        "health" when Sections.Contains(Section.Health) => Section.Health,
        "updates" when Sections.Contains(Section.Updates) => Section.Updates,
        "backups" when Sections.Contains(Section.Backups) => Section.Backups,
        "business" when Sections.Contains(Section.Business) => Section.Business,
        "users" when Sections.Contains(Section.Users) => Section.Users, // TK-277: the Resumen's shared-PIN warning
        "license" => Section.License, // the Resumen's "Comprar licencia" and "Quitar ejemplos" (TK-196/220)
        "cloud" when Sections.Contains(Section.Cloud) => Section.Cloud, // TK-233: "Solicitar acompañamiento" needs the cloud
        _ => Sections[0],
    });

    private async Task GoAsync(Section section)
    {
        (_section, _message, _pairingCode) = (section, null, null);
        _errors.Clear();
        switch (section)
        {
            case Section.Business:
                var b = (await Api.GetAsync<BusinessProfile>("/api/settings/business")).Value;
                _business = b is null ? new() : new() { Name = b.Name, Rnc = b.Rnc, Address = b.Address, Phone = b.Phone, ReceiptFooter = b.ReceiptFooter, DiscountCap = b.DiscountCapPercent.ToString("0.##"), RequireReference = b.RequirePaymentReference };
                _approvals = (await Api.GetAsync<List<ApprovalRule>>("/api/settings/approvals")).Value ?? [];
                (_logoUrl, _logoRaster) = (await Logo.DataUrlAsync(b?.LogoVersion), await Logo.RasterAsync(b?.LogoVersion, 80));
                break;
            case Section.Registers:
                _registers = (await Api.GetAsync<List<RegisterInfo>>("/api/cash/registers")).Value ?? [];
                _features ??= (await Api.GetAsync<LicenseFeatures>("/api/settings/features")).Value;
                break;
            case Section.FiscalSequences:
                _sequences = (await Api.GetAsync<List<EcfSequence>>("/api/fiscal/sequences")).Value ?? [];
                _certificate = (await Api.GetAsync<EcfCertificateStatus>("/api/fiscal/certificate")).Value;
                break;
            case Section.Devices: _devices = (await Api.GetAsync<List<Device>>("/api/identity/devices")).Value ?? []; break;
            case Section.Hardware: _hardware = HardwareForm.From(Peripherals.Settings); break;
            case Section.Users:
                _users = (await Api.GetAsync<List<User>>("/api/identity/users")).Value ?? [];
                _seats = (await Api.GetAsync<CashierSeats>("/api/identity/cashier-seats")).Value;
                _roles =[.. (await Api.GetAsync<RoleList>("/api/identity/roles")).Value?.Roles ?? []];
                _userRole = _roles.Find(r => r.Name == "Cajero")?.Id ?? _roles.FirstOrDefault()?.Id ?? Guid.Empty;
                break;
            case Section.Backups: _backups = (await Api.GetAsync<List<BackupFile>>("/api/backups")).Value ?? []; break;
            case Section.License:
                _features = (await Api.GetAsync<LicenseFeatures>("/api/settings/features")).Value;
                _sample = Session.Can("products.manage") ? (await Api.GetAsync<SampleDataStatus>("/api/inventory/sample-data")).Value : null;
                break;
            case Section.Cloud: _sync = (await Api.GetAsync<SyncStatus>("/api/sync/status")).Value; break;
        }
    }

    private bool _disconnecting;

    private sealed class HardwareForm
    {
        public string? Printer, ScalePort;
        public int Width = 80, PrinterBaud = 9600, ScaleBaud = 9600;
        public ScaleProtocol Protocol = ScaleProtocol.Cas;
        public bool PrintAfterSale = true, PrintLogo = true;

        public static HardwareForm From(HardwareSettings s) => new()
        {
            Printer = s.Printer?.Port, Width = s.Printer?.Width ?? 80, PrinterBaud = s.Printer?.BaudRate ?? 9600, PrintAfterSale = s.PrintAfterSale, PrintLogo = s.PrintLogo,
            ScalePort = s.Scale?.Port, Protocol = s.Scale?.Protocol ?? ScaleProtocol.Cas, ScaleBaud = s.Scale?.BaudRate ?? 9600,
        };

        public HardwareSettings ToSettings() => new(
            string.IsNullOrWhiteSpace(Printer) ? null : new PrinterSettings(Printer.Trim(), Width == 58 ? 58 : 80, PrinterBaud > 0 ? PrinterBaud : 9600),
            string.IsNullOrWhiteSpace(ScalePort) ? null : new ScaleSettings(ScalePort.Trim().ToUpperInvariant(), Protocol, ScaleBaud > 0 ? ScaleBaud : 9600),
            PrintAfterSale, PrintLogo);
    }

    private HardwareForm _hardware = new();

    private async Task SaveHardwareAsync()
    {
        await Peripherals.SaveAsync(_hardware.ToSettings());
        ShowResult(null, "Equipos guardados en esta PC.");
    }

    /// <summary>The tests use what is on screen: they save it first.</summary>
    private async Task TestPrinterAsync()
    {
        await Peripherals.SaveAsync(_hardware.ToSettings());
        if (Peripherals.Printer is null) { (_messageKind, _message) = (Notice.Kinds.Warning, "Escriba primero el nombre o el puerto de la impresora."); return; }
        _sending = true;
        // TK-280: with the business logo, if there is one, so the test shows how it prints.
        var version = (await Api.GetAsync<BusinessProfile>("/api/settings/business")).Value?.LogoVersion;
        var test = await Logo.ForPrinterAsync(TestReceipt with { LogoVersion = version }, Peripherals.Settings);
        var ok = await Peripherals.TryAsync(p => p.PrintAsync(test, true, CancellationToken.None));
        _sending = false;
        (_messageKind, _message) = ok
            ? (Notice.Kinds.Success, "Prueba enviada: debe salir una factura de prueba con ñ y acentos, el código QR, el corte, y abrirse la gaveta.")
            : (Notice.Kinds.Error, "La impresora no respondió. Revise el nombre o el puerto, el cable y que esté encendida.");
    }

    private async Task TestScaleAsync()
    {
        await Peripherals.SaveAsync(_hardware.ToSettings());
        if (Peripherals.Scale is not { } scale) { (_messageKind, _message) = (Notice.Kinds.Warning, "Escriba primero el puerto de la balanza."); return; }
        _sending = true;
        var r = await scale.ReadAsync(CancellationToken.None);
        _sending = false;
        var pounds = r.Pounds.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);
        (_messageKind, _message) = r.Status switch
        {
            ScaleStatus.Stable => (Notice.Kinds.Success, $"La balanza marca {pounds} lb, estable."),
            ScaleStatus.Unstable => (Notice.Kinds.Info, $"La balanza responde ({pounds} lb) pero el peso todavía se mueve."),
            ScaleStatus.Overload => (Notice.Kinds.Warning, "La balanza responde: está sobrecargada."),
            _ => (Notice.Kinds.Error, "La balanza no responde. Revise el puerto, el protocolo, la velocidad y el cable."),
        };
    }

    private static readonly Receipt TestReceipt = new("Prueba de impresión · Abastalia", "000000000", "Calle Duarte, Santo Domingo", null,
        "Factura de Consumo Electrónica", "E320000000000", 0, DateTime.Now, "Caja", "Técnico", null, null,
        [new("Chuleta ahumada (ñ á é í ó ú ü ¿¡)", 1.25m, "Pound", 185m, 0m, 231.25m, null)], 195.97m, 0m, [new("ITBIS 18%", 195.97m, 35.28m)],
        231.25m, [new("Efectivo", 231.25m, 300m)], 68m, "PRUEBA", "https://dgii.gov.do", "Si lee bien esta línea, la impresora está lista.", false);

    private async Task ConnectCloudAsync()
    {
        _sending = true;
        var r = await Api.PostAsync<Empty>("/api/sync/connect", new { Code = _cloudCode });
        _sending = false;
        _cloudCode = null;
        await GoAsync(Section.Cloud);
        ShowResult(r.Problem, "Tienda conectada. Las ventas empiezan a subir a la nube.");
    }

    private async Task DisconnectCloudAsync()
    {
        // Same inline double-tap confirmation as revoking a device.
        if (!_disconnecting) { _disconnecting = true; return; }
        _disconnecting = false;
        var r = await Api.PostAsync<Empty>("/api/sync/disconnect");
        await GoAsync(Section.Cloud);
        ShowResult(r.Problem, "La tienda ya no sube datos a la nube.");
    }

    private async Task PickLicenseAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        Clear("license");
        try
        {
            await using var stream = e.File.OpenReadStream(10_000);
            using var reader = new StreamReader(stream);
            _licenseText = (await reader.ReadToEndAsync()).Trim();
        }
        catch (IOException)
        {
            (_licenseText, _errors["license"]) = (null, "Ese archivo es demasiado grande para ser una licencia.");
        }
    }

    private async Task InstallLicenseAsync()
    {
        _sending = true;
        var r = await Api.PutAsync<Empty>("/api/settings/license", new { License = _licenseText?.Trim() });
        _sending = false;
        if (r.Problem is { Code: "License.Invalid" } p) { _errors["license"] = p.Message; return; }
        if (r.Problem is null) _licenseText = null;
        await GoAsync(Section.License);
        ShowResult(r.Problem, "Licencia activada. Todo sigue igual, con sus datos; las cajas que esperaban ya pueden entrar.");
    }

    private async Task LoadSampleDataAsync()
    {
        _sending = true;
        var r = await Api.PostAsync<SampleDataStatus>("/api/inventory/sample-data");
        _sending = false;
        await GoAsync(Section.License);
        ShowResult(r.Problem, "Productos de ejemplo cargados. Búsquelos en la caja: dicen \"(ejemplo)\".");
    }

    private async Task RemoveSampleDataAsync()
    {
        _sending = true;
        var r = await Api.DeleteAsync<SampleDataStatus>("/api/inventory/sample-data");
        _sending = false;
        await GoAsync(Section.License);
        ShowResult(r.Problem, "Datos de ejemplo quitados.");
    }

    // TK-277: the plan's cashier limit is a limit to act on, not a failure.
    private string? _logoUrl;
    private ReceiptLogo? _logoRaster;

    /// <summary>TK-280: saved as soon as it is picked; the server checks the type by its bytes and writes it again as a PNG.</summary>
    private async Task UploadLogoAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        Clear("logo");
        byte[] file;
        try
        {
            await using var stream = e.File.OpenReadStream(512 * 1024);
            using var copy = new MemoryStream();
            await stream.CopyToAsync(copy);
            file = copy.ToArray();
        }
        catch (IOException)
        {
            _errors["logo"] = "La imagen pasa de 512 KB. Use una más liviana.";
            return;
        }
        _sending = true;
        var r = await Api.PutAsync<Empty>("/api/settings/business/logo", new { File = Convert.ToBase64String(file) });
        _sending = false;
        if (r.Problem is { Status: 400 } p) { _errors["logo"] = p.Message; return; }
        await GoAsync(Section.Business);
        ShowResult(r.Problem, "Logo guardado. Sale en las facturas desde ahora.");
    }

    private bool _removingLogo;

    /// <summary>Same inline double-tap confirmation as disconnecting from the cloud: the owner may not have the original file at hand.</summary>
    private async Task RemoveLogoAsync()
    {
        if (!_removingLogo) { _removingLogo = true; return; }
        (_removingLogo, _sending) = (false, true);
        var r = await Api.DeleteAsync<Empty>("/api/settings/business/logo");
        _sending = false;
        await GoAsync(Section.Business);
        ShowResult(r.Problem, "Logo quitado. La factura sale con el nombre del negocio arriba.");
    }

    private void ShowResult(Problem? p, string success) => (_messageKind, _message) = p is null ? (Notice.Kinds.Success, success)
        : (p.Code == "Identity.CashierLimitReached" ? Notice.Kinds.Warning : p.Kind, p.Message);

    private async Task SaveBusinessAsync()
    {
        var f = _business!;
        string? Clean(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
        _errors.Clear();
        if (string.IsNullOrWhiteSpace(f.Name)) _errors["name"] = "Escriba el nombre del negocio.";
        if (Clean(f.Rnc) is { } rnc && (rnc.Length is not (9 or 11) || !rnc.All(char.IsAsciiDigit))) _errors["rnc"] = "El RNC tiene 9 números (o 11 si es una cédula).";
        if (Format.ParseNumber(f.DiscountCap ?? "0") is not (>= 0 and <= 100)) _errors["discount"] = "Escriba un porcentaje de 0 a 100.";
        if (_errors.Count > 0) return;
        var r = await Api.PutAsync<Empty>("/api/settings/business", new BusinessProfile(f.Name.Trim(), Clean(f.Rnc), Clean(f.Address), Clean(f.Phone), Clean(f.ReceiptFooter), Format.ParseNumber(f.DiscountCap) ?? 0, f.RequireReference));
        ShowResult(r.Problem, "Datos del negocio guardados.");
    }

    private async Task SaveApprovalsAsync()
    {
        _sending = true;
        var r = await Api.PutAsync<Empty>("/api/settings/approvals", new ApprovalPolicy([.. _approvals.Where(a => a.Required).Select(a => a.Permission)]));
        _sending = false;
        ShowResult(r.Problem, "Autorizaciones guardadas. Aplican de inmediato en todas las cajas.");
    }

    private async Task CreateRegisterAsync()
    {
        if (string.IsNullOrWhiteSpace(_newRegister)) { _errors["register"] = "Escriba el nombre de la caja."; return; }
        var r = await Api.PostAsync<Created>("/api/cash/registers", new { Name = _newRegister.Trim() });
        await GoAsync(Section.Registers);
        ShowResult(r.Problem, $"{_newRegister} creada.");
        _newRegister = null;
    }

    private Guid? _renaming;
    private ElementReference _inlineInput;
    private bool _focusInline;
    private string? _renameTo;

    /// <summary>The inline rename and float forms open with the cursor in their field (HTML autofocus only works on page load).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusInline || _renaming is null && _floatFor is null) return;
        _focusInline = false;
        await _inlineInput.FocusAsync();
    }

    private void StartRename(RegisterInfo r)
    {
        Clear("rename");
        (_renaming, _renameTo, _message, _focusInline, _floatFor) = (r.Id, r.Name, null, true, null);
    }

    private Guid? _floatFor;
    private string? _floatTo;

    /// <summary>R11 A7 (TK-268): the float the register usually opens with; another one asks a supervisor.</summary>
    private void StartStandardFloat(RegisterInfo r)
    {
        Clear("float");
        (_floatFor, _floatTo, _message, _renaming, _focusInline) = (r.Id, r.StandardFloat?.ToString("0", System.Globalization.CultureInfo.InvariantCulture), null, null, true);
    }

    private async Task SaveStandardFloatAsync(RegisterInfo register)
    {
        decimal? amount = string.IsNullOrWhiteSpace(_floatTo) ? null : Format.ParseNumber(_floatTo);
        if (amount is null && !string.IsNullOrWhiteSpace(_floatTo) || amount is { } v && (v < 0 || v != Math.Truncate(v)))
        {
            _errors["float"] = "Escriba el monto en pesos enteros.";
            return;
        }
        var r = await Api.PutAsync<Empty>($"/api/cash/registers/{register.Id}/standard-float", new { Amount = amount });
        if (r.Ok) _floatFor = null;
        await GoAsync(Section.Registers);
        ShowResult(r.Problem, amount is { } set ? $"{register.Name} abre con {Format.WithCurrency(set)}." : $"{register.Name} ya no tiene fondo estándar.");
    }

    private async Task RenameRegisterAsync(RegisterInfo register)
    {
        if (string.IsNullOrWhiteSpace(_renameTo)) { _errors["rename"] = "Escriba el nombre de la caja."; return; }
        var name = _renameTo.Trim();
        var r = await Api.PutAsync<Empty>($"/api/cash/registers/{register.Id}", new { Name = name });
        if (r.Ok) _renaming = null;
        await GoAsync(Section.Registers);
        ShowResult(r.Problem, $"{register.Name} ahora se llama {name}.");
    }

    private string? _registryName, _seqEnvironment;

    /// <summary>TK-238: the name the DGII registry (if loaded) has for the RNC typed, so a wrong digit shows before saving.</summary>
    private async Task RncChangedAsync()
    {
        Clear("rnc");
        _registryName = _business?.Rnc is { Length: 9 or 11 } rnc ? (await Api.GetAsync<TaxpayerName>($"/api/fiscal/taxpayers/{rnc}")).Value?.Name : null;
    }

    private sealed record TaxpayerName(string Rnc, string Name);

    private async Task LoadSequenceAsync()
    {
        _errors.Clear();
        if (!long.TryParse(_seqFrom, out var from) || from <= 0) _errors["from"] = "Escriba el primer número de la secuencia.";
        if (!long.TryParse(_seqTo, out var to) || to <= 0) _errors["to"] = "Escriba el último número de la secuencia.";
        else if (from > 0 && to < from) _errors["to"] = "Debe ser mayor o igual que “Desde”.";
        if (_errors.Count > 0) return;
        var r = await Api.PostAsync<Created>("/api/fiscal/sequences", new { Type = _seqType, From = from, To = to, ExpiresOn = _seqExpires, Environment = _seqEnvironment is { Length: > 0 } env ? env : null });
        await GoAsync(Section.FiscalSequences);
        ShowResult(r.Problem?.Code == "Fiscal.OverlappingRange" ? r.Problem with { Message = "Ese rango se cruza con uno ya cargado." } : r.Problem, "Secuencia cargada.");
    }

    /// <summary>A .p12 is a few KB; 200 KB is plenty.</summary>
    private async Task PickCertificateAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        Clear("certFile");
        using var file = new MemoryStream();
        try
        {
            await using var stream = e.File.OpenReadStream(200_000);
            await stream.CopyToAsync(file);
            _certFile = file.ToArray();
        }
        catch (IOException)
        {
            (_certFile, _errors["certFile"]) = (null, "Ese archivo es demasiado grande para ser un certificado.");
        }
    }

    /// <summary>TK-176: the password goes with the file once and is forgotten here whatever the answer.</summary>
    private async Task ImportCertificateAsync()
    {
        if (_certFile is null) { _errors["certFile"] = "Elija el archivo .p12 o .pfx del certificado."; return; }
        _sending = true;
        var r = await Api.PostAsync<EcfCertificateStatus>("/api/fiscal/certificate", new { File = Convert.ToBase64String(_certFile), Password = _certPassword });
        (_sending, _certPassword) = (false, null);
        if (r.Ok) _certFile = null;
        await GoAsync(Section.FiscalSequences);
        ShowResult(r.Problem, $"Certificado de {r.Value?.Subject} importado. Vence el {(r.Value?.NotAfterUtc is { } until ? Format.ShortDate(until) : "")}.");
    }

    private async Task CreatePairingCodeAsync()
    {
        var r = await Api.PostAsync<PairingCode>("/api/identity/devices/pairing-codes", new { DeviceName = string.IsNullOrWhiteSpace(_newDevice) ? "Caja" : _newDevice.Trim() });
        _pairingCode = r.Value;
        if (!r.Ok) ShowResult(r.Problem, "");
    }

    /// <summary>Revoking cannot be undone (the PC must be paired again): the first tap asks, the second revokes.</summary>
    private async Task RevokeAsync(Device d)
    {
        if (_revoking != d.Id)
        {
            _revoking = d.Id;
            return;
        }
        _revoking = null;
        var r = await Api.PostAsync<Empty>($"/api/identity/devices/{d.Id}/revoke");
        await GoAsync(Section.Devices);
        ShowResult(r.Problem?.Code == "Identity.CannotRevokeOwnDevice" ? r.Problem with { Message = "No puede revocar el equipo que está usando." } : r.Problem, $"{d.Name} ya no puede entrar.");
    }

    private async Task ToggleUserAsync(User u)
    {
        var r = await Api.PutAsync<Empty>($"/api/identity/users/{u.Id}", new { u.Name, u.RoleId, IsActive = !u.IsActive, Pin = (string?)null });
        await GoAsync(Section.Users);
        ShowResult(r.Problem, u.IsActive ? $"{u.Name} ya no puede entrar. Sus ventas y turnos se guardan." : $"{u.Name} puede entrar otra vez con su código y PIN.");
    }

    private async Task CreateUserAsync()
    {
        _errors.Clear();
        if (string.IsNullOrWhiteSpace(_userName)) _errors["userName"] = "Escriba el nombre.";
        if (string.IsNullOrWhiteSpace(_userCode)) _errors["userCode"] = "Escriba un código para entrar.";
        if (_userPin is not { Length: >= 4 and <= 8 } pin || !pin.All(char.IsAsciiDigit)) _errors["userPin"] = "El PIN lleva de 4 a 8 números.";
        if (_errors.Count > 0) return;
        var r = await Api.PostAsync<Created>("/api/identity/users", new { Name = _userName!.Trim(), Code = _userCode!.Trim(), Pin = _userPin, RoleId = _userRole });
        var name = _userName;
        if (r.Ok) (_userName, _userCode, _userPin) = (null, null, null);
        await GoAsync(Section.Users);
        if (r.Problem?.Code == "Identity.DuplicateCode") { _errors["userCode"] = "Ese código ya lo usa otra persona."; return; }
        ShowResult(r.Problem, $"{name} puede entrar con su código y PIN.");
    }

    private async Task SavePassphraseAsync()
    {
        if (_passphrase is not { Length: >= 12 }) { _errors["passphrase"] = "La frase necesita al menos 12 caracteres."; return; }
        var r = await Api.PutAsync<Empty>("/api/backups/passphrase", new { Passphrase = _passphrase });
        _passphrase = null;
        ShowResult(r.Problem, "Frase guardada. Anótela en un lugar seguro.");
    }

    private async Task BackUpAsync()
    {
        _sending = true;
        // A backup of several GB takes minutes; the server allows it up to an hour (R6 #3).
        var r = await Api.PostAsync<BackupFile>("/api/backups", timeout: TimeSpan.FromHours(1));
        _sending = false;
        await GoAsync(Section.Backups);
        ShowResult(r.Problem?.Code == "Backup.NoPassphrase" ? r.Problem with { Message = "Primero guarde la frase de los respaldos." } : r.Problem, "Respaldo creado.");
    }
}
