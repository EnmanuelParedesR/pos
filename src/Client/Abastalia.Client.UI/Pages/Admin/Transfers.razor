@page "/admin/inventory/transfers"
@inject AbastaliaApi Api
@inject Session Session

<Admin Title="Transferencias" Subtitle="Pasar mercancía de un almacén a otro, por ejemplo del cuarto frío a la tienda.">
    <Actions>
        @if (Session.Can("products.manage"))
        {
            <Button OnClick="() => (_newWarehouse, _warehouseName, _warehouseError) = (true, null, null)"><Icon Name="plus" /> Nuevo almacén</Button>
        }
    </Actions>
    <ChildContent>
        <SectionTabs Label="Inventario" Tabs="SectionTabs.Inventory(Session)" />
        @if (_done is not null)
        {
            <Notice Kind="Notice.Kinds.Success" Title="@_done" />
        }

        @if (_warehouses is null)
        {
            <div class="esc-card" style="padding:20px"><Skeleton Width="240px" /></div>
        }
        else if (_warehouses.Count(w => w.IsActive) < 2)
        {
            <div class="esc-card">
                <EmptyState Icon="package" Title="Solo hay un almacén">
                    @(Session.Can("products.manage") ? "Cree otro (por ejemplo “Cuarto frío”) con “Nuevo almacén” para poder pasar mercancía." : "Pida al dueño que cree otro almacén para poder pasar mercancía.")
                </EmptyState>
            </div>
        }
        else
        {
            <div class="esc-card" style="padding:20px;display:flex;flex-direction:column;gap:16px">
                <div class="esc-form-grid">
                    <Field Label="Sale de">
                        <select class="esc-select" @bind="_source" @bind:after="() => _error = null">
                            @foreach (var w in _warehouses.Where(w => w.IsActive)) { <option value="@w.Id">@w.Name</option> }
                        </select>
                    </Field>
                    <Field Label="Entra a" Error="@(_source == _destination ? "Elija otro almacén." : null)">
                        <select class="esc-select" @bind="_destination" @bind:after="() => _error = null" aria-invalid="@(_source == _destination ? "true" : "false")">
                            @foreach (var w in _warehouses.Where(w => w.IsActive)) { <option value="@w.Id">@w.Name</option> }
                        </select>
                    </Field>
                </div>
                <ProductPicker OnPick="Add" />
                <div class="esc-table-wrap">
                    <table class="esc-table">
                        <thead><tr><th>Producto</th><th class="esc-num">Cantidad</th><th class="esc-table__chev"><span class="esc-visually-hidden">Quitar</span></th></tr></thead>
                        <tbody>
                            @foreach (var l in _lines)
                            {
                                <tr>
                                    <td style="font-weight:600">@l.Product.Name
                                        @if (l.Error is not null) { <span class="esc-field__error" role="alert"><Icon Name="alert" Size="14" />@l.Error</span> }
                                    </td>
                                    <td class="esc-num"><input class="esc-input cell-input" inputmode="decimal" aria-label="@($"Cantidad de {l.Product.Name}")" @bind="l.Quantity" @bind:after="() => l.Error = null"
                                                               aria-invalid="@(l.Error is null ? "false" : "true")" /> @(l.Product.Unit == "Pound" ? "lb" : "")</td>
                                    <td class="esc-table__chev"><button type="button" class="esc-button esc-button--ghost esc-button--small" aria-label="@($"Quitar {l.Product.Name}")" @onclick="() => _lines.Remove(l)"><Icon Name="x" Size="16" /></button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (_lines.Count == 0)
                    {
                        <EmptyState Icon="package" Title="Agregue lo que va a pasar">Búsquelo arriba por nombre, PLU o código de barras.</EmptyState>
                    }
                </div>
                @if (_error is not null) { <Notice Title="@_error" /> }
                <div class="esc-form-actions">
                    <Button Variant="Button.Variants.Primary" OnClick="TransferAsync" Disabled="@(_sending || _lines.Count == 0 || _source == _destination)">@(_sending ? "Pasando…" : "Transferir")</Button>
                </div>
            </div>
        }

        @if (_newWarehouse)
        {
            <Dialog Title="Nuevo almacén" Subtitle="Otro lugar donde se guarda mercancía: cuarto frío, depósito, otra tienda." OnClose="() => _newWarehouse = false">
                <ChildContent>
                    <Field Label="Nombre" Error="@_warehouseError">
                        <input class="esc-input" maxlength="60" @bind="_warehouseName" @bind:after="() => _warehouseError = null" aria-invalid="@(_warehouseError is null ? "false" : "true")" autofocus />
                    </Field>
                </ChildContent>
                <Footer>
                    <Button OnClick="() => _newWarehouse = false" Shortcut="Esc">Cancelar</Button>
                    <Button Variant="Button.Variants.Primary" OnClick="CreateWarehouseAsync">Crear almacén</Button>
                </Footer>
            </Dialog>
        }
    </ChildContent>
</Admin>

@code {
    private sealed class Line(ProductSummary product)
    {
        public ProductSummary Product { get; } = product;
        public string? Quantity { get; set; }
        public string? Error { get; set; }
    }

    private List<Warehouse>? _warehouses;
    private readonly List<Line> _lines = [];
    private string? _source, _destination, _error, _done, _warehouseName, _warehouseError;
    private bool _sending, _newWarehouse;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _warehouses = (await Api.GetAsync<List<Warehouse>>("/api/inventory/warehouses")).Value ?? [];
        var active = _warehouses.Where(w => w.IsActive).ToList();
        _source ??= (active.Find(w => w.IsMain) ?? active.FirstOrDefault())?.Id.ToString();
        _destination ??= active.FirstOrDefault(w => w.Id.ToString() != _source)?.Id.ToString();
    }

    private void Add(ProductSummary p)
    {
        _done = null;
        if (_lines.All(l => l.Product.Id != p.Id)) _lines.Add(new Line(p));
    }

    private async Task TransferAsync()
    {
        _error = null;
        foreach (var l in _lines)
        {
            var q = Format.ParseNumber(l.Quantity);
            l.Error = q is not > 0 ? "Escriba una cantidad mayor que cero."
                : l.Product.Unit != "Pound" && q != Math.Truncate(q.Value) ? "Unidades enteras." : null;
        }
        if (_lines.Any(l => l.Error is not null) || !Guid.TryParse(_source, out var source) || !Guid.TryParse(_destination, out var destination)) return;
        _sending = true;
        var r = await Api.PostAsync<TransferRecorded>("/api/inventory/transfers",
            new TransferStock(source, destination, [.. _lines.Select(l => new TransferLine(l.Product.Id, Format.ParseNumber(l.Quantity)!.Value))]));
        _sending = false;
        if (r.Problem is { } p)
        {
            _error = p.Code == "Inventory.OutOfStock" ? $"{p.Message} Revise las cantidades: no puede salir más de lo que hay en {Name(_source)}." : p.Message;
            return;
        }
        _done = $"Se {(_lines.Count == 1 ? "pasó" : "pasaron")} {_lines.Count} {(_lines.Count == 1 ? "producto" : "productos")} de {Name(_source)} a {Name(_destination)}.";
        _lines.Clear();
    }

    private string Name(string? id) => _warehouses?.Find(w => w.Id.ToString() == id)?.Name ?? "";

    private async Task CreateWarehouseAsync()
    {
        if (string.IsNullOrWhiteSpace(_warehouseName)) { _warehouseError = "Escriba el nombre del almacén."; return; }
        var r = await Api.PostAsync<Created>("/api/inventory/warehouses", new { Name = _warehouseName.Trim() });
        if (r.Problem is { } p) { _warehouseError = p.Message; return; }
        _newWarehouse = false;
        await LoadAsync();
    }
}
