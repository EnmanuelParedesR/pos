@page "/sale"
@implements IDisposable
@inject AbastaliaApi Api
@inject Session Session
@inject Cart Cart
@inject NavigationManager Nav
@inject Peripherals Peripherals
@inject Approver Approver

<div class="sale" data-keys @onkeydown="KeyAsync">
    <section class="sale__left" aria-label="Productos">
        <form class="esc-row" style="flex-wrap:nowrap" @onsubmit="ScanAsync">
            <label class="esc-card sale__scan-frame">
                <Icon Name="barcode" />
                <input @ref="_scanner" class="sale__scanner" data-scanner placeholder="Escanee o escriba el código o PLU" aria-label="Código de barras o PLU"
                       autocomplete="off" @bind="_code" @bind:event="oninput" />
                <Keycap>F2</Keycap>
            </label>
            <Button Type="submit" Shortcut="Enter">Agregar</Button>
        </form>

        @if (_notice is { } a)
        {
            <Notice Kind="a.Kind" Title="@a.Title">
                <ChildContent>@a.Detail</ChildContent>
                <Action><Button Variant="Button.Variants.Ghost" aria-label="Cerrar aviso" OnClick="CloseNotice"><Icon Name="x" /></Button></Action>
            </Notice>
        }

        <div class="esc-row" role="group" aria-label="Categorías">
            @foreach (var c in _categories)
            {
                <button type="button" class="esc-chip" aria-pressed="@(c.Id == _category ? "true" : "false")" @onclick="() => CategoryAsync(c.Id)">@c.Name</button>
            }
        </div>

        <div class="sale__tiles">
            @foreach (var p in _products)
            {
                <button type="button" class="esc-tile" @onclick="() => TapAsync(p)">
                    <span class="esc-tile__name">@p.Name</span>
                    <span class="esc-tile__price">@Format.WithCurrency(p.Price)@(p.Unit == "Pound" ? " / lb" : "")</span>
                </button>
            }
            @if (_products.Count == 0)
            {
                <div class="esc-muted">@(_categories.Count == 0 ? "No hay productos todavía. Agréguelos en Administración → Productos." : "Esta categoría no tiene productos.")</div>
            }
        </div>
        @if (_products.Count >= TilesPerCategory)
        {
            <div class="esc-subtitle">Se muestran los primeros @TilesPerCategory de esta categoría. Los demás, por código o PLU.</div>
        }
    </section>

    <section class="sale__cart esc-card" aria-label="Venta actual">
        <div class="sale__customer">
            <button type="button" class="esc-button esc-button--ghost" style="justify-content:flex-start;flex:1 1 auto;min-width:0" @onclick="() => OpenAsync(Panel.Customer)">
                <Icon Name="user" />
                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(Cart.Customer?.Name ?? Cart.ManualName ?? "Cliente de contado")</span>
                @if (Cart.OrderId is not null)
                {
                    <span class="esc-pill esc-pill--success">Pedido</span>
                }
                <span class="esc-pill esc-pill--neutral">@(Cart.DocumentType == EcfType.FiscalCredit31 ? "Crédito fiscal" : "Consumo")</span>
                <Keycap>F6</Keycap>
            </button>
        </div>

        <ol class="sale__lines" aria-label="Líneas">
            @foreach (var l in Cart.Lines)
            {
                <li class="sale__line @(l.Id == Cart.Selected ? "selected" : "") @(l.DiscountTooBig ? "invalid" : "")" @onclick="() => SelectLine(l.Id)"
                    aria-current="@(l.Id == Cart.Selected ? "true" : null)">
                    <div style="min-width:0">
                        <div style="font-weight:600">@l.Name</div>
                        <div class="esc-subtitle">
                            @Format.Quantity(l.Quantity, l.Unit) × @Format.Amount(l.Price)
                            @if (l.OverriddenPrice is not null) { <span> · precio cambiado</span> }
                            else if (l.UsesWholesale) { <span> · Precio mayorista</span> }
                            @if (l.DiscountAmount > 0) { <span> · desc. −@Format.Amount(l.DiscountAmount)</span> }
                            @if (l.ScaleLabel is not null) { <span> · etiqueta</span> }
                        </div>
                        @if (l.DiscountTooBig)
                        {
                            <div class="esc-error-help">El descuento es mayor que la línea. Cámbielo con F7.</div>
                        }
                    </div>
                    <div class="esc-num" style="font-size:var(--t-17);font-weight:700">@Format.Amount(l.Total)</div>
                </li>
            }
        </ol>

        @if (Cart.IsEmpty && _last is { } v)
        {
            <div class="sale__list" role="status">
                <Notice Kind="Notice.Kinds.Success" Title="@($"Venta guardada · {v.ENcf}")" />
                @if (v.Change > 0)
                {
                    <div class="esc-label">Devuelta</div>
                    <Money Value="v.Change" Size="52" />
                }
                <Button OnClick="() => OpenAsync(Panel.Receipt)"><Icon Name="printer" /> Ver factura</Button>
            </div>
        }
        else if (Cart.IsEmpty)
        {
            <div class="sale__list esc-muted">
                Escanee el primer producto.
                @if (_upcoming is { } u && (u.Today > 0 || u.Tomorrow > 0))
                {
                    @* TK-193: the reminder of the day's orders. *@
                    <Button OnClick="() => OpenAsync(Panel.Orders)"><Icon Name="calendar" /> Pedidos: @u.Today para hoy · @u.Tomorrow para mañana <Keycap>F10</Keycap></Button>
                }
            </div>
        }

        <div class="sale__totals">
            <SaleScale />
            @if (Cart.Discounts > 0)
            {
                <div class="esc-row" style="justify-content:space-between"><span class="esc-muted">Descuentos</span><span>−@Format.Amount(Cart.Discounts)</span></div>
            }
            <div class="esc-row" style="justify-content:space-between;align-items:baseline">
                <span class="esc-label">Total · @Cart.LineCount @(Cart.LineCount == 1 ? "línea" : "líneas")</span>
                <Money Value="Cart.Total" Size="44" />
            </div>
            <Button Variant="Button.Variants.Primary" Money="true" Shortcut="F12" Disabled="@(!CanCharge || !Session.Online)" OnClick="() => OpenAsync(Panel.Checkout)">Cobrar</Button>
        </div>
    </section>
</div>

<nav class="esc-key-bar" aria-label="Teclas">
    <button type="button" @onclick="() => OpenLineAsync(Panel.Quantity)" disabled="@(Cart.SelectedLine is null or { ScaleLabel: not null })"
            title="@(Cart.SelectedLine?.ScaleLabel is not null ? "El peso viene de la etiqueta" : null)"><Keycap>F3</Keycap> Cantidad</button>
    <button type="button" @onclick="() => OpenLineAsync(Panel.Price)" disabled="@(Cart.SelectedLine is null)"><Keycap>F4</Keycap> Precio</button>
    <button type="button" @onclick="() => OpenAsync(Panel.Hold)"><Keycap>F5</Keycap> Espera</button>
    <button type="button" @onclick="() => OpenLineAsync(Panel.Discount)" disabled="@(Cart.SelectedLine is null)"><Keycap>F7</Keycap> Descuento</button>
    <button type="button" @onclick="RemoveLineAsync" disabled="@(Cart.SelectedLine is null)"><Keycap>Supr</Keycap> Quitar línea</button>
    <button type="button" @onclick="() => OpenAsync(Panel.Void)" disabled="@Cart.IsEmpty"><Keycap>F8</Keycap> Anular venta</button>
    <button type="button" @onclick="() => OpenAsync(Panel.Register)"><Keycap>F9</Keycap> Caja</button>
    <button type="button" @onclick="() => OpenAsync(Panel.Orders)"><Keycap>F10</Keycap> Pedidos</button>
</nav>

@switch (_panel)
{
    case Panel.Checkout:
        <CheckoutDialog ShiftId="Session.Shift!.ShiftId" OnClose="Close" OnSold="SoldAsync" />
        break;
    case Panel.Quantity or Panel.Price or Panel.Discount when Cart.SelectedLine is { } l:
        <LineDialog Line="l" Mode="@_panel.ToString()" OnClose="Close" OnDone="UpdateLine" />
        break;
    case Panel.Weight when _pending is { } p:
        <LineDialog Line="@(new CartLine(p.ProductId, p.PresentationId, p.Name, p.Unit, p.Price, 0m, WholesalePrice: p.WholesalePrice, Wholesale: Cart.IsWholesale))" Mode="Weight" OnClose="Close" OnDone="AddWeighed" />
        break;
    case Panel.Scale when _pending is { } q:
        <WeighDialog Name="@q.Name" Price="q.Price" OnClose="Close" OnDone="AddScaled" />
        break;
    case Panel.Customer:
        <CustomerDialog OnClose="Close" />
        break;
    case Panel.Hold:
        <HeldSalesDialog ShiftId="Session.Shift!.ShiftId" OnClose="Close" />
        break;
    case Panel.Register:
        <RegisterMenu OnClose="Close" />
        break;
    case Panel.Orders:
        <OrdersDialog ShiftId="Session.Shift!.ShiftId" OnClose="CloseOrdersAsync" OnDone="OrdersDoneAsync" />
        break;
    case Panel.Receipt when _last is { } u:
        <ReceiptDialog Receipt="u.Receipt" OnClose="Close" />
        break;
    case Panel.Void:
        <Dialog Title="¿Anular esta venta?" Subtitle="Se borran todas las líneas. Todavía no se ha cobrado nada." OnClose="Close">
            <Footer>
                <Button OnClick="Close" Shortcut="Esc">No, seguir vendiendo</Button>
                <Button Variant="Button.Variants.Danger" OnClick="VoidSale" Shortcut="Enter" autofocus>Sí, anular</Button>
            </Footer>
        </Dialog>
        break;
}

@code {
    private enum Panel { None, Checkout, Quantity, Price, Discount, Weight, Scale, Customer, Hold, Register, Receipt, Void, Orders }
    private sealed record SaleNotice(Notice.Kinds Kind, string Title, string? Detail = null);
    /// <summary>The API's page size for products.</summary>
    // shortcut: one page of tiles per category; add "Ver más" (page=2) when a category grows past 50 products.
    private const int TilesPerCategory = 50;

    private Panel _panel;
    private string? _code;
    private SaleNotice? _notice;
    private List<Category> _categories = [];
    private Guid? _category;
    private List<ProductSummary> _products = [];
    private ProductByCode? _pending;
    private SaleRegistered? _last;
    private ElementReference _scanner;
    private bool _focusScanner = true;
    private (int Today, int Tomorrow)? _upcoming;

    private bool CanCharge => !Cart.IsEmpty && Session.Shift is not null && !Cart.HasInvalidLine;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (!Session.IsOpen) return;
        Session.Shift ??= (await Api.GetAsync<CurrentShift>("/api/cash/shifts/current")).Value;
        if (Session.Shift is null)
        {
            Nav.NavigateTo("open-register");
            return;
        }
        _categories = (await Api.GetAsync<List<Category>>("/api/inventory/categories")).Value?.Where(c => c.IsActive).ToList() ?? [];
        if (_categories.Count > 0) await CategoryAsync(_categories[0].Id);
        await UpcomingAsync();
    }

    /// <summary>Open orders for today and tomorrow (TK-193's reminder). Only shown to whoever may take orders.</summary>
    private async Task UpcomingAsync()
    {
        if (!Session.Can("sales.create")) return;
        var list = (await Api.GetAsync<List<OrderItem>>($"/api/orders?kind=Order&from={Format.Today:yyyy-MM-dd}&to={Format.Today.AddDays(1):yyyy-MM-dd}&openOnly=true")).Value;
        _upcoming = list is null ? null : (list.Count(o => o.PickupDate == Format.Today), list.Count(o => o.PickupDate != Format.Today));
    }

    private async Task CloseOrdersAsync()
    {
        Close();
        await UpcomingAsync();
    }

    private async Task OrdersDoneAsync(string? message)
    {
        _last = null;
        _notice = message is null ? null : new(Cart.IsEmpty ? Notice.Kinds.Success : Notice.Kinds.Warning, message);
        await CloseOrdersAsync();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged); // online / offline: Cobrar follows

    // The scanner never gets lost (principle 2): focus goes back to it after every action.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusScanner && _panel == Panel.None)
        {
            _focusScanner = false;
            try { await _scanner.FocusAsync(); }
            catch (InvalidOperationException) { } // not rendered yet (redirecting)
        }
    }

    private async Task CategoryAsync(Guid id)
    {
        _category = id;
        _products = (await Api.GetAsync<List<ProductSummary>>($"/api/inventory/products?categoryId={id}")).Value ?? [];
        _focusScanner = true;
    }

    /// <summary>False while the last checkout's outcome is unknown and the server still cannot tell: the cart must not change,
    /// or the sale the server may have saved would not match what the customer takes.</summary>
    private async Task<bool> EditableAsync()
    {
        if (!Cart.CheckoutUncertain) return true;
        var saved = await Api.SavedSaleAsync(Cart.SaleId);
        if (saved.Value is { } sale)
        {
            await SoldAsync(sale);
            _notice = new(Notice.Kinds.Info, "El cobro anterior sí se guardó.", "Siga con la próxima venta.");
            return false;
        }
        if (saved.Ok)
        {
            Cart.CheckoutUncertain = false; // never saved: the cart can change again
            return true;
        }
        _notice = new(Notice.Kinds.Warning, "No se sabe si el último cobro se guardó.", "Cuando vuelva la conexión, cobre de nuevo con F12: no se cobra dos veces.");
        return false;
    }

    private async Task ScanAsync()
    {
        var code = _code?.Trim();
        _code = "";
        _focusScanner = true;
        if (string.IsNullOrEmpty(code) || !await EditableAsync()) return;
        if (Cart.HasLabel(code))
        {
            RepeatedLabel();
            return;
        }
        var r = await Api.GetAsync<ProductByCode>($"/api/inventory/products/by-code/{Uri.EscapeDataString(code)}");
        if (r.Value is not { } p)
        {
            _notice = r.Problem!.Code switch
            {
                "Inventory.CodeNotFound" => new(Notice.Kinds.Error, $"No se encontró el código {code}.", "Búsquelo en las categorías o escriba su PLU."),
                "Inventory.LabelMisread" => new(Notice.Kinds.Error, "La etiqueta se leyó mal.", "Vuelva a escanearla o escriba el PLU."),
                "Inventory.ProductInactive" => new(Notice.Kinds.Warning, "Ese producto está desactivado.", "Un supervisor puede activarlo en Productos."),
                _ => new(r.Problem.Kind, r.Problem.Message),
            };
            return;
        }
        // The scanner may read the same label twice in a row: the first one can land while this lookup was in flight.
        if (Cart.HasLabel(code))
        {
            RepeatedLabel();
            return;
        }
        Add(p, code);
    }

    private void RepeatedLabel() =>
        _notice = new(Notice.Kinds.Warning, "Esta etiqueta ya está en la venta.", "Cada etiqueta de peso se cobra una sola vez. Si es otro paquete, pese de nuevo.");

    private void Add(ProductByCode p, string? code)
    {
        var withLabel = p.LabelQuantity is not null || p.LabelAmount is not null;
        // A presentation (a 2 lb pack) carries its own price and is sold by the piece: only a bare by-the-pound product asks for the weight.
        if (p.Unit == "Pound" && p.PresentationId is null && !withLabel)
        {
            // With a scale the weight comes from it; without one it is typed.
            _pending = p;
            _panel = Peripherals.Scale is null ? Panel.Weight : Panel.Scale;
            return;
        }
        Cart.Add(p, withLabel ? code : null);
        _last = null;
        _notice = p.Notes.Length > 0 ? new(Notice.Kinds.Info, string.Join(" · ", p.Notes)) : null;
        _focusScanner = true;
    }

    private async Task TapAsync(ProductSummary p)
    {
        if (!await EditableAsync()) return;
        Add(new ProductByCode(p.Id, null, p.Name, p.Unit, p.ItbisRate, p.Price, p.WholesalePrice, 1m, null, null, [], p.Stock), null);
    }

    private void AddWeighed(CartLine l)
    {
        if (_pending is { } p && l.Quantity > 0)
        {
            Cart.Add(p, null, l.Quantity);
            _last = null;
            _notice = null;
        }
        Close();
    }

    private void AddScaled(WeighDialog.Weighed w)
    {
        if (_pending is { } p)
        {
            Cart.Add(p, null, w.Pounds, w.Note);
            _last = null;
            _notice = null;
        }
        Close();
    }

    private void UpdateLine(CartLine l)
    {
        Cart.Update(l);
        Close();
    }

    private void SelectLine(Guid id) => (Cart.Selected, _focusScanner) = (id, true);

    private void CloseNotice() => (_notice, _focusScanner) = (null, true);

    private async Task RemoveLineAsync()
    {
        _focusScanner = true;
        if (Cart.SelectedLine is { } line && await EditableAsync()
            && await RemovalAllowedAsync("Line", line.Name, line.Quantity, line.Total, "Quitar una línea")) Cart.Remove(line.Id);
    }

    private async Task VoidSale()
    {
        Close();
        if (!await RemovalAllowedAsync("Sale", $"{Cart.Lines.Count} líneas", Cart.Lines.Count, Cart.Total, "Anular la venta en curso")) return;
        Cart.Clear();
        _notice = new(Notice.Kinds.Info, "Venta anulada antes de cobrar.");
    }

    /// <summary>R11 A5: removing a line or voiding the sale in progress is recorded on the server (the cashier's Z and the audit log). The server
    /// asks for a supervisor when the store's policy says so (TK-210) and the role lacks sales.remove-line.</summary>
    // shortcut: with the server down the cashier goes on alone; nothing was charged and nothing can be charged offline.
    private async Task<bool> RemovalAllowedAsync(string kind, string description, decimal quantity, decimal amount, string reason)
    {
        if (Session.Shift is not { } shift) return true;
        var removal = Guid.CreateVersion7();
        var r = await Approver.WithSupervisorAsync(id => Api.PostAsync<Empty>($"/api/cash/shifts/{shift.ShiftId}/cart-removals",
            new { RemovalId = removal, RemovalType = kind, Description = description, Quantity = quantity, Amount = amount, SupervisorApprovalId = id }),
            shift.ShiftId, reason);
        if (r.Ok || r.Problem!.Code == Problem.NoServer) return true;
        if (r.Problem.Code != "Cancelled") _notice = new(r.Problem.Kind, r.Problem.Message);
        return false;
    }

    private async Task OpenAsync(Panel p)
    {
        if (p == Panel.Checkout)
        {
            if (!CanCharge) return;
            if (!Session.Online) await Api.GetAsync<Empty>("/health"); // maybe it is back already
            if (!Session.Online)
            {
                _notice = new(Notice.Kinds.Warning, "Sin conexión con el servidor de la tienda.", "Espere a que vuelva para cobrar. La venta sigue aquí.");
                return;
            }
        }
        if (p == Panel.Void && Cart.IsEmpty) return;
        if (p is Panel.Hold or Panel.Customer or Panel.Void or Panel.Orders && !await EditableAsync()) return;
        _panel = p;
    }

    private async Task OpenLineAsync(Panel p)
    {
        if (Cart.SelectedLine is not { } line) return;
        if (p == Panel.Quantity && line.ScaleLabel is not null)
        {
            // The server takes the weight from the label and ignores the quantity.
            _notice = new(Notice.Kinds.Info, "El peso viene de la etiqueta.", "Para otro peso, quite la línea y escanee una etiqueta nueva.");
            return;
        }
        if (await EditableAsync()) _panel = p;
    }

    private void Close()
    {
        (_panel, _pending, _focusScanner) = (Panel.None, null, true);
    }

    private async Task SoldAsync(SaleRegistered v)
    {
        _last = v;
        _notice = null;
        var wasOrder = Cart.OrderId is not null;
        Cart.Clear();
        Close();
        if (wasOrder) await UpcomingAsync();
        if (Peripherals.Printer is null) return;
        StateHasChanged(); // the sale shows as saved while the printer works

        // The drawer opens when cash came in (the receipt's methods are the printed Spanish names); with printing on, in the same job.
        var cash = v.Receipt.Payments.Any(p => p.Method == "Efectivo");
        var print = Peripherals.Settings.PrintAfterSale;
        if (!print && !cash) return;
        var receipt = v.Receipt;
        // TK-208 (owner, D6): a 31 waits a few seconds for the DGII so the customer takes it already accepted; past that it prints as pending.
        if (print && receipt.ENcf.StartsWith("E31", StringComparison.Ordinal))
        {
            _notice = new(Notice.Kinds.Info, "Esperando a la DGII…", "La factura de crédito fiscal se imprime con la respuesta; tarda unos segundos.");
            StateHasChanged();
            var status = (await Api.PostAsync<DgiiResult>($"/api/fiscal/documents/{Uri.EscapeDataString(receipt.ENcf)}/await-result", timeout: TimeSpan.FromSeconds(30))).Value?.Status ?? "Pending";
            _notice = null;
            receipt = receipt with { DgiiStatus = Names.DgiiReceiptNote(status) };
            _last = v with { Receipt = receipt };
            if (status == "Rejected")
            {
                _notice = new(Notice.Kinds.Warning, "La DGII rechazó esta factura: no se imprimió.",
                    "La venta sí se guardó. No la entregue: avise al encargado para reemplazarla en Comprobantes electrónicos y luego reimprímala.");
                if (!cash) return;
                print = false; // the drawer still opens for the cash
            }
        }
        if (!await Peripherals.TryAsync(p => print ? p.PrintAsync(receipt, cash, CancellationToken.None) : p.OpenDrawerAsync(CancellationToken.None)))
            _notice = new(Notice.Kinds.Warning, print ? "No se pudo imprimir la factura." : "No se pudo abrir la gaveta.",
                "La venta sí se guardó. Revise que la impresora tenga papel y esté encendida; después reimprima con Ver factura.");
    }

    private async Task KeyAsync(KeyboardEventArgs e)
    {
        if (_panel != Panel.None) return; // the open dialog owns the keyboard
        switch (e.Key)
        {
            case "F2": _focusScanner = true; break;
            case "F3": await OpenLineAsync(Panel.Quantity); break;
            case "F4": await OpenLineAsync(Panel.Price); break;
            case "F5": await OpenAsync(Panel.Hold); break;
            case "F6": await OpenAsync(Panel.Customer); break;
            case "F7": await OpenLineAsync(Panel.Discount); break;
            case "F8": await OpenAsync(Panel.Void); break;
            case "F9": await OpenAsync(Panel.Register); break;
            case "F10": await OpenAsync(Panel.Orders); break;
            case "F12": await OpenAsync(Panel.Checkout); break;
            // Supr inside a scanner with text edits the text; on an empty scanner it removes the selected line.
            case "Delete" when string.IsNullOrEmpty(_code): await RemoveLineAsync(); break;
            case "ArrowUp" or "ArrowDown" when Cart.Lines.Count > 0:
                var i = Cart.Lines.ToList().FindIndex(l => l.Id == Cart.Selected);
                i = Math.Clamp(i + (e.Key == "ArrowUp" ? -1 : 1), 0, Cart.Lines.Count - 1);
                Cart.Selected = Cart.Lines[i].Id;
                break;
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
