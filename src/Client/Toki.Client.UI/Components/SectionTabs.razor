@* Tabs between the pages of one back-office section (Inventario, Compras). Each tab is its own page, so the address says where you are. *@
@inject NavigationManager Nav

@if (Tabs.Count > 1)
{
    <div class="esc-tabs" role="tablist" aria-label="@Label">
        @foreach (var (href, text) in Tabs)
        {
            <button type="button" role="tab" aria-selected="@(href == Current ? "true" : "false")" @onclick="() => Nav.NavigateTo(href)">@text</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(string Href, string Text)> Tabs { get; set; } = [];
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    private string Current => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    /// <summary>Only the inventory pages this user can use.</summary>
    public static IReadOnlyList<(string, string)> Inventory(Session s) =>
    [
        .. s.Can("inventory.view") ? [("admin/inventory", "Existencias")] : Array.Empty<(string, string)>(),
        .. s.Can("inventory.count") ? [("admin/inventory/counts", "Conteo físico")] : Array.Empty<(string, string)>(),
        .. s.Can("inventory.transfer") ? [("admin/inventory/transfers", "Transferencias")] : Array.Empty<(string, string)>(),
    ];

    /// <summary>Gastos takes payables.pay (TK-214); "Por pagar" comes from the reports, so it needs reports.view too.</summary>
    public static IReadOnlyList<(string, string)> Purchasing(Session s) =>
    [
        .. s.Can("purchasing.manage") ? [("admin/purchasing", "Compras"), ("admin/purchasing/suggested", "Pedido sugerido")] : Array.Empty<(string, string)>(),
        .. s.Can("payables.pay") ? [("admin/purchasing/expenses", "Gastos")] : Array.Empty<(string, string)>(),
        .. s.Can("purchasing.manage") ? [("admin/purchasing/received", "Recibidos (e-CF)"), ("admin/purchasing/suppliers", "Suplidores")] : Array.Empty<(string, string)>(),
        .. s.Can("reports.view") && (s.Can("purchasing.manage") || s.Can("payables.pay")) ? [("admin/purchasing/payables", "Por pagar")] : Array.Empty<(string, string)>(),
    ];
}
