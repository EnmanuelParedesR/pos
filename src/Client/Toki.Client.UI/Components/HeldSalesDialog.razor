@inject TokiApi Api
@inject Cart Cart

<Dialog Title="@(Cart.IsEmpty ? "Ventas en espera" : "Poner la venta en espera")" Subtitle="Se borran al cerrar la caja." OnClose="OnClose">
    <ChildContent>
        @if (!Cart.IsEmpty)
        {
            <label class="esc-field">
                <span>Nombre para encontrarla</span>
                <input @ref="_input" class="esc-input" maxlength="60" @bind="_label" @bind:event="oninput" @onkeydown='e => e.Key == "Enter" ? SaveAsync() : Task.CompletedTask' />
            </label>
            <div class="esc-subtitle">@Cart.LineCount líneas · @Format.WithCurrency(Cart.Total)</div>
        }
        else if (_list is null)
        {
            <div class="esc-muted">Cargando…</div>
        }
        else if (_list.Count == 0)
        {
            <div class="esc-muted">No hay ventas en espera.</div>
        }
        else
        {
            <div class="esc-card esc-table-wrap">
                <table class="esc-table">
                    <thead><tr><th>Hora</th><th>Nombre</th><th class="esc-num">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in _list)
                        {
                            <tr>
                                <td>@Format.Time(v.CreatedUtc)</td>
                                <td style="font-weight:600">@v.Label</td>
                                <td class="esc-num">@Format.Amount(v.Total)</td>
                                <td class="esc-num">
                                    <div class="esc-row" style="justify-content:flex-end">
                                        @* Discarding cannot be undone: the first tap asks, the second discards. *@
                                        <Button Variant="@(_discarding == v.Id ? Button.Variants.Danger : Button.Variants.Ghost)" OnClick="() => DiscardAsync(v)">
                                            @(_discarding == v.Id ? "¿Descartar? Toque otra vez" : "Descartar")
                                        </Button>
                                        <Button Variant="Button.Variants.Primary" OnClick="() => ResumeAsync(v)">Retomar</Button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_error is not null)
        {
            <Notice Kind="_errorKind" Title="@_error" />
        }
    </ChildContent>
    <Footer>
        <Button OnClick="OnClose" Shortcut="Esc">Cerrar</Button>
        @if (!Cart.IsEmpty)
        {
            <Button Variant="Button.Variants.Primary" Shortcut="Enter" Disabled="_sending" OnClick="SaveAsync">Poner en espera</Button>
        }
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public Guid ShiftId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<HeldSale>? _list;
    private string? _label, _error;
    private Notice.Kinds _errorKind;
    private Guid? _discarding;
    private bool _sending;
    private ElementReference _input;

    /// <summary>Saves the cart on the server as a held sale and empties it. Null when it worked.</summary>
    internal static async Task<Problem?> HoldAsync(TokiApi api, Cart cart, Guid shiftId, string? label)
    {
        var content = System.Text.Json.JsonSerializer.SerializeToElement(cart.Save(), TokiApi.Json);
        label = string.IsNullOrWhiteSpace(label) ? cart.Customer?.Name ?? $"Venta de las {Format.Time(DateTimeOffset.UtcNow)}" : label.Trim();
        var r = await api.PutAsync<Empty>("/api/sales/held", new { Id = cart.SaleId, ShiftId = shiftId, Label = label, Content = content, Total = cart.Total });
        if (r.Ok) cart.Clear();
        return r.Problem;
    }

    protected override async Task OnInitializedAsync()
    {
        _label = Cart.Customer?.Name ?? $"Venta de las {Format.Time(DateTimeOffset.UtcNow)}";
        if (Cart.IsEmpty) await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Cart.IsEmpty) await _input.FocusAsync();
    }

    private async Task LoadAsync()
    {
        var r = await Api.GetAsync<List<HeldSale>>($"/api/sales/held?shiftId={ShiftId}");
        _list = r.Value ?? [];
        Show(r.Problem);
    }

    private void Show(Problem? p) => (_errorKind, _error) = (p?.Kind ?? Notice.Kinds.Error, p?.Message);

    private async Task SaveAsync()
    {
        if (_sending) return;
        _sending = true;
        var p = await HoldAsync(Api, Cart, ShiftId, _label);
        _sending = false;
        if (p is not null) { Show(p); return; }
        await OnClose.InvokeAsync();
    }

    private async Task ResumeAsync(HeldSale v)
    {
        var saved = System.Text.Json.JsonSerializer.Deserialize<SavedCart>(v.Content, TokiApi.Json);
        if (saved is null) { (_errorKind, _error) = (Notice.Kinds.Error, "No se pudo leer esa venta."); return; }
        var r = await Api.DeleteAsync<Empty>($"/api/sales/held/{v.Id}?shiftId={ShiftId}");
        if (!r.Ok) { Show(r.Problem); return; }
        Cart.Restore(saved);
        await OnClose.InvokeAsync();
    }

    private async Task DiscardAsync(HeldSale v)
    {
        if (_discarding != v.Id)
        {
            _discarding = v.Id;
            return;
        }
        _discarding = null;
        var r = await Api.DeleteAsync<Empty>($"/api/sales/held/{v.Id}?shiftId={ShiftId}");
        await LoadAsync();
        if (!r.Ok) Show(r.Problem);
    }
}
