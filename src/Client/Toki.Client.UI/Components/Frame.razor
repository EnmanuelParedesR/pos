@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject TokiApi Api
@inject NavigationManager Nav

@if (_ready)
{
    <div style="min-height:100vh;display:flex;flex-direction:column">
        <header class="esc-status-bar">
            <div class="esc-status-bar__group">
                <Logo OnFrame="true" />
                @if (Session.Shift is { } s)
                {
                    <span style="font-weight:600">@s.Register</span>
                }
                @if (Session.Name is { } name)
                {
                    <span>@name</span>
                }
                @if (Session.Shift is { } shift)
                {
                    <span class="muted">Turno abierto @Format.Time(shift.OpenedUtc)</span>
                }
            </div>
            <div class="esc-status-bar__group">
                @if (_online)
                {
                    <span class="muted">En línea</span>
                }
                else
                {
                    <span class="esc-offline" role="status">Sin conexión con el servidor · reintentando</span>
                }
                <span style="font-weight:600">@Format.Time(DateTimeOffset.Now)</span>
            </div>
        </header>
        <main style="flex:1 1 auto;display:flex;flex-direction:column;min-height:0">
            @Body
        </main>
    </div>
    <ApprovalDialog />
}

@code {
    private static readonly string[] Public = ["setup", "sign-in"];
    private bool _ready, _online = true;
    private Timer? _clock;

    protected override async Task OnInitializedAsync()
    {
        await Session.LoadAsync();
        Session.Changed += OnSessionChanged;
        Nav.LocationChanged += OnLocationChanged;
        Guard();
        _ready = true;
        // Every 15 s: the clock and whether the store server answers (amber, never red: principle 3).
        _clock = new Timer(_ => InvokeAsync(CheckAsync), null, TimeSpan.Zero, TimeSpan.FromSeconds(15));
    }

    private async Task CheckAsync()
    {
        var r = await Api.GetAsync<Empty>("/health");
        _online = r.Problem?.Code != Problem.NoServer;
        StateHasChanged();
    }

    private void OnLocationChanged(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Guard();

    private void Guard()
    {
        var route = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (!Session.IsPaired && route != "setup") Nav.NavigateTo("setup");
        else if (Session.IsPaired && !Session.IsOpen && !Public.Contains(route)) Nav.NavigateTo("sign-in");
    }

    private void OnSessionChanged() => InvokeAsync(() =>
    {
        if (Session.Expired) Nav.NavigateTo("sign-in?expired=1");
        StateHasChanged();
    });

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _clock?.Dispose();
    }
}
