@* F10 at the register (TK-193, TK-194). With a cart: save it as an order (customer, pickup, notes, deposit) or as a quote.
   With an empty cart: today's and tomorrow's orders and the open quotes, to mark ready, cancel or charge. *@
@inject TokiApi Api
@inject Cart Cart
@inject Approver Approver
@inject Peripherals Peripherals
@inject NavigationManager Nav

<Dialog Title="@(Cart.IsEmpty ? "Pedidos y cotizaciones" : "Guardar como pedido o cotización")" Wide="true" OnClose="OnClose">
    <ChildContent>
        <Segmented Label="Tipo" Options="Kinds" Value="@_kind.ToString()" ValueChanged="KindAsync" />
        @if (!Cart.IsEmpty)
        {
            <div class="esc-subtitle">@Cart.LineCount @(Cart.LineCount == 1 ? "línea" : "líneas") · @Format.WithCurrency(Cart.Total) · @(Cart.Customer?.Name ?? "sin cliente")</div>
            @if (_kind == OrderKind.Order)
            {
                @if (Cart.Customer is null)
                {
                    <Notice Kind="Notice.Kinds.Warning" Title="Elija el cliente con F6 antes de guardar el pedido." />
                }
                <div class="esc-row">
                    <label class="esc-field" style="flex:1 1 160px">
                        <span>Fecha de entrega</span>
                        <input type="date" class="esc-input" @bind="_pickupDate" />
                    </label>
                    <label class="esc-field" style="flex:1 1 140px">
                        <span>Hora (opcional)</span>
                        <input type="time" class="esc-input" @bind="_pickupTime" />
                    </label>
                </div>
                <label class="esc-field">
                    <span>Notas (picado fino, sin grasa…)</span>
                    <input class="esc-input" maxlength="200" @bind="_notes" @bind:event="oninput" />
                </label>
                <div class="esc-row" style="align-items:flex-end">
                    <label class="esc-field" style="flex:1 1 160px">
                        <span>Abono RD$ (opcional)</span>
                        <input data-no-scan class="esc-input esc-num" inputmode="decimal" @bind="_deposit" @bind:event="oninput" />
                    </label>
                    <div class="esc-row" role="group" aria-label="Forma de pago del abono">
                        @foreach (var m in DepositMethods)
                        {
                            <button type="button" class="esc-chip" aria-pressed="@(m == _depositMethod ? "true" : "false")" @onclick="() => _depositMethod = m">@Names.PaymentMethod(m)</button>
                        }
                    </div>
                </div>
            }
            else
            {
                <label class="esc-field" style="max-width:200px">
                    <span>Válida por (días)</span>
                    <input class="esc-input esc-num" inputmode="numeric" @bind="_validDays" />
                </label>
                <div class="esc-subtitle">La cotización no mueve inventario ni caja. Al cobrarla, la venta sale con los precios de ese día.</div>
            }
        }
        else if (_list is null)
        {
            <div class="esc-muted">Cargando…</div>
        }
        else if (_list.Count == 0)
        {
            <div class="esc-muted">@(_kind == OrderKind.Order ? "No hay pedidos pendientes para hoy ni mañana." : "No hay cotizaciones abiertas de los últimos 30 días.")</div>
        }
        else
        {
            <div class="esc-card esc-table-wrap">
                <table class="esc-table">
                    <thead><tr><th>@(_kind == OrderKind.Order ? "Entrega" : "Válida hasta")</th><th>Cliente y productos</th><th class="esc-num">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _list)
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600">@(_kind == OrderKind.Order ? OrderView.Pickup(o) : o.ValidUntil?.ToString("dd/MM/yyyy", System.Globalization.CultureInfo.InvariantCulture))</div>
                                    <span class="esc-pill @OrderView.Pill(o)">@OrderView.Status(o)</span>
                                </td>
                                <td style="white-space:normal">
                                    <div style="font-weight:600">@(o.CustomerName ?? "Sin cliente")</div>
                                    <div class="esc-subtitle">@OrderView.Summary(o)@(o.Notes is null ? "" : $" · {o.Notes}")</div>
                                </td>
                                <td class="esc-num">
                                    @Format.Amount(o.Total)
                                    @if (o.Deposit > 0)
                                    {
                                        <div class="esc-subtitle">Abonó @Format.Amount(o.Deposit)</div>
                                    }
                                </td>
                                <td class="esc-num">
                                    @if (_cancelling == o.Id)
                                    {
                                        <div class="esc-row" style="justify-content:flex-end">
                                            <input class="esc-input" placeholder="Motivo" aria-label="Motivo de la cancelación" maxlength="200" @bind="_reason" @bind:event="oninput" />
                                            <Button Variant="Button.Variants.Danger" Disabled="_sending" OnClick="() => CancelAsync(o)">Cancelar pedido</Button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="esc-row" style="justify-content:flex-end">
                                            @if (o.Kind == OrderKind.Quote)
                                            {
                                                <Button Variant="Button.Variants.Ghost" OnClick='() => Nav.NavigateTo($"quotes/{o.Id}")'><Icon Name="printer" /> Imprimir</Button>
                                            }
                                            else
                                            {
                                                <Button Variant="Button.Variants.Ghost" OnClick="() => (_cancelling, _reason) = (o.Id, null)">Cancelar</Button>
                                                @if (o.Status == OrderStatus.Pending)
                                                {
                                                    <Button Disabled="_sending" OnClick="() => ReadyAsync(o)">Listo</Button>
                                                }
                                            }
                                            <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="() => ChargeAsync(o)">Cobrar</Button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_error is not null)
        {
            <Notice Kind="_errorKind" Title="@_error" />
        }
    </ChildContent>
    <Footer>
        <Button OnClick="OnClose" Shortcut="Esc">Cerrar</Button>
        @if (!Cart.IsEmpty)
        {
            <Button Variant="Button.Variants.Primary" Disabled="@(_sending || (_kind == OrderKind.Order && Cart.Customer is null))" OnClick="SaveAsync">
                @(_kind == OrderKind.Order ? "Guardar pedido" : "Guardar e imprimir cotización")
            </Button>
        }
    </Footer>
</Dialog>

@code {
    [Parameter, EditorRequired] public Guid ShiftId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Done: the message for the register's notice (saved, or loaded with changed prices).</summary>
    [Parameter] public EventCallback<string?> OnDone { get; set; }

    private static readonly IReadOnlyList<(string, string)> Kinds = [(nameof(OrderKind.Order), "Pedidos"), (nameof(OrderKind.Quote), "Cotizaciones")];
    private static readonly PaymentMethod[] DepositMethods = [PaymentMethod.Cash, PaymentMethod.Card, PaymentMethod.Transfer];

    private OrderKind _kind = OrderKind.Order;
    private List<OrderItem>? _list;
    private DateOnly _pickupDate = Format.Today.AddDays(1);
    private TimeOnly? _pickupTime;
    private string? _notes, _deposit, _error, _reason;
    private int _validDays = 15;
    private PaymentMethod _depositMethod = PaymentMethod.Cash;
    private Notice.Kinds _errorKind;
    private Guid? _cancelling;
    private bool _sending;
    /// <summary>Idempotency key of the order being saved: kept across retries while the dialog is open.</summary>
    private readonly Guid _orderId = Guid.CreateVersion7();

    protected override Task OnInitializedAsync() => Cart.IsEmpty ? LoadAsync() : Task.CompletedTask;

    private Task KindAsync(string kind)
    {
        (_kind, _error, _cancelling) = (Enum.Parse<OrderKind>(kind), null, null);
        return Cart.IsEmpty ? LoadAsync() : Task.CompletedTask;
    }

    /// <summary>Orders: the late ones of the last week, today's and tomorrow's. Quotes: the open ones of the last 30 days.</summary>
    private async Task LoadAsync()
    {
        _list = null;
        var (from, to) = _kind == OrderKind.Order ? (Format.Today.AddDays(-7), Format.Today.AddDays(1)) : (Format.Today.AddDays(-30), Format.Today);
        var r = await Api.GetAsync<List<OrderItem>>($"/api/orders?kind={_kind}&from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}&openOnly=true");
        _list = r.Value ?? [];
        Show(r.Problem);
    }

    private void Show(Problem? p) => (_errorKind, _error) = (p?.Kind ?? Notice.Kinds.Error, p?.Message);

    private async Task SaveAsync()
    {
        if (_sending) return;
        decimal? deposit = string.IsNullOrWhiteSpace(_deposit) ? null : Format.ParseNumber(_deposit);
        if (_kind == OrderKind.Order && (deposit is <= 0 || (deposit is null && !string.IsNullOrWhiteSpace(_deposit))))
        {
            (_errorKind, _error) = (Notice.Kinds.Error, "Escriba el abono como un monto, o déjelo vacío.");
            return;
        }
        var order = _kind == OrderKind.Order
            ? new CreateOrder(_orderId, OrderKind.Order, Cart.Customer?.Id, Lines(), _pickupDate, _pickupTime, Blank(_notes), null,
                deposit is { } d ? new DepositInput(ShiftId, _depositMethod, Math.Round(d, 2)) : null)
            : new CreateOrder(_orderId, OrderKind.Quote, Cart.Customer?.Id, Lines(), null, null, null, _validDays, null);
        _sending = true;
        var r = await Api.PostAsync<OrderCreated>("/api/orders", order);
        _sending = false;
        if (r.Value is null)
        {
            Show(r.Problem!.IsUncertain ? r.Problem with { Message = "No se sabe si se guardó. Toque Guardar de nuevo: no se guarda dos veces." } : r.Problem);
            return;
        }
        Cart.Clear();
        if (_kind == OrderKind.Quote)
        {
            Nav.NavigateTo($"quotes/{r.Value.OrderId}");
            return;
        }
        if (deposit is not null && _depositMethod == PaymentMethod.Cash && Peripherals.Printer is not null)
            await Peripherals.TryAsync(p => p.OpenDrawerAsync(CancellationToken.None));
        await OnDone.InvokeAsync($"Pedido guardado para {OrderView.Pickup(_pickupDate, _pickupTime).ToLowerInvariant()}"
            + $"{(deposit is { } a ? $", con abono de {Format.WithCurrency(a)}" : "")}.");
    }

    private List<OrderLineInput> Lines() => [.. Cart.Lines.Select(l => new OrderLineInput(l.ProductId, l.PresentationId, l.Quantity, l.Note))];

    private static string? Blank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task ReadyAsync(OrderItem o)
    {
        _sending = true;
        var r = await Api.PostAsync<Empty>($"/api/orders/{o.Id}/ready");
        _sending = false;
        if (!r.Ok) { Show(r.Problem); return; }
        await LoadAsync();
    }

    private async Task CancelAsync(OrderItem o)
    {
        if (string.IsNullOrWhiteSpace(_reason)) { (_errorKind, _error) = (Notice.Kinds.Error, "Escriba el motivo."); return; }
        _sending = true;
        var r = await Approver.WithSupervisorAsync(id => Api.PostAsync<Empty>($"/api/orders/{o.Id}/cancel", new { ShiftId, Reason = _reason.Trim(), SupervisorApprovalId = id }),
            o.Id, $"Cancelar el pedido de {o.CustomerName}");
        _sending = false;
        if (!r.Ok)
        {
            Show(r.Problem!.Code == "Customers.InsufficientCreditBalance"
                ? r.Problem with { Message = "El cliente ya usó el abono en otra compra; no hay abono que devolver." } : r.Problem);
            return;
        }
        if (o.Deposit > 0 && o.DepositMethod == PaymentMethod.Cash && Peripherals.Printer is not null)
            await Peripherals.TryAsync(p => p.OpenDrawerAsync(CancellationToken.None));
        _cancelling = null;
        await LoadAsync();
        (_errorKind, _error) = (Notice.Kinds.Success, o.Deposit > 0 ? $"Pedido cancelado. Devuelva {Format.WithCurrency(o.Deposit)} al cliente." : "Pedido cancelado.");
    }

    private async Task ChargeAsync(OrderItem o)
    {
        _sending = true;
        var (problem, notice) = await OrderView.LoadAsync(Api, Cart, o);
        _sending = false;
        if (problem is not null) { Show(problem); return; }
        await OnDone.InvokeAsync(notice);
    }
}
