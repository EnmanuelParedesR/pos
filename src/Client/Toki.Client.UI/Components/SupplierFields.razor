@* The invoice header shared by purchases and expenses: supplier (needs an RNC for the 606), NCF and date, with their inline errors. *@

<div class="esc-form-grid">
    <Field Label="Suplidor *" Error="@Errors.GetValueOrDefault("supplier")" Hint="@(Suppliers.Count == 0 ? "Primero cree el suplidor en Suplidores." : null)">
        <select class="esc-select" value="@SupplierId" @onchange="e => ChangeAsync(e.Value)" aria-invalid="@(Errors.ContainsKey("supplier") ? "true" : "false")" autofocus>
            <option value="">Elija…</option>
            @foreach (var s in Suppliers.Where(s => s.IsActive || s.Id == SupplierId))
            {
                <option value="@s.Id" disabled="@(s.Rnc is null)">@s.Name@(s.Rnc is null ? " (sin RNC)" : "")</option>
            }
        </select>
    </Field>
    <Field Label="NCF *" Error="@Errors.GetValueOrDefault("ncf")" Hint="B01 y 8 números, o E31 y 10.">
        <input class="esc-input" maxlength="13" style="text-transform:uppercase" value="@Ncf" @onchange="e => NcfAsync(e.Value)" aria-invalid="@(Errors.ContainsKey("ncf") ? "true" : "false")" />
    </Field>
    <Field Label="Fecha de la factura *" Error="@Errors.GetValueOrDefault("date")">
        <input type="date" class="esc-input" value="@Date.ToString("yyyy-MM-dd")" @onchange="e => DateAsync(e.Value)" aria-invalid="@(Errors.ContainsKey("date") ? "true" : "false")" />
    </Field>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Supplier> Suppliers { get; set; } = [];
    [Parameter] public Guid? SupplierId { get; set; }
    [Parameter] public EventCallback<Guid?> SupplierIdChanged { get; set; }
    [Parameter] public string? Ncf { get; set; }
    [Parameter] public EventCallback<string?> NcfChanged { get; set; }
    [Parameter] public DateOnly Date { get; set; }
    [Parameter] public EventCallback<DateOnly> DateChanged { get; set; }
    [Parameter, EditorRequired] public Dictionary<string, string> Errors { get; set; } = [];

    private Task ChangeAsync(object? value)
    {
        Errors.Remove("supplier");
        return SupplierIdChanged.InvokeAsync(Guid.TryParse(value?.ToString(), out var id) ? id : null);
    }

    private Task NcfAsync(object? value)
    {
        Errors.Remove("ncf");
        return NcfChanged.InvokeAsync(value?.ToString()?.Trim().ToUpperInvariant());
    }

    private Task DateAsync(object? value)
    {
        Errors.Remove("date");
        return DateOnly.TryParse(value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var d) ? DateChanged.InvokeAsync(d) : Task.CompletedTask;
    }

    /// <summary>The same rules as the API (Ncf.IsValid, DocumentDate), checked before sending.</summary>
    /// <param name="ncfOptional">A purchase draft may wait for its invoice (TK-191): an empty NCF is fine until it is received.</param>
    public static void Validate(Guid? supplierId, string? ncf, DateOnly date, Dictionary<string, string> errors, bool ncfOptional = false)
    {
        if (supplierId is null) errors["supplier"] = "Elija el suplidor.";
        var n = ncf?.Trim().ToUpperInvariant();
        var valid = n is { Length: 11 or 13 } && n[0] is 'B' or 'E' && n[1..].All(char.IsAsciiDigit);
        if (!valid && !(ncfOptional && string.IsNullOrEmpty(n))) errors["ncf"] = "El NCF es B01 y 8 números (11 en total) o E31 y 10 (13).";
        if (date > Format.Today.AddDays(1)) errors["date"] = "La fecha no puede ser futura.";
    }

    /// <summary>Puts what the API refused next to its field. False when it is not about these fields.</summary>
    public static bool Explain(Problem p, Dictionary<string, string> errors)
    {
        switch (p.Code)
        {
            case "Purchasing.DuplicateNcf": errors["ncf"] = "Ya se registró ese NCF de este suplidor."; return true;
            case "Purchasing.SupplierWithoutRnc": errors["supplier"] = "Este suplidor no tiene RNC. Agréguelo en Suplidores."; return true;
            case "Purchasing.SupplierNotFound": errors["supplier"] = "El suplidor no existe o está desactivado."; return true;
        }
        if ((p.Error("ncf") ?? p.Error("Ncf")) is { } ncf) { errors["ncf"] = ncf; return true; }
        if ((p.Error("invoiceDate") ?? p.Error("date") ?? p.Error("InvoiceDate") ?? p.Error("Date")) is { } date) { errors["date"] = date; return true; }
        return false;
    }
}
