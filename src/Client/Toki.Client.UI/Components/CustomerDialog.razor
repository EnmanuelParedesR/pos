@inject TokiApi Api
@inject Cart Cart

<Dialog Title="Cliente y comprobante" Wide="true" OnClose="OnClose">
    <ChildContent>
        <div class="esc-row" role="group" aria-label="Tipo de comprobante">
            <button type="button" class="esc-chip" aria-pressed="@(Cart.DocumentType == EcfType.Consumer32 ? "true" : "false")" @onclick="() => Cart.DocumentType = EcfType.Consumer32">Consumo</button>
            <button type="button" class="esc-chip" aria-pressed="@(Cart.DocumentType == EcfType.FiscalCredit31 ? "true" : "false")" @onclick="() => Cart.DocumentType = EcfType.FiscalCredit31">Crédito fiscal</button>
        </div>

        @if (Cart.Customer is { } c)
        {
            <div class="esc-card esc-card--padded esc-row" style="justify-content:space-between">
                <div>
                    <div style="font-size:var(--t-20);font-weight:700">@c.Name</div>
                    <div class="esc-subtitle">@(c.TaxId ?? "Sin RNC ni cédula")</div>
                </div>
                <div class="esc-row" style="gap:16px">
                    <div><div class="esc-label">Debe</div><div style="font-weight:700">@Format.WithCurrency(c.Debt)</div></div>
                    <div><div class="esc-label">Límite</div><div style="font-weight:700">@Format.WithCurrency(c.CreditLimit)</div></div>
                    @if (c.CreditBalance > 0)
                    {
                        <div><div class="esc-label">A favor</div><div style="font-weight:700;color:var(--success)">@Format.WithCurrency(c.CreditBalance)</div></div>
                    }
                </div>
                <Button Variant="Button.Variants.Ghost" OnClick="() => Cart.Customer = null">Quitar cliente</Button>
            </div>
        }
        else
        {
            <form class="esc-row" style="flex-wrap:nowrap" @onsubmit="SearchAsync">
                <input @ref="_searchBox" class="esc-input" placeholder="Nombre, RNC, cédula o teléfono" aria-label="Buscar cliente" @bind="_search" @bind:event="oninput" />
                <Button Type="submit" Shortcut="Enter"><Icon Name="search" /> Buscar</Button>
            </form>
            @if (_results is { Count: > 0 })
            {
                <div class="esc-card esc-table-wrap">
                    <table class="esc-table">
                        <thead><tr><th>Cliente</th><th>RNC / cédula</th><th>Teléfono</th><th class="esc-num">Límite</th></tr></thead>
                        <tbody>
                            @foreach (var r in _results)
                            {
                                <tr class="selectable" @onclick="() => ChooseAsync(r.Id)" tabindex="0" @onkeydown='e => e.Key == "Enter" ? ChooseAsync(r.Id) : Task.CompletedTask'>
                                    <td style="font-weight:600">@r.Name</td><td>@r.TaxId</td><td>@r.Phone</td><td class="esc-num">@Format.Amount(r.CreditLimit)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (_results is not null)
            {
                <div class="esc-muted">No hay clientes con "@_search".</div>
            }

            @if (Cart.DocumentType == EcfType.FiscalCredit31)
            {
                <div class="esc-subtitle">O escriba los datos para una sola factura:</div>
                <div style="display:grid;grid-template-columns:1fr 2fr;gap:12px">
                    <label class="esc-field"><span>RNC o cédula</span><input class="esc-input" inputmode="numeric" maxlength="11" @bind="Cart.ManualRnc" /></label>
                    <label class="esc-field"><span>Nombre o razón social</span><input class="esc-input" maxlength="150" @bind="Cart.ManualName" /></label>
                </div>
            }

            <details>
                <summary style="cursor:pointer;font-weight:600;min-height:44px;display:flex;align-items:center">Nuevo cliente</summary>
                <form class="esc-col" style="gap:12px;padding-top:8px" @onsubmit="CreateAsync">
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
                        <label class="esc-field"><span>Nombre</span><input class="esc-input" maxlength="150" @bind="_newName" /></label>
                        <label class="esc-field"><span>RNC o cédula</span><input class="esc-input" inputmode="numeric" maxlength="11" @bind="_newTaxId" /></label>
                        <label class="esc-field"><span>Teléfono</span><input class="esc-input" inputmode="tel" maxlength="30" @bind="_newPhone" /></label>
                    </div>
                    <div><Button Type="submit">Crear y usar</Button></div>
                </form>
            </details>
        }
        @if (_error is not null)
        {
            <Notice Title="@_error" />
        }
    </ChildContent>
    <Footer>
        <Button Variant="Button.Variants.Primary" Shortcut="Esc" OnClick="OnClose">Listo</Button>
    </Footer>
</Dialog>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    private string? _search, _error, _newName, _newTaxId, _newPhone;
    private List<CustomerSummary>? _results;
    private ElementReference _searchBox;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Cart.Customer is null) await _searchBox.FocusAsync();
    }

    private async Task SearchAsync()
    {
        var r = await Api.GetAsync<List<CustomerSummary>>($"/api/customers?search={Uri.EscapeDataString(_search ?? "")}");
        (_results, _error) = (r.Value, r.Problem?.Message);
    }

    private async Task ChooseAsync(Guid id)
    {
        var r = await Api.GetAsync<CustomerDetail>($"/api/customers/{id}");
        Cart.Customer = r.Value;
        _error = r.Problem?.Message;
        if (r.Value is { FiscalCredit: true }) Cart.DocumentType = EcfType.FiscalCredit31;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName)) { _error = "Escriba el nombre."; return; }
        var taxId = string.IsNullOrWhiteSpace(_newTaxId) ? null : _newTaxId.Trim();
        var r = await Api.PostAsync<Created>("/api/customers", new NewCustomer(_newName.Trim(), taxId, _newPhone?.Trim(), null, taxId is not null && Cart.DocumentType == EcfType.FiscalCredit31));
        if (r.Value is { } c) await ChooseAsync(c.Id);
        else _error = r.Problem!.Code == "Customers.DuplicateTaxId" ? "Ya hay un cliente con ese RNC o cédula. Búsquelo." : r.Problem.Message;
    }
}
