@* Configuración → Roles y permisos (TK-186): what each role may do, in the owner's words. Administrador always has everything. *@
@inject TokiApi Api

<section class="esc-card esc-setting">
    <div class="esc-setting__about">
        <h2>Roles y permisos</h2>
        <p>Cada usuario tiene un rol. Lo que el rol no permite, en la caja lo autoriza un supervisor con su PIN.</p>
        <div style="margin-top:12px"><Button OnClick="New"><Icon Name="plus" /> Nuevo rol</Button></div>
    </div>
    <div class="esc-setting__body">
        <div class="esc-table-wrap">
            <table class="esc-table">
                <thead><tr><th>Rol</th><th>Puede</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _roles)
                    {
                        <tr>
                            <td style="font-weight:600">@r.Name</td>
                            <td class="esc-muted">@(IsAdministrator(r) ? "Todo, siempre" : $"{r.Permissions.Length} de {_available.Length} permisos")</td>
                            <td class="esc-num">
                                @if (IsAdministrator(r))
                                {
                                    <span class="esc-pill esc-pill--neutral" title="El rol Administrador no se puede editar">No se edita</span>
                                }
                                else
                                {
                                    <Button class="esc-button esc-button--small" aria-label="@($"Editar {r.Name}")" OnClick="() => Edit(r)">Editar</Button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_message is not null)
        {
            <Notice Kind="_messageKind" Title="@_message" />
        }
    </div>
</section>

@if (_form is { } f)
{
    <Dialog Title="@(f.Id is null ? "Nuevo rol" : $"Rol {f.Name}")" Subtitle="Marque lo que puede hacer quien tenga este rol." Wide="true" OnClose="() => _form = null">
        <ChildContent>
            <Field Label="Nombre del rol" Error="@_nameError">
                <input class="esc-input" maxlength="60" placeholder="Encargado de carnicería" @bind="f.Name" @bind:after="() => _nameError = null" aria-invalid="@(_nameError is null ? "false" : "true")" autofocus />
            </Field>
            @foreach (var (group, permissions) in Shown)
            {
                var shown = permissions.Where(p => _available.Contains(p)).ToList();
                if (shown.Count == 0) continue;
                <fieldset class="esc-col" style="gap:0;border:0;padding:0;margin:0">
                    <legend class="esc-section-title" style="margin-bottom:4px">@group</legend>
                    @foreach (var p in shown)
                    {
                        <label class="esc-check"><input type="checkbox" checked="@f.Permissions.Contains(p)" @onchange="e => Toggle(f, p, (bool)e.Value!)" /> @Label(p)</label>
                    }
                </fieldset>
            }
            @if (_error is not null) { <Notice Title="@_error" /> }
        </ChildContent>
        <Footer>
            <Button OnClick="() => _form = null" Shortcut="Esc">Cancelar</Button>
            <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="SaveAsync">@(_sending ? "Guardando…" : "Guardar rol")</Button>
        </Footer>
    </Dialog>
}

@code {
    private sealed class RoleForm { public Guid? Id; public string Name = ""; public HashSet<string> Permissions = []; }

    /// <summary>The seeded Administrador role (Identity's <c>Role.AdministratorId</c>); the API refuses to edit it.</summary>
    private static readonly Guid AdministratorId = new("0199e000-0000-7000-8000-000000000001");

    private static readonly (string, string[])[] Groups =
    [
        ("Caja y ventas", ["register.operate", "sales.create", "register.withdraw", "register.open-drawer", "register.approve-close", "sales.void", "sales.return", "sales.large-discount", "sales.price-override"]),
        ("Clientes y fiado", ["customers.manage", "credit.manage", "credit.exceed-limit"]),
        ("Productos e inventario", ["products.manage", "prices.change", "inventory.view", "inventory.adjust", "inventory.count", "inventory.transfer", "purchasing.manage"]),
        ("Administración", ["reports.view", "fiscal.manage", "settings.manage", "users.manage", "devices.manage"]),
    ];

    /// <summary>Each permission as the owner reads it. A new one the screen does not know yet shows its code under "Otros".</summary>
    public static string Label(string permission) => permission switch
    {
        "register.operate" => "Abrir y operar una caja (cobrar abonos, entradas de efectivo)",
        "sales.create" => "Vender",
        "register.withdraw" => "Sacar efectivo de la caja",
        "register.open-drawer" => "Abrir la gaveta sin vender",
        "register.approve-close" => "Autorizar cierres y usar cajas de otros",
        "sales.void" => "Anular ventas",
        "sales.return" => "Hacer devoluciones",
        "sales.large-discount" => "Dar descuentos mayores que el tope",
        "sales.price-override" => "Cambiar el precio en la caja",
        "customers.manage" => "Buscar y crear clientes",
        "credit.manage" => "Dar crédito, precio mayorista y anular abonos",
        "credit.exceed-limit" => "Fiar por encima del límite",
        "products.manage" => "Crear y editar productos",
        "prices.change" => "Cambiar precios de los productos",
        "inventory.view" => "Ver el inventario",
        "inventory.adjust" => "Ajustar existencias",
        "inventory.count" => "Hacer conteos físicos",
        "inventory.transfer" => "Hacer transferencias entre almacenes",
        "purchasing.manage" => "Compras, suplidores y gastos",
        "reports.view" => "Ver la administración y los reportes",
        "fiscal.manage" => "Cargar secuencias de comprobantes",
        "settings.manage" => "Cambiar la configuración del negocio y las cajas",
        "users.manage" => "Crear usuarios y editar roles",
        "devices.manage" => "Unir y revocar equipos",
        _ => permission,
    };

    private List<Role> _roles = [];
    private string[] _available = [];
    private RoleForm? _form;
    private string? _message, _error, _nameError;
    private Notice.Kinds _messageKind;
    private bool _sending;

    private static bool IsAdministrator(Role r) => r.Id == AdministratorId;

    /// <summary>The groups, plus "Otros" with any permission the API has that this screen does not list yet (shown by its code).</summary>
    private IEnumerable<(string, string[])> Shown => Groups.Append(("Otros", [.. _available.Except(Groups.SelectMany(g => g.Item2))]));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var r = await Api.GetAsync<RoleList>("/api/identity/roles");
        (_roles, _available) = ([.. r.Value?.Roles ?? []], r.Value?.AvailablePermissions ?? []);
        if (r.Problem is { } p) (_messageKind, _message) = (p.Kind, p.Message);
    }

    private void New() => (_form, _error, _nameError, _message) = (new RoleForm(), null, null, null);

    private void Edit(Role r) => (_form, _error, _nameError, _message) = (new RoleForm { Id = r.Id, Name = r.Name, Permissions = [.. r.Permissions] }, null, null, null);

    private static void Toggle(RoleForm f, string permission, bool on)
    {
        if (on) f.Permissions.Add(permission);
        else f.Permissions.Remove(permission);
    }

    private async Task SaveAsync()
    {
        if (_form is not { } f || _sending) return;
        if (string.IsNullOrWhiteSpace(f.Name)) { _nameError = "Escriba el nombre del rol."; return; }
        var body = new SaveRole(f.Name.Trim(), [.. _available.Where(f.Permissions.Contains)]);
        _sending = true;
        var p = f.Id is { } id ? (await Api.PutAsync<Empty>($"/api/identity/roles/{id}", body)).Problem : (await Api.PostAsync<Created>("/api/identity/roles", body)).Problem;
        _sending = false;
        if (p is not null) { _error = p.Code == "Identity.ProtectedRole" ? "El rol Administrador no se puede editar." : p.Message; return; }
        _form = null;
        await LoadAsync();
        (_messageKind, _message) = (Notice.Kinds.Success, $"Rol {body.Name} guardado. Aplica de inmediato; los menús de cada usuario cambian cuando vuelva a entrar.");
    }
}
