<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="route">
        <RouteView RouteData="route" DefaultLayout="typeof(Components.Frame)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Components.Frame)">
            <div class="esc-page"><Notice Title="Esta pantalla no existe." Kind="Notice.Kinds.Warning" /></div>
        </LayoutView>
    </NotFound>
</Router>
