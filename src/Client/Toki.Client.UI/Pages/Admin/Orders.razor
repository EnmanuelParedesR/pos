@page "/admin/orders"
@page "/admin/orders/{Section}"
@using Microsoft.JSInterop
@inject TokiApi Api
@inject Session Session
@inject NavigationManager Nav
@inject IJSRuntime Js

@* TK-193 orders by pickup day, TK-194 quotes, TK-195 the public catalog (which products, WhatsApp, link and QR).
   Charging, deposits and cancelling happen at the register (F10): they move the drawer. *@
<Admin Title="Pedidos y catálogo" Subtitle="@Subtitle">
    <ChildContent>
        <SectionTabs Label="Pedidos" Tabs="Tabs" />
        @if (_tab == Tab.Catalog)
        {
            <div class="esc-grid">
                <section class="esc-card esc-card--padded esc-span-8 esc-col no-print" aria-label="Productos del catálogo">
                    <label class="esc-field">
                        <span>WhatsApp donde llegan los pedidos</span>
                        <input class="esc-input" inputmode="tel" placeholder="809 555 0101" maxlength="20" @bind="_whatsApp" @bind:event="oninput" />
                    </label>
                    <label class="esc-search" style="flex:none">
                        <Icon Name="search" Size="18" />
                        <input placeholder="Buscar producto" aria-label="Buscar producto" @bind="_search" @bind:event="oninput" />
                    </label>
                    <div class="esc-subtitle">@_shown.Count de @(_products?.Count ?? 0) productos en el catálogo. Se muestran nombre, precio y unidad; nunca el costo ni la existencia.</div>
                    @if (_products is null)
                    {
                        <Skeleton Height="200px" />
                    }
                    else
                    {
                        <ul class="esc-col" style="list-style:none;margin:0;padding:0;gap:0;max-height:480px;overflow:auto">
                            @foreach (var p in _products.Where(Matches))
                            {
                                <li>
                                    <label class="esc-row" style="min-height:48px;gap:12px;border-top:1px solid var(--line)">
                                        <input type="checkbox" style="width:22px;height:22px" aria-label="@($"Mostrar {p.Name} en el catálogo")" checked="@_shown.Contains(p.Id)" @onchange="e => Toggle(p.Id, e.Value is true)" />
                                        <span style="flex:1 1 auto;font-weight:600">@p.Name</span>
                                        <span class="esc-muted esc-hide-sm">@p.Category</span>
                                        <span class="esc-num">@Format.Amount(p.Price)@(p.Unit == "Pound" ? " / lb" : "")</span>
                                    </label>
                                </li>
                            }
                        </ul>
                    }
                    <div class="esc-row">
                        <Button Variant="Button.Variants.Primary" Disabled="@(_sending || _products is null)" OnClick="SaveCatalogAsync">Guardar catálogo</Button>
                    </div>
                </section>
                <section class="esc-card esc-card--padded esc-span-4 esc-col" aria-labelledby="qr-title">
                    <h2 id="qr-title" class="esc-card__title">Enlace y código QR</h2>
                    @if (_publicUrl is { } url)
                    {
                        <p>Péguelo en el mostrador o compártalo por WhatsApp. No cambia cuando edita el catálogo.</p>
                        @if (_qr is not null)
                        {
                            <div class="catalog-qr">@((MarkupString)_qr)</div>
                        }
                        <a href="@url" target="_blank" rel="noopener" style="word-break:break-all">@url</a>
                        <Button OnClick="PrintAsync" class="no-print"><Icon Name="printer" /> Imprimir el QR</Button>
                    }
                    else
                    {
                        <p class="esc-muted">@_linkHelp</p>
                    }
                </section>
            </div>
        }
        else
        {
            <div class="esc-row">
                @if (_tab == Tab.Orders)
                {
                    <label class="esc-field" style="max-width:220px">
                        <span>Día de entrega</span>
                        <input type="date" class="esc-input" value="@_day.ToString("yyyy-MM-dd")" @onchange="DayAsync" />
                    </label>
                }
                <span class="esc-muted">@(_tab == Tab.Orders ? "Para cobrar, cancelar o tomar un abono, use F10 en la caja." : "Las de los últimos 30 días. Se cobran en la caja con F10.")</span>
            </div>
            <div class="esc-card esc-table-wrap">
                <table class="esc-table">
                    <thead><tr><th>@(_tab == Tab.Orders ? "Hora" : "Fecha")</th><th>Cliente y productos</th><th class="esc-hide-sm">Estado</th><th class="esc-num">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in _list ?? [])
                        {
                            <tr>
                                <td>@(_tab == Tab.Orders ? (o.PickupTime is { } t ? t.ToString("h:mm tt", System.Globalization.CultureInfo.GetCultureInfo("es-DO")) : "Todo el día") : Format.ShortDate(o.CreatedUtc))</td>
                                <td style="white-space:normal">
                                    <div style="font-weight:600">@(o.CustomerName ?? "Sin cliente") <span class="esc-pill esc-only-sm @OrderView.Pill(o)">@OrderView.Status(o)</span></div>
                                    <div class="esc-subtitle">@OrderView.Summary(o)@(o.Notes is null ? "" : $" · {o.Notes}")</div>
                                </td>
                                <td class="esc-hide-sm"><span class="esc-pill @OrderView.Pill(o)">@OrderView.Status(o)</span></td>
                                <td class="esc-num">
                                    @Format.Amount(o.Total)
                                    @if (o.Deposit > 0)
                                    {
                                        <div class="esc-subtitle">Abonó @Format.Amount(o.Deposit)</div>
                                    }
                                </td>
                                <td class="esc-num">
                                    @if (o.Kind == OrderKind.Quote)
                                    {
                                        <a class="esc-button esc-button--small" href="quotes/@o.Id?from=admin"><Icon Name="printer" Size="16" /> Imprimir</a>
                                    }
                                    else if (o.Status == OrderStatus.Pending)
                                    {
                                        <Button Disabled="_sending" OnClick="() => ReadyAsync(o)">Listo</Button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_list is { Count: 0 })
                {
                    <EmptyState Icon="calendar" Title="@(_tab == Tab.Orders ? "No hay pedidos para ese día" : "No hay cotizaciones")">
                        @(_tab == Tab.Orders ? "Los pedidos se toman en la caja: agregue los productos y toque F10." : "Las cotizaciones se hacen en la caja: agregue los productos y toque F10.")
                    </EmptyState>
                }
            </div>
        }
        @if (_message is not null)
        {
            <Notice Kind="_messageKind" Title="@_message" />
        }
    </ChildContent>
</Admin>

@code {
    [Parameter] public string? Section { get; set; }

    private enum Tab { Orders, Quotes, Catalog }
    private sealed record CatalogProduct(Guid Id, string Name, string Category, string Unit, decimal Price);

    private Tab _tab;
    private DateOnly _day = Format.Today;
    private List<OrderItem>? _list;
    private List<CatalogProduct>? _products;
    private HashSet<Guid> _shown = [];
    private string? _whatsApp, _search, _publicUrl, _qr, _message, _linkHelp;
    private Notice.Kinds _messageKind;
    private bool _sending;

    private string Subtitle => _tab switch
    {
        Tab.Orders => "Los encargos por día de entrega.",
        Tab.Quotes => "Cotizaciones para imprimir o enviar.",
        _ => "Lo que sus clientes ven en el catálogo público y piden por WhatsApp.",
    };

    private IReadOnlyList<(string, string)> Tabs =>
    [
        .. Session.Can("sales.create") ? [("admin/orders", "Pedidos"), ("admin/orders/quotes", "Cotizaciones")] : Array.Empty<(string, string)>(),
        .. Session.Can("products.manage") ? [("admin/orders/catalog", "Catálogo")] : Array.Empty<(string, string)>(),
    ];

    protected override async Task OnParametersSetAsync()
    {
        // A route parameter, so moving between the tabs (same page) runs this again.
        _tab = Section switch { "catalog" => Tab.Catalog, "quotes" => Tab.Quotes, _ => Tab.Orders };
        if (_tab != Tab.Catalog && !Session.Can("sales.create"))
        {
            Nav.NavigateTo("admin/orders/catalog");
            return;
        }
        _message = null;
        if (_tab == Tab.Catalog) await LoadCatalogAsync();
        else await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _list = null;
        var (kind, from, to) = _tab == Tab.Orders ? (OrderKind.Order, _day, _day) : (OrderKind.Quote, Format.Today.AddDays(-30), Format.Today);
        var r = await Api.GetAsync<List<OrderItem>>($"/api/orders?kind={kind}&from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}");
        _list = r.Value is null ? [] : kind == OrderKind.Quote ? [.. r.Value.OrderByDescending(o => o.CreatedUtc)] : r.Value;
        Show(r.Problem);
    }

    private Task DayAsync(ChangeEventArgs e)
    {
        if (!DateOnly.TryParse(e.Value?.ToString(), System.Globalization.CultureInfo.InvariantCulture, out var day)) return Task.CompletedTask;
        _day = day;
        return LoadAsync();
    }

    private void Show(Problem? p) => (_messageKind, _message) = (p?.Kind ?? Notice.Kinds.Error, p?.Message);

    private async Task ReadyAsync(OrderItem o)
    {
        _sending = true;
        var r = await Api.PostAsync<Empty>($"/api/orders/{o.Id}/ready");
        _sending = false;
        if (!r.Ok) { Show(r.Problem); return; }
        await LoadAsync();
    }

    private async Task LoadCatalogAsync()
    {
        var settings = await Api.GetAsync<CatalogSettings>("/api/catalog");
        if (settings.Value is not { } s) { Show(settings.Problem); return; }
        (_whatsApp, _shown) = (s.WhatsApp, [.. s.ProductIds]);
        // shortcut: every active product, 50 per page, up to 1,000; add search on the server if a store has more.
        var products = new List<CatalogProduct>();
        for (var page = 1; page <= 20; page++)
        {
            var batch = (await Api.GetAsync<List<ProductSummary>>($"/api/inventory/products?page={page}")).Value ?? [];
            products.AddRange(batch.Select(p => new CatalogProduct(p.Id, p.Name, p.Category, p.Unit, p.Price)));
            if (batch.Count < 50) break;
        }
        _products = [.. products.OrderBy(p => p.Category).ThenBy(p => p.Name)];

        var link = Session.Can("settings.manage") ? (await Api.GetAsync<CloudLink>("/api/sync/status")).Value : null;
        (_publicUrl, _qr) = (null, null);
        if (s.PanelUrl is null) _linkHelp = "Falta la dirección del panel de Toki en la configuración de esta PC (Cloud:PanelUrl). Pídasela a su proveedor.";
        else if (link is not { Connected: true, StoreId: { } store }) _linkHelp = "Conecte la tienda a la nube (Configuración → Nube) para publicar el catálogo y ver su enlace.";
        else
        {
            _publicUrl = $"{s.PanelUrl}/c/{store}";
            _qr = (await Api.GetAsync<CatalogQr>($"/api/catalog/qr?url={Uri.EscapeDataString(_publicUrl)}")).Value?.Svg;
        }
    }

    private bool Matches(CatalogProduct p) => string.IsNullOrWhiteSpace(_search)
        || p.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase) || p.Category.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase);

    private void Toggle(Guid id, bool shown)
    {
        if (shown) _shown.Add(id);
        else _shown.Remove(id);
    }

    private async Task SaveCatalogAsync()
    {
        _sending = true;
        var r = await Api.PutAsync<Empty>("/api/catalog", new SaveCatalog(string.IsNullOrWhiteSpace(_whatsApp) ? null : _whatsApp.Trim(), [.. _shown]));
        _sending = false;
        if (!r.Ok) { Show(r.Problem); return; }
        (_messageKind, _message) = (Notice.Kinds.Success, "Catálogo guardado. Con internet, se ve en el enlace en unos minutos.");
    }

    private Task PrintAsync() => Js.InvokeVoidAsync("print").AsTask();
}
