@page "/admin/products"
@inject TokiApi Api
@inject Session Session

<Admin Title="Productos" Subtitle="Precios con ITBIS incluido. Toque un producto para cambiarlo.">
    <Actions>
        @if (Session.Can("products.manage"))
        {
            <Button OnClick="() => (_newCategory, _error, _categoryError) = (true, null, null)">Nueva categoría</Button>
            <Button Variant="Button.Variants.Primary" Disabled="@(_categories.Count == 0)" OnClick="New"><Icon Name="plus" /> Nuevo producto</Button>
        }
    </Actions>
    <ChildContent>
        <form class="esc-row" style="gap:12px" @onsubmit="LoadAsync">
            <label class="esc-search">
                <Icon Name="search" Size="18" />
                <input placeholder="Buscar por nombre o PLU" aria-label="Buscar producto" @bind="_search" @bind:event="oninput" @bind:after="SearchAsync" />
            </label>
            <select class="esc-select" style="width:auto;min-width:200px" aria-label="Categoría" @bind="_category" @bind:after="LoadAsync">
                <option value="">Todas las categorías</option>
                @foreach (var c in _categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </form>
        @if (_categories.Count == 0 && !_loading)
        {
            <Notice Kind="Notice.Kinds.Info" Title="Empiece creando una categoría (por ejemplo Res, Pollo o Colmado) y luego sus productos." />
        }
        <div class="esc-card esc-table-wrap esc-table-wrap--tall">
            <table class="esc-table esc-table--wide">
                <thead><tr><th>Producto</th><th class="esc-hide-sm">Categoría</th><th class="esc-hide-sm">Se vende</th><th class="esc-num">Precio</th><th class="esc-hide-sm">ITBIS</th><th class="esc-num esc-hide-sm">Existencia</th><th class="esc-table__chev esc-hide-sm"><span class="esc-visually-hidden">Abrir</span></th></tr></thead>
                <tbody>
                    @if (_loading)
                    {
                        @for (var i = 0; i < 6; i++)
                        {
                            <tr><td><Skeleton Width="160px" /></td><td class="esc-hide-sm"><Skeleton Width="90px" /></td><td class="esc-hide-sm"><Skeleton Width="80px" /></td><td><Skeleton /></td><td class="esc-hide-sm"><Skeleton Width="50px" /></td><td class="esc-hide-sm"><Skeleton /></td><td class="esc-hide-sm"></td></tr>
                        }
                    }
                    else
                    {
                        @foreach (var p in _products)
                        {
                            <tr class="selectable" tabindex="0" @onclick="() => EditAsync(p.Id)" @onkeydown='e => e.Key == "Enter" ? EditAsync(p.Id) : Task.CompletedTask'>
                                <td style="font-weight:600">@p.Name @if (!p.IsActive) { <span class="esc-pill esc-pill--neutral" style="margin-left:6px">Inactivo</span> }<span class="esc-table__sub esc-only-sm">@p.Category · @Names.Itbis(p.ItbisRate)</span></td>
                                <td class="esc-hide-sm"><span class="esc-row" style="gap:8px;flex-wrap:nowrap"><span class="esc-swatch" style="background:@Color(p.Category)"></span>@p.Category</span></td>
                                <td class="esc-muted esc-hide-sm">@Names.Unit(p.Unit)</td>
                                <td class="esc-num" style="font-weight:600;white-space:nowrap">@Format.WithCurrency(p.Price)@if (p.Unit == "Pound") { <span class="esc-muted" style="font-weight:400"> /lb</span> }
                                    <span class="esc-table__sub esc-only-sm">@(p.Stock is { } st ? $"Quedan {Stock(st, p.Unit)}" : "")</span></td>
                                <td class="esc-muted esc-hide-sm">@Names.Itbis(p.ItbisRate)</td>
                                <td class="esc-num esc-hide-sm">
                                    @if (p.Stock is { } e && e < 0)
                                    {
                                        <span class="esc-pill esc-pill--warning" title="Se vendió más de lo que había registrado">@Stock(e, p.Unit)</span>
                                    }
                                    else
                                    {
                                        @(p.Stock is { } s ? Stock(s, p.Unit) : "—")
                                    }
                                </td>
                                <td class="esc-table__chev esc-hide-sm">@if (Session.Can("products.manage")) { <Icon Name="chevron-right" Size="18" /> }</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (!_loading && _products.Count == 0)
            {
                <EmptyState Icon="package" Title="@(string.IsNullOrWhiteSpace(_search) ? "Todavía no hay productos" : $"Nada coincide con “{_search}”")">
                    @(string.IsNullOrWhiteSpace(_search) ? "Cree el primero con “Nuevo producto”." : "Pruebe con otra palabra o con el PLU de la balanza.")
                </EmptyState>
            }
            @* TK-239: pages of 50 (the API's page size); the search stays on the server. *@
            @if (_hasMore && !_loading)
            {
                <div class="esc-table-foot"><Button Disabled="_sending" OnClick="MoreAsync">Ver más productos</Button></div>
            }
        </div>

        @if (_newCategory)
        {
            <Dialog Title="Nueva categoría" Subtitle="Agrupa los productos en la caja y en los reportes." OnClose="() => _newCategory = false">
                <ChildContent>
                    <Field Label="Nombre" Error="@_categoryError" Hint="Por ejemplo: Res, Pollo, Cerdo o Colmado.">
                        <input class="esc-input" maxlength="80" @bind="_categoryName" @bind:after="() => _categoryError = null" aria-invalid="@(_categoryError is not null ? "true" : "false")" autofocus />
                    </Field>
                    <Field Label="Color del mosaico en la caja">
                        <input type="color" class="esc-input" style="padding:4px;width:120px" @bind="_categoryColor" />
                    </Field>
                    @if (_error is not null) { <Notice Title="@_error" /> }
                </ChildContent>
                <Footer>
                    <Button OnClick="() => _newCategory = false" Shortcut="Esc">Cancelar</Button>
                    <Button Variant="Button.Variants.Primary" OnClick="CreateCategoryAsync">Crear categoría</Button>
                </Footer>
            </Dialog>
        }

        @if (_editing is { } f)
        {
            <Dialog Title="@(f.Id is null ? "Nuevo producto" : f.Name)" Subtitle="@(f.Id is null ? "Lo que se vende en la caja. Los campos con * son obligatorios." : "Editar producto")" Wide="true" OnClose="() => _editing = null">
                <ChildContent>
                    <div class="esc-form-grid">
                        <Field Label="Nombre *" Wide="true" Error="@Err("name")">
                            <input class="esc-input" maxlength="150" @bind="f.Name" @bind:after='() => Clear("name")' aria-invalid="@Invalid("name")" autofocus />
                        </Field>
                        <Field Label="Categoría">
                            <select class="esc-select" @bind="f.CategoryId">
                                @foreach (var c in _categories) { <option value="@c.Id">@c.Name</option> }
                            </select>
                        </Field>
                        <Field Label="Se vende">
                            <select class="esc-select" @bind="f.Unit">
                                <option value="@UnitOfMeasure.Unit">Por unidad</option>
                                <option value="@UnitOfMeasure.Pound">Por libra</option>
                            </select>
                        </Field>
                        <Field Label="Precio RD$ (con ITBIS) *" Error="@Err("price")">
                            <input class="esc-input esc-num" inputmode="decimal" @bind="f.Price" @bind:after='() => Clear("price")' aria-invalid="@Invalid("price")" />
                        </Field>
                        <Field Label="ITBIS *" Error="@Err("itbis")" Hint="Revíselo: va al reporte 607.">
                            @* No default: a careless "Exento" would declare ITBIS 0 in the 607. *@
                            <select class="esc-select" @bind="f.ItbisRate" @bind:after='() => Clear("itbis")' aria-invalid="@Invalid("itbis")">
                                <option value="">Elija…</option>
                                <option value="@ItbisRate.General18">18 %</option>
                                <option value="@ItbisRate.Exempt">Exento</option>
                                <option value="@ItbisRate.Reduced16">16 %</option>
                                <option value="@ItbisRate.Zero">0 %</option>
                            </select>
                        </Field>
                        <Field Label="Precio mayorista" Error="@Err("wholesale")" Hint="Opcional.">
                            <input class="esc-input esc-num" inputmode="decimal" @bind="f.WholesalePrice" @bind:after='() => Clear("wholesale")' aria-invalid="@Invalid("wholesale")" />
                        </Field>
                        <Field Label="PLU de la balanza" Error="@Err("plu")" Hint="Opcional. Hasta 6 números.">
                            <input class="esc-input" inputmode="numeric" maxlength="6" @bind="f.Plu" @bind:after='() => Clear("plu")' aria-invalid="@Invalid("plu")" />
                        </Field>
                        @if (f.Id is null)
                        {
                            <Field Label="Costo sin ITBIS" Error="@Err("cost")">
                                <input class="esc-input esc-num" inputmode="decimal" @bind="f.Cost" @bind:after='() => Clear("cost")' aria-invalid="@Invalid("cost")" />
                            </Field>
                            <Field Label="Existencia inicial" Error="@Err("stock")">
                                <input class="esc-input esc-num" inputmode="decimal" @bind="f.InitialStock" @bind:after='() => Clear("stock")' aria-invalid="@Invalid("stock")" />
                            </Field>
                            <Field Label="Código de barras" Hint="Opcional.">
                                <input class="esc-input" maxlength="50" @bind="f.Barcode" />
                            </Field>
                        }
                        <Field Label="Existencia mínima" Error="@Err("minimum")" Hint="Avisa cuando quede menos.">
                            <input class="esc-input esc-num" inputmode="decimal" @bind="f.MinimumStock" @bind:after='() => Clear("minimum")' aria-invalid="@Invalid("minimum")" />
                        </Field>
                        <Field Label="Existencia máxima" Error="@Err("maximum")" Hint="Opcional. El pedido sugerido completa hasta aquí.">
                            <input class="esc-input esc-num" inputmode="decimal" @bind="f.MaximumStock" @bind:after='() => Clear("maximum")' aria-invalid="@Invalid("maximum")" />
                        </Field>
                    </div>
                    <div class="esc-col" style="gap:0">
                        <label class="esc-check"><input type="checkbox" @bind="f.SellWithoutStock" /> Se puede vender aunque no haya existencia</label>
                        @if (f.Id is not null)
                        {
                            <label class="esc-check"><input type="checkbox" @bind="f.IsActive" /> Activo (aparece en la caja)</label>
                        }
                    </div>
                    @if (f.Id is not null)
                    {
                        @* TK-239: boxes and packs, each with its units, price and barcode. *@
                        <section class="esc-col" style="gap:8px" aria-label="Presentaciones">
                            <div class="esc-row" style="justify-content:space-between">
                                <strong>Presentaciones (caja, paquete…)</strong>
                                @if (_pres is null) { <Button OnClick="() => EditPresentation(null)"><Icon Name="plus" /> Agregar presentación</Button> }
                            </div>
                            @if (_presentations.Count > 0)
                            {
                                <div class="esc-table-wrap">
                                    <table class="esc-table">
                                        <thead><tr><th>Nombre</th><th class="esc-num">Unidades</th><th class="esc-num">Precio</th><th>Código de barras</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var p in _presentations)
                                            {
                                                <tr>
                                                    <td>@p.Name @if (!p.IsActive) { <span class="esc-pill esc-pill--neutral" style="margin-left:6px">Inactiva</span> }</td>
                                                    <td class="esc-num">@p.Factor.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)</td>
                                                    <td class="esc-num">@Format.WithCurrency(p.Price)</td>
                                                    <td>@(BarcodeOf(p.Id) ?? "—")</td>
                                                    <td class="esc-num"><Button class="esc-button esc-button--small" aria-label="@($"Editar {p.Name}")" OnClick="() => EditPresentation(p)">Editar</Button></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @if (_pres is { } pf)
                            {
                                <div class="esc-form-grid">
                                    <Field Label="Nombre *" Hint="Por ejemplo: Caja de 12."><input class="esc-input" maxlength="60" aria-label="Nombre de la presentación" @bind="pf.Name" /></Field>
                                    <Field Label="Unidades que trae *"><input class="esc-input esc-num" inputmode="decimal" aria-label="Unidades de la presentación" @bind="pf.Factor" /></Field>
                                    <Field Label="Precio RD$ (con ITBIS) *"><input class="esc-input esc-num" inputmode="decimal" aria-label="Precio de la presentación" @bind="pf.Price" /></Field>
                                    <Field Label="Código de barras" Hint="Opcional."><input class="esc-input" maxlength="50" aria-label="Código de barras de la presentación" @bind="pf.Barcode" /></Field>
                                </div>
                                @if (pf.Id is not null) { <label class="esc-check"><input type="checkbox" @bind="pf.IsActive" /> Activa (se vende en la caja)</label> }
                                @if (_presError is not null) { <Notice Title="@_presError" /> }
                                <div class="esc-row">
                                    <Button OnClick="() => _pres = null">Cancelar</Button>
                                    <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="SavePresentationAsync">Guardar presentación</Button>
                                </div>
                            }
                        </section>
                    }
                    @if (_error is not null) { <Notice Title="@_error" /> }
                </ChildContent>
                <Footer>
                    <Button OnClick="() => _editing = null" Shortcut="Esc">Cancelar</Button>
                    <Button Variant="Button.Variants.Primary" Disabled="_sending" OnClick="SaveAsync">@(_sending ? "Guardando…" : "Guardar")</Button>
                </Footer>
            </Dialog>
        }
    </ChildContent>
</Admin>

@code {
    private sealed class ProductForm
    {
        public Guid? Id; public int Version; public string Name = ""; public Guid CategoryId; public UnitOfMeasure Unit = UnitOfMeasure.Unit;
        public string? Plu, Barcode, Price, WholesalePrice, Cost = "0", InitialStock = "0", MinimumStock = "0", MaximumStock = "0";
        public ItbisRate? ItbisRate; public bool SellWithoutStock = true, IsActive = true;
    }

    private List<Category> _categories = [];
    private List<ProductSummary> _products = [];
    private string? _search, _category, _error, _categoryName, _categoryError;
    private string _categoryColor = "#0B5CAD";
    private ProductForm? _editing;
    private bool _loading = true, _sending, _newCategory;
    private readonly Dictionary<string, string> _errors = [];
    private CancellationTokenSource? _typing;

    private string? Err(string field) => _errors.GetValueOrDefault(field);
    private string Invalid(string field) => _errors.ContainsKey(field) ? "true" : "false";
    private void Clear(string field) => _errors.Remove(field);
    /// <summary>"27.8 lb" or "12": the owner reads stock, not the scale's thousandths.</summary>
    private static string Stock(decimal value, string unit) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + (unit == "Pound" ? " lb" : "");
    private string Color(string category) => _categories.Find(c => c.Name == category)?.Color ?? "var(--text-3)";

    protected override async Task OnInitializedAsync()
    {
        _categories = (await Api.GetAsync<List<Category>>("/api/inventory/categories")).Value ?? [];
        await LoadAsync();
    }

    /// <summary>Search while typing, a moment after the last key.</summary>
    private async Task SearchAsync()
    {
        _typing?.Cancel();
        _typing = new CancellationTokenSource();
        try { await Task.Delay(250, _typing.Token); } catch (TaskCanceledException) { return; }
        await LoadAsync();
    }

    private const int PageSize = 50;
    private int _page = 1;
    private bool _hasMore;

    private async Task<List<ProductSummary>> PageAsync(int page)
    {
        var q = $"search={Uri.EscapeDataString(_search ?? "")}&includeInactive=true&page={page}" + (string.IsNullOrEmpty(_category) ? "" : $"&categoryId={_category}");
        var list = (await Api.GetAsync<List<ProductSummary>>($"/api/inventory/products?{q}")).Value ?? [];
        _hasMore = list.Count == PageSize;
        return list;
    }

    private async Task LoadAsync()
    {
        _page = 1;
        (_products, _loading) = (await PageAsync(1), false);
    }

    private async Task MoreAsync()
    {
        _sending = true;
        _products.AddRange(await PageAsync(++_page));
        _sending = false;
    }

    private void New()
    {
        _errors.Clear();
        (_editing, _error) = (new ProductForm { CategoryId = Guid.TryParse(_category, out var c) ? c : _categories[0].Id }, null);
    }

    private async Task EditAsync(Guid id)
    {
        if (!Session.Can("products.manage")) return;
        var r = await Api.GetAsync<ProductDetail>($"/api/inventory/products/{id}");
        if (r.Value is not { } p) return;
        string N(decimal? v) => v?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) ?? "";
        _errors.Clear();
        (_presentations, _barcodes, _pres) = ([.. p.Presentations ?? []], [.. p.Barcodes ?? []], null);
        (_editing, _error) = (new ProductForm
        {
            Id = p.Id, Version = p.Version, Name = p.Name, CategoryId = p.CategoryId, Unit = p.Unit, Plu = p.Plu, ItbisRate = p.ItbisRate,
            Price = N(p.Price), WholesalePrice = N(p.WholesalePrice), MinimumStock = N(p.MinimumStock), MaximumStock = N(p.MaximumStock), SellWithoutStock = p.SellWithoutStock, IsActive = p.IsActive,
        }, null);
    }

    private sealed class PresentationForm
    {
        public Guid? Id; public string Name = ""; public string? Factor, Price, Barcode, OldBarcode; public decimal? WholesalePrice; public bool IsActive = true;
    }

    private List<ProductPresentation> _presentations = [];
    private List<ProductBarcode> _barcodes = [];
    private PresentationForm? _pres;
    private string? _presError;

    private string? BarcodeOf(Guid presentationId) => _barcodes.Find(b => b.PresentationId == presentationId)?.Code;

    private void EditPresentation(ProductPresentation? p)
    {
        string N(decimal v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        _presError = null;
        _pres = p is null ? new PresentationForm()
            : new PresentationForm { Id = p.Id, Name = p.Name, Factor = N(p.Factor), Price = N(p.Price), WholesalePrice = p.WholesalePrice, IsActive = p.IsActive, Barcode = BarcodeOf(p.Id), OldBarcode = BarcodeOf(p.Id) };
    }

    /// <summary>Saves the presentation, then its barcode (a changed code replaces the old one).</summary>
    private async Task SavePresentationAsync()
    {
        if (_editing?.Id is not { } productId || _pres is not { } pf) return;
        var factor = Format.ParseNumber(pf.Factor);
        var price = Format.ParseNumber(pf.Price);
        if (string.IsNullOrWhiteSpace(pf.Name) || factor is not > 0 || price is not > 0) { _presError = "Escriba el nombre, las unidades y el precio (mayores que cero)."; return; }
        _sending = true;
        var body = new { Name = pf.Name.Trim(), Factor = factor, Price = price, pf.WholesalePrice, pf.IsActive };
        Guid? saved = pf.Id;
        Problem? problem;
        if (pf.Id is { } id) problem = (await Api.PutAsync<Empty>($"/api/inventory/products/{productId}/presentations/{id}", body)).Problem;
        else
        {
            var created = await Api.PostAsync<Created>($"/api/inventory/products/{productId}/presentations", body);
            (saved, problem) = (created.Value?.Id, created.Problem);
        }
        if (problem is not null) saved = null;
        var barcode = string.IsNullOrWhiteSpace(pf.Barcode) ? null : pf.Barcode.Trim();
        if (saved is { } presentationId && barcode != pf.OldBarcode)
        {
            if (pf.OldBarcode is { } old) problem = (await Api.DeleteAsync<Empty>($"/api/inventory/products/{productId}/barcodes/{Uri.EscapeDataString(old)}")).Problem;
            if (problem is null && barcode is not null)
                problem = (await Api.PostAsync<Empty>($"/api/inventory/products/{productId}/barcodes", new { Code = barcode, PresentationId = presentationId })).Problem;
        }
        _sending = false;
        if (problem is not null) _presError = problem.Code == "Inventory.DuplicateBarcode" ? "Ese código de barras ya lo tiene otro producto." : problem.Message;
        else _pres = null;
        if ((await Api.GetAsync<ProductDetail>($"/api/inventory/products/{productId}")).Value is { } d)
            (_presentations, _barcodes) = ([.. d.Presentations ?? []], [.. d.Barcodes ?? []]);
    }

    private async Task CreateCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_categoryName)) { _categoryError = "Escriba el nombre de la categoría."; return; }
        var r = await Api.PostAsync<Created>("/api/inventory/categories", new { Name = _categoryName.Trim(), Color = _categoryColor.ToUpperInvariant(), Notes = Array.Empty<string>() });
        if (!r.Ok) { _error = r.Problem!.Message; return; }
        (_newCategory, _categoryName, _error) = (false, null, null);
        _categories = (await Api.GetAsync<List<Category>>("/api/inventory/categories")).Value ?? [];
    }

    /// <summary>Checks every field at once and says next to each one what is wrong.</summary>
    private bool Validate(ProductForm f)
    {
        _errors.Clear();
        static bool Bad(string? text, bool optional = true) => string.IsNullOrWhiteSpace(text) ? !optional : Format.ParseNumber(text) is not >= 0;
        if (string.IsNullOrWhiteSpace(f.Name)) _errors["name"] = "Escriba el nombre.";
        if (Format.ParseNumber(f.Price) is not > 0) _errors["price"] = "Escriba un precio mayor que cero.";
        if (f.ItbisRate is null) _errors["itbis"] = "Elija el ITBIS del producto.";
        if (Bad(f.WholesalePrice)) _errors["wholesale"] = "Escriba un número o déjelo vacío.";
        if (!string.IsNullOrWhiteSpace(f.Plu) && !f.Plu.Trim().All(char.IsAsciiDigit)) _errors["plu"] = "Solo números.";
        if (f.Id is null && Bad(f.Cost)) _errors["cost"] = "Escriba un número (0 si no lo sabe).";
        if (f.Id is null && Bad(f.InitialStock)) _errors["stock"] = "Escriba un número (0 si no hay).";
        if (Bad(f.MinimumStock)) _errors["minimum"] = "Escriba un número (0 si no aplica).";
        if (Bad(f.MaximumStock)) _errors["maximum"] = "Escriba un número (0 si no aplica).";
        else if (Format.ParseNumber(f.MaximumStock) is > 0 and var max && max < (Format.ParseNumber(f.MinimumStock) ?? 0)) _errors["maximum"] = "No puede ser menor que el mínimo.";
        return _errors.Count == 0;
    }

    private async Task SaveAsync()
    {
        if (_editing is not { } f) return;
        _error = null;
        if (!Validate(f)) return;
        var rate = f.ItbisRate!.Value;
        var price = Format.ParseNumber(f.Price)!.Value;
        var wholesale = Format.ParseNumber(f.WholesalePrice);
        var minimum = Format.ParseNumber(f.MinimumStock) ?? 0;
        var maximum = Format.ParseNumber(f.MaximumStock) ?? 0;
        var plu = string.IsNullOrWhiteSpace(f.Plu) ? null : f.Plu.Trim();
        _sending = true;
        Problem? p;
        if (f.Id is null)
        {
            var barcodes = string.IsNullOrWhiteSpace(f.Barcode) ? null : new[] { f.Barcode.Trim() };
            p = (await Api.PostAsync<Created>("/api/inventory/products", new CreateProduct(f.Name.Trim(), f.CategoryId, f.Unit, plu, rate, price, wholesale,
                Format.ParseNumber(f.Cost) ?? 0, f.SellWithoutStock, minimum, barcodes, Format.ParseNumber(f.InitialStock) ?? 0, maximum))).Problem;
        }
        else
        {
            p = (await Api.PutAsync<Empty>($"/api/inventory/products/{f.Id}", new UpdateProduct(f.Version, f.Name.Trim(), f.CategoryId, f.Unit, plu, rate,
                price, wholesale, f.SellWithoutStock, minimum, f.IsActive, maximum))).Problem;
        }
        _sending = false;
        if (p is null)
        {
            _editing = null;
            await LoadAsync();
            return;
        }
        switch (p.Code)
        {
            case "Inventory.DuplicatePlu": _errors["plu"] = "Ese PLU ya lo tiene otro producto."; break;
            case "Inventory.DuplicateBarcode": _error = "Ese código de barras ya lo tiene otro producto."; break;
            case "Concurrency": _error = "Alguien cambió este producto mientras lo editaba. Ciérrelo y ábralo de nuevo."; break;
            case "Inventory.NoPricePermission": _errors["price"] = "Su usuario no puede cambiar precios."; break;
            default: _error = p.Message; break;
        }
    }
}
