@page "/admin/purchasing/dgii"
@inject TokiApi Api
@inject Session Session
@inject NavigationManager Nav

@* TK-223: the Excel of received NCF / e-CF from the DGII Oficina Virtual, crossed with the purchases and expenses in Toki. *@
<Admin Title="Cruce con la DGII" Subtitle="Suba el Excel de comprobantes recibidos que baja de la Oficina Virtual y vea qué falta en Toki antes del 606.">
    <ChildContent>
        <SectionTabs Label="Compras" Tabs="SectionTabs.Purchasing(Session)" />
        <div class="esc-card" style="padding:16px">
            <Field Label="Excel de comprobantes recibidos (.xlsx, .xls o .csv)" Hint="Oficina Virtual de la DGII → consulta de comprobantes recibidos del mes → exportar a Excel. Toki solo lo lee: no se guarda.">
                <Microsoft.AspNetCore.Components.Forms.InputFile class="esc-input" accept=".xlsx,.xls,.csv"OnChange="UploadAsync" disabled="@_sending" />
            </Field>
            @if (_sending) { <span class="esc-muted">Cruzando…</span> }
        </div>
        @if (_notice is not null) { <Notice Kind="Notice.Kinds.Success" Title="@_notice" /> }
        @if (_error is not null) { <Notice Title="@_error" /> }

        @if (_result is { } r)
        {
            <span class="esc-muted">@r.Rows comprobantes en el Excel · @r.Matched cuadran · @r.Missing faltan en Toki · @r.Differences con montos distintos · @r.Duplicates repetidos · @r.OnlyInToki solo en Toki</span>
            <Segmented Label="Mostrar" Options="Filters" Value="@_filter" ValueChanged="f => _filter = f" />
            <div class="esc-card esc-table-wrap esc-table-wrap--tall">
                <table class="esc-table esc-table--wide">
                    <thead><tr><th>Suplidor</th><th class="esc-hide-sm">Fecha</th><th>NCF</th><th class="esc-num">DGII</th><th class="esc-num esc-hide-sm">Toki</th><th>Estado</th><th><span class="esc-visually-hidden">Acción</span></th></tr></thead>
                    <tbody>
                        @foreach (var m in r.Items.Where(m => _filter == "all" || m.Status == _filter))
                        {
                            <tr>
                                <td><span style="font-weight:600">@(m.Name ?? $"RNC {m.Rnc}")</span><span class="esc-table__sub">RNC @m.Rnc@(m.Row is { } row ? $" · fila {row}" : "")</span></td>
                                <td class="esc-hide-sm" style="white-space:nowrap">@(m.Date is { } d ? AdminNames.Day(d) : "")</td>
                                <td style="font-variant-numeric:tabular-nums">@m.Ncf</td>
                                <td class="esc-num">@(m.DgiiTotal is { } t ? Format.Amount(t) : "")<span class="esc-table__sub">@(m.DgiiItbis is { } i ? $"ITBIS {Format.Amount(i)}" : "")</span></td>
                                <td class="esc-num esc-hide-sm">@(m.TokiTotal is { } tt ? Format.Amount(tt) : "")<span class="esc-table__sub">@(m.TokiItbis is { } ti ? $"ITBIS {Format.Amount(ti)}" : "")</span></td>
                                <td><span class="esc-pill @(m.Status switch { "Matched" => "esc-pill--success", "Missing" or "Difference" or "Duplicate" => "esc-pill--warning", _ => "esc-pill--neutral" })">@StatusText(m)</span></td>
                                <td style="white-space:nowrap">
                                    @if (m is { Status: "Missing", Date: not null, DgiiTotal: > 0 })
                                    {
                                        <Button Disabled="_sending" OnClick="() => DraftAsync(m)">Crear compra en borrador</Button>
                                        @if (Session.Can("payables.pay"))
                                        {
                                            <Button Variant="Button.Variants.Ghost" Disabled="_sending" OnClick="() => ExpenseAsync(m)">Es un gasto</Button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</Admin>

@code {
    private static readonly IReadOnlyList<(string, string)> Filters =
        [("Missing", "Faltan"), ("Difference", "Diferencias"), ("Duplicate", "Repetidos"), ("OnlyInToki", "Solo en Toki"), ("all", "Todos")];

    private DgiiCross? _result;
    private string _filter = "Missing";
    private string? _error, _notice;
    private bool _sending;
    private byte[]? _file;
    private string _fileName = "";

    private static string StatusText(DgiiMatch m) => m.Status switch
    {
        "Matched" => m.DocumentStatus == "Draft" ? "En borrador" : "Cuadra",
        "Missing" => "Falta en Toki",
        "Difference" => "Monto distinto",
        "Duplicate" => "Repetido",
        _ => "No está en la DGII",
    };

    private async Task UploadAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        (_error, _notice) = (null, null);
        using var copy = new MemoryStream();
        try
        {
            await using var stream = e.File.OpenReadStream(10_000_000);
            await stream.CopyToAsync(copy);
        }
        catch (IOException) { _error = "El archivo pasa de 10 MB."; return; }
        (_file, _fileName) = (copy.ToArray(), e.File.Name);
        await CrossAsync();
    }

    private async Task CrossAsync()
    {
        if (_file is null) return;
        _sending = true;
        var r = await Api.PostAsync<DgiiCross>("/api/purchasing/dgii-reconciliation", new { File = Convert.ToBase64String(_file), Name = _fileName }, TimeSpan.FromMinutes(1));
        _sending = false;
        if (r.Problem is { } p) { _error = p.Message; return; }
        _result = r.Value;
        if (_result is { Missing: 0, Differences: 0, Duplicates: 0 }) _filter = "all";
    }

    /// <summary>One click: the draft has the supplier (created from the RNC if needed), NCF, date and totals; the products are added in Compras.</summary>
    private async Task DraftAsync(DgiiMatch m)
    {
        (_error, _notice) = (null, null);
        _sending = true;
        var r = await Api.PostAsync<DraftFromDgiiCreated>("/api/purchasing/dgii-reconciliation/draft",
            new DraftFromDgii(m.Rnc, m.Name, m.Ncf, m.Date!.Value, m.DgiiTotal!.Value, m.DgiiItbis ?? 0));
        _sending = false;
        if (r.Problem is { } p) { _error = p.Message; return; }
        _notice = $"Borrador de {r.Value!.Supplier} creado en Compras ({m.Ncf}). Ábralo, agregue los productos y recíbalo.";
        await CrossAsync();
    }

    /// <summary>Opens Gastos with the row filled in: the person picks the 606 type and the description, and saves.</summary>
    private async Task ExpenseAsync(DgiiMatch m)
    {
        _sending = true;
        var s = await Api.PostAsync<SupplierFound>("/api/purchasing/dgii-reconciliation/supplier", new { m.Rnc, m.Name });
        _sending = false;
        if (s.Problem is { } p) { _error = p.Message; return; }
        var subtotal = m.DgiiTotal!.Value - (m.DgiiItbis ?? 0);
        Nav.NavigateTo($"admin/purchasing/expenses?supplier={s.Value!.Id}&ncf={m.Ncf}&date={m.Date:yyyy-MM-dd}&subtotal={subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)}&itbis={(m.DgiiItbis ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture)}");
    }
}
