@page "/admin/purchasing/received"
@inject TokiApi Api
@inject Session Session

@* TK-154: the e-CF suppliers sent to the business (received and acknowledged by Toki's cloud, TK-152), to record them as purchases and, optionally,
   approve or reject them commercially (signed and sent from this PC). TK-151/TK-246: the consent that lets the cloud receive for the business,
   with this PC signing each acknowledgement (default) or, while the cloud offers it, a copy of the certificate in the cloud. *@
<Admin Title="Comprobantes recibidos" Subtitle="Las facturas electrónicas que le envían sus suplidores. Regístrelas como compra para el 606.">
    <ChildContent>
        <SectionTabs Label="Compras" Tabs="SectionTabs.Purchasing(Session)" />
        @if (_message is not null)
        {
            <Notice Kind="_messageKind" Title="@_message" />
        }

        @if (Session.Can("fiscal.manage"))
        {
            <form class="esc-card esc-setting" @onsubmit="ConsentAsync" novalidate>
                <div class="esc-setting__about">
                    <h2>Receptor en la nube</h2>
                    <p>La DGII exige que todo emisor electrónico reciba los comprobantes de sus suplidores las 24 horas. La nube de Toki los recibe por usted; cada acuse de recibo lo firma esta PC con su certificado.</p>
                </div>
                <div class="esc-setting__body">
                    @if (_receiver is { Active: true } r && !_changing)
                    {
                        <dl class="esc-dl">
                            <dt>RNC</dt><dd>@r.Rnc</dd>
                            <dt>Firma</dt><dd>@(r.SigningMode == CloudCustody ? "Copia del certificado en la nube" : "En esta PC (el certificado no sale de la tienda)")</dd>
                            <dt>Certificado</dt><dd>@r.Subject</dd>
                            <dt>Vence</dt><dd>@(r.NotAfterUtc is { } until ? Format.ShortDate(until) : "")</dd>
                            <dt>Autorizado por</dt><dd>@r.OwnerName (dueño) y @r.HolderName (titular), el @(r.ConsentedUtc is { } at ? Format.ShortDate(at) : "")</dd>
                        </dl>
                        @if (r.SigningMode != CloudCustody)
                        {
                            <Notice Kind="Notice.Kinds.Warning" Title="Mantenga esta PC encendida y con internet">
                                Si está apagada, la nube guarda lo que llegue y le pide al suplidor que lo envíe otra vez; el acuse se firma cuando la PC vuelve.
                            </Notice>
                        }
                        <p class="esc-muted">Registre estas direcciones en la DGII (postulación y "Mantenimiento Directorio FE"):</p>
                        @foreach (var u in r.Urls ?? [])
                        {
                            <dl class="esc-dl">
                                <dt>@Names.FiscalEnvironment(u.Environment switch { "testecf" => "TesteCF", "certecf" => "CerteCF", _ => "eCF" })</dt>
                                <dd><span class="esc-table__sub">Recepción: @u.Reception</span><span class="esc-table__sub">Aprobación comercial: @u.Approval</span><span class="esc-table__sub">Autenticación: @u.Authentication</span></dd>
                            </dl>
                        }
                        <div class="esc-form-actions">
                            <Button Disabled="_sending" OnClick="() => _changing = true">Cambiar la forma de firmar</Button>
                            <Button Variant="Button.Variants.Danger" Disabled="_sending" OnClick="RevokeAsync">@(_confirmingRevoke ? "¿Retirar? Toque otra vez" : "Retirar el permiso")</Button>
                        </div>
                    }
                    else
                    {
                        <fieldset class="esc-col" style="gap:6px;border:0;padding:0">
                            <legend>¿Quién firma los acuses de recibo?</legend>
                            <label class="esc-check"><input type="radio" name="mode" checked="@(Mode != CloudCustody)" @onchange="() => _mode = StoreSigned" /> Esta PC, con el certificado instalado (recomendado)</label>
                            <label class="esc-check"><input type="radio" name="mode" checked="@(Mode == CloudCustody)" disabled="@(_receiver?.CloudCustodyAvailable != true)" @onchange="() => _mode = CloudCustody" />
                                Una copia del certificado en la nube @(_receiver?.CloudCustodyAvailable == true ? "" : "(próximamente)")</label>
                        </fieldset>
                        @if (Mode == CloudCustody)
                        {
                            <Notice Kind="Notice.Kinds.Info" Title="Lo que usted autoriza">
                                Toki guarda en la nube una copia <strong>no exportable</strong> de su certificado digital. Con ella <strong>solo</strong> firma acuses de recibo
                                y aprobaciones comerciales; <strong>nunca</strong> facturas, notas, anulaciones ni semillas de la DGII. Cada firma queda registrada y la puede
                                ver en el panel. Puede retirar el permiso cuando quiera: la llave se borra (Azure la puede recuperar durante 30 días). Ni el archivo ni la
                                contraseña se guardan.
                            </Notice>
                            <div class="esc-form-grid">
                                <Field Label="Certificado (.p12 o .pfx)" Error="@Err("file")">
                                    <Microsoft.AspNetCore.Components.Forms.InputFile class="esc-input" accept=".p12,.pfx" OnChange="PickAsync" />
                                </Field>
                                <Field Label="Contraseña del certificado">
                                    <input class="esc-input" type="password" autocomplete="off" maxlength="200" @bind="_password" />
                                </Field>
                            </div>
                        }
                        else
                        {
                            <Notice Kind="Notice.Kinds.Info" Title="Lo que usted autoriza">
                                La nube recibe los comprobantes de sus suplidores y le pide a esta PC que firme <strong>solo</strong> el acuse de recibo de cada uno, con el
                                certificado instalado aquí: el certificado <strong>no sale</strong> de la tienda. Esta PC firma una prueba de que el RNC es suyo. Las
                                aprobaciones comerciales las firma y las envía esta PC. Si la PC está apagada, el suplidor lo vuelve a intentar.
                            </Notice>
                        }
                        <div class="esc-form-grid">
                            <Field Label="Nombre del dueño" Error="@Err("owner")">
                                <input class="esc-input" maxlength="150" @bind="_owner" />
                            </Field>
                            <Field Label="Nombre del titular del certificado" Error="@Err("holder")">
                                <input class="esc-input" maxlength="150" @bind="_holder" />
                            </Field>
                        </div>
                        <label class="esc-check"><input type="checkbox" @bind="_accepted" /> El dueño y el titular leímos y aceptamos lo anterior.</label>
                        @if (Err("accepted") is { } e) { <p class="esc-field__error">@e</p> }
                        <div class="esc-form-actions">
                            <Button Type="submit" Variant="Button.Variants.Primary" Disabled="_sending">Activar el receptor</Button>
                            @if (_changing) { <Button Disabled="_sending" OnClick="() => _changing = false">Cancelar</Button> }
                        </div>
                    }
                </div>
            </form>
        }

        <section class="esc-card esc-card--padded" aria-labelledby="received-title">
            <div class="esc-card__head">
                <h2 id="received-title" class="esc-card__title">Recibidos de suplidores</h2>
                <span class="esc-card__aside">Llegan a la nube y bajan solos en menos de un minuto</span>
            </div>
            @if (_received.Count == 0)
            {
                <EmptyState Icon="receipt" Title="Todavía no hay comprobantes recibidos">Cuando un suplidor le envíe una factura electrónica, aparece aquí.</EmptyState>
            }
            else
            {
                <div class="esc-table-wrap">
                    <table class="esc-table">
                        <thead><tr><th>Suplidor</th><th>e-NCF</th><th class="esc-hide-sm">Fecha</th><th class="esc-num">Total</th><th>Aprobación comercial</th><th><span class="esc-visually-hidden">Acciones</span></th></tr></thead>
                        <tbody>
                            @foreach (var d in _received)
                            {
                                <tr><td>@d.IssuerName<span class="esc-table__sub esc-muted">RNC @d.IssuerRnc@(d.Environment == "ecf" ? "" : " · prueba")</span></td>
                                    <td><span style="font-weight:600;font-variant-numeric:tabular-nums">@d.ENcf</span>
                                        @if (InConflict(d)) { <span class="esc-pill esc-pill--danger">Llegó dos veces distinto</span><span class="esc-table__sub esc-muted">Confirme con el suplidor cuál es el verdadero</span> }</td>
                                    <td class="esc-hide-sm">@d.IssuedOn.ToString("dd/MM/yyyy")</td>
                                    <td class="esc-num">@Format.Amount(d.Total)<span class="esc-table__sub esc-muted">ITBIS @Format.Amount(d.Itbis)</span></td>
                                    <td>@switch (d.Approval)
                                        {
                                            case "Approved": <span class="esc-pill esc-pill--success">Aprobado</span> break;
                                            case "Rejected": <span class="esc-pill esc-pill--danger">Rechazado</span><span class="esc-table__sub esc-muted">@d.ApprovalReason</span> break;
                                            default: <span class="esc-muted">Opcional</span> break;
                                        }
                                        @if (d.ApprovalMessage is { } m) { <span class="esc-table__sub esc-muted">@m</span> }</td>
                                    <td class="esc-num">
                                        @* R9 #5: a test environment's e-CF is not a purchase; one in conflict waits until the supplier says which is real. *@
                                        @if (d.Environment == "ecf" && !InConflict(d)) { <a class="esc-button esc-button--small" href="@($"admin/purchasing?fromEcf={d.Id}")">Registrar compra</a> }
                                        @if (Session.Can("fiscal.manage") && (d.Approval is null || d.ApprovalMessage is not null))
                                        {
                                            @if (_rejecting == d.Id)
                                            {
                                                <input class="esc-input" maxlength="250" placeholder="Motivo del rechazo" aria-label="Motivo del rechazo" @bind="_reason" />
                                                <Button Variant="Button.Variants.Danger" class="esc-button esc-button--danger esc-button--small" Disabled="_sending" OnClick="() => DecideAsync(d, false)">Rechazar</Button>
                                            }
                                            else
                                            {
                                                @if (d.Approval is null or "Approved")
                                                {
                                                    <Button class="esc-button esc-button--small" Disabled="_sending" OnClick="() => DecideAsync(d, true)">@(d.Approval is null ? "Aprobar" : "Reenviar")</Button>
                                                }
                                                @if (d.Approval is null or "Rejected")
                                                {
                                                    <Button class="esc-button esc-button--small" Disabled="_sending" OnClick="() => StartReject(d)">@(d.Approval is null ? "Rechazar" : "Reenviar")</Button>
                                                }
                                            }
                                        }
                                    </td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </ChildContent>
</Admin>

@code {
    private EcfReceiverStatus? _receiver;
    private List<ReceivedEcf> _received = [];
    private string? _message, _password, _owner, _holder, _reason;
    private Notice.Kinds _messageKind;
    private byte[]? _file;
    private bool _accepted, _sending, _confirmingRevoke, _changing;
    private const string StoreSigned = "StoreSigned", CloudCustody = "CloudCustody";
    private string? _mode;

    /// <summary>TK-246: what the owner picked, else the cloud's default; CloudCustody only while the cloud offers it.</summary>
    private string Mode => (_mode ?? _receiver?.DefaultSigningMode) == CloudCustody && _receiver?.CloudCustodyAvailable == true ? CloudCustody : StoreSigned;
    private Guid? _rejecting;
    private readonly Dictionary<string, string> _errors = [];

    private string? Err(string key) => _errors.GetValueOrDefault(key);

    /// <summary>R9 #1: the cloud keeps every version of an e-NCF that arrived with different content; here they show side by side.</summary>
    private bool InConflict(ReceivedEcf d) =>
        _received.Any(o => o.Id != d.Id && o.Environment == d.Environment && o.IssuerRnc == d.IssuerRnc && o.ENcf == d.ENcf);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (Session.Can("fiscal.manage")) _receiver = (await Api.GetAsync<EcfReceiverStatus>("/api/fiscal/receiver")).Value;
        _received = (await Api.GetAsync<List<ReceivedEcf>>("/api/fiscal/received")).Value ?? [];
    }

    private void Show(Problem? p, string success) => (_messageKind, _message) = p is null ? (Notice.Kinds.Success, success) : (p.Kind, p.Message);

    private async Task PickAsync(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _errors.Remove("file");
        using var file = new MemoryStream();
        try
        {
            await using var stream = e.File.OpenReadStream(200_000);
            await stream.CopyToAsync(file);
            _file = file.ToArray();
        }
        catch (IOException) { (_file, _errors["file"]) = (null, "Ese archivo es demasiado grande para ser un certificado."); }
    }

    /// <summary>StoreSigned: this PC signs the cloud's challenge. CloudCustody: the password goes once with the file to the cloud (which imports it
    /// non-exportable) and is forgotten here whatever the answer.</summary>
    private async Task ConsentAsync()
    {
        _errors.Clear();
        var mode = Mode;
        if (mode == CloudCustody && _file is null) _errors["file"] = "Elija el archivo .p12 o .pfx del certificado.";
        if (string.IsNullOrWhiteSpace(_owner)) _errors["owner"] = "Escriba el nombre del dueño.";
        if (string.IsNullOrWhiteSpace(_holder)) _errors["holder"] = "Escriba el nombre del titular del certificado.";
        if (!_accepted) _errors["accepted"] = "Sin la aceptación del dueño y del titular no se activa el receptor.";
        if (_errors.Count > 0) return;
        _sending = true;
        var r = await Api.PostAsync<EcfReceiverStatus>("/api/fiscal/receiver/consent", new
        {
            Mode = mode, File = mode == CloudCustody ? Convert.ToBase64String(_file!) : null, Password = mode == CloudCustody ? _password : null,
            OwnerName = _owner, HolderName = _holder, Accepted = _accepted,
        });
        (_sending, _password) = (false, null);
        if (r.Ok) (_file, _accepted, _changing, _mode) = (null, false, false, null);
        await LoadAsync();
        Show(r.Problem, "El receptor está activo. Registre las direcciones en la DGII.");
    }

    private async Task RevokeAsync()
    {
        if (!_confirmingRevoke) { (_confirmingRevoke, _message) = (true, null); return; }
        (_confirmingRevoke, _sending) = (false, true);
        var r = await Api.PostAsync<EcfReceiverStatus>("/api/fiscal/receiver/revoke");
        _sending = false;
        await LoadAsync();
        Show(r.Problem, "Permiso retirado: la nube ya no recibe comprobantes por usted.");
    }

    private void StartReject(ReceivedEcf d) => (_rejecting, _reason, _message) = (d.Id, d.ApprovalReason, null);

    /// <summary>TK-246: signed here and sent from here to the supplier and the DGII; pressing again only retries what did not go.</summary>
    private async Task DecideAsync(ReceivedEcf d, bool approve)
    {
        _sending = true;
        var r = await Api.PostAsync<ReceivedEcf>($"/api/fiscal/received/{d.Id}/approval", new { Approve = approve, Reason = approve ? null : _reason });
        (_sending, _rejecting, _reason) = (false, null, null);
        await LoadAsync();
        Show(r.Problem, r.Value?.ApprovalMessage ?? $"{(approve ? "Aprobación" : "Rechazo")} de {d.ENcf} enviado al suplidor y a la DGII.");
    }
}
