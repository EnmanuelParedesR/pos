@page "/admin/purchasing/payables"
@inject TokiApi Api
@inject Session Session

<Admin Title="Por pagar" Subtitle="Lo que se les debe a los suplidores, por días de atraso. Toque uno para ver su cuenta o pagarle.">
    <ChildContent>
        <SectionTabs Label="Compras" Tabs="SectionTabs.Purchasing(Session)" />
        <div class="esc-card esc-stats">
            <div class="esc-stat">
                <span class="esc-stat__label"><Icon Name="wallet" Size="16" /> Se debe en total</span>
                <span class="esc-stat__value">@(_items is null ? "—" : Format.WithCurrency(_items.Sum(i => i.Total)))</span>
                <span class="esc-stat__note">@(_items is null ? "" : $"{_items.Count} {(_items.Count == 1 ? "suplidor" : "suplidores")}")</span>
            </div>
            <div class="esc-stat">
                <span class="esc-stat__label"><Icon Name="alert" Size="16" /> Vencido</span>
                <span class="esc-stat__value" style="color:@(Overdue > 0 ? "var(--error)" : "inherit")">@(_items is null ? "—" : Format.WithCurrency(Overdue))</span>
                <span class="esc-stat__note">@(Overdue > 0 ? "Ya pasó la fecha de pago" : "Nada vencido")</span>
            </div>
            <div class="esc-stat">
                <span class="esc-stat__label"><Icon Name="calendar" Size="16" /> Por vencer</span>
                <span class="esc-stat__value">@(_items is null ? "—" : Format.WithCurrency(_items.Sum(i => i.NotYetDue)))</span>
                <span class="esc-stat__note">Todavía en plazo</span>
            </div>
        </div>
        <div class="esc-card esc-table-wrap esc-table-wrap--tall">
            <table class="esc-table esc-table--wide">
                <thead><tr><th>Suplidor</th><th class="esc-num esc-hide-sm">Por vencer</th><th class="esc-num esc-hide-sm">1–30 días</th><th class="esc-num esc-hide-sm">31–60</th><th class="esc-num esc-hide-sm">61–90</th><th class="esc-num esc-hide-sm">Más de 90</th><th class="esc-num">Total</th><th class="esc-table__chev"><span class="esc-visually-hidden">Pagar</span></th></tr></thead>
                <tbody>
                    @if (_items is null)
                    {
                        @for (var i = 0; i < 4; i++)
                        {
                            <tr><td><Skeleton Width="160px" /></td>@for (var j = 0; j < 5; j++) { <td class="esc-hide-sm"><Skeleton /></td> }<td><Skeleton /></td><td></td></tr>
                        }
                    }
                    else
                    {
                        @foreach (var p in _items)
                        {
                            var overdue = p.Total - p.NotYetDue;
                            <tr class="selectable" tabindex="0" @onclick="() => Open(p.SupplierId, false)" @onkeydown='e => { if (e.Key == "Enter") Open(p.SupplierId, false); }'>
                                <td style="font-weight:600">@p.Supplier<span class="esc-table__sub esc-only-sm">@(overdue > 0 ? $"Vencido {Format.WithCurrency(overdue)}" : "Nada vencido")</span></td>
                                <td class="esc-num esc-hide-sm">@Cell(p.NotYetDue)</td>
                                <td class="esc-num esc-hide-sm">@Cell(p.Overdue1To30)</td>
                                <td class="esc-num esc-hide-sm">@Cell(p.Overdue31To60)</td>
                                <td class="esc-num esc-hide-sm">@Cell(p.Overdue61To90)</td>
                                <td class="esc-num esc-hide-sm" style="color:@(p.OverdueOver90 > 0 ? "var(--error)" : "inherit")">@Cell(p.OverdueOver90)</td>
                                <td class="esc-num" style="font-weight:700">@Format.Amount(p.Total)</td>
                                <td class="esc-table__chev"><button type="button" class="esc-button esc-button--small" @onclick="() => Open(p.SupplierId, true)" @onclick:stopPropagation="true">Pagar</button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            @if (_items is { Count: 0 })
            {
                <EmptyState Icon="check" Title="No se le debe a nadie">@(_message ?? "Las compras y gastos a crédito salen aquí hasta que se pagan.")</EmptyState>
            }
        </div>

        @if (_account is { } id)
        {
            <SupplierAccount SupplierId="id" Pay="_pay" OnClose="() => _account = null" OnChanged="LoadAsync" />
        }
    </ChildContent>
</Admin>

@code {
    private List<SupplierPayable>? _items;
    private Guid? _account;
    private bool _pay;
    private string? _message;

    private decimal Overdue => _items?.Sum(i => i.Total - i.NotYetDue) ?? 0;

    private static string Cell(decimal value) => value == 0 ? "—" : Format.Amount(value);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var r = await Api.GetAsync<List<SupplierPayable>>("/api/reports/payables");
        (_items, _message) = (r.Value ?? [], r.Problem?.Message);
    }

    private void Open(Guid supplier, bool pay) => (_account, _pay) = (supplier, pay);
}
