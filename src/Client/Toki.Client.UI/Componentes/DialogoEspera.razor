@inject TokiApi Api
@inject Carrito Carrito

<Dialogo Titulo="@(Carrito.Vacio ? "Ventas en espera" : "Poner la venta en espera")" Subtitulo="Se borran al cerrar la caja." OnCerrar="OnCerrar">
    <ChildContent>
        @if (!Carrito.Vacio)
        {
            <label class="esc-campo">
                <span>Nombre para encontrarla</span>
                <input @ref="_entrada" class="esc-entrada" maxlength="60" @bind="_etiqueta" @onkeydown='e => e.Key == "Enter" ? GuardarAsync() : Task.CompletedTask' />
            </label>
            <div class="esc-subtitulo">@Carrito.Articulos líneas · @Formato.ConMoneda(Carrito.Total)</div>
        }
        else if (_lista is null)
        {
            <div class="esc-tenue">Cargando…</div>
        }
        else if (_lista.Count == 0)
        {
            <div class="esc-tenue">No hay ventas en espera.</div>
        }
        else
        {
            <div class="esc-tarjeta esc-tabla-marco">
                <table class="esc-tabla">
                    <thead><tr><th>Hora</th><th>Nombre</th><th class="esc-num">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in _lista)
                        {
                            <tr>
                                <td>@Formato.Hora(v.CreadaUtc)</td>
                                <td style="font-weight:600">@v.Etiqueta</td>
                                <td class="esc-num">@Formato.Pesos(v.Total)</td>
                                <td class="esc-num">
                                    <div class="esc-fila" style="justify-content:flex-end">
                                        <Boton Variante="Boton.Variantes.Fantasma" OnClick="() => DescartarAsync(v)">Descartar</Boton>
                                        <Boton Variante="Boton.Variantes.Primario" OnClick="() => RetomarAsync(v)">Retomar</Boton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        @if (_error is not null)
        {
            <Aviso Titulo="@_error" />
        }
    </ChildContent>
    <Pie>
        <Boton OnClick="OnCerrar" Tecla="Esc">Cerrar</Boton>
        @if (!Carrito.Vacio)
        {
            <Boton Variante="Boton.Variantes.Primario" Tecla="Enter" OnClick="GuardarAsync">Poner en espera</Boton>
        }
    </Pie>
</Dialogo>

@code {
    [Parameter, EditorRequired] public Guid TurnoId { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    private List<VentaEnEspera>? _lista;
    private string? _etiqueta, _error;
    private ElementReference _entrada;

    protected override async Task OnInitializedAsync()
    {
        _etiqueta = Carrito.Cliente?.Nombre ?? $"Venta de las {Formato.Hora(DateTimeOffset.Now)}";
        if (Carrito.Vacio) await CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Carrito.Vacio) await _entrada.FocusAsync();
    }

    private async Task CargarAsync()
    {
        var r = await Api.GetAsync<List<VentaEnEspera>>($"/api/ventas/en-espera?turnoId={TurnoId}");
        (_lista, _error) = (r.Valor ?? [], r.Problema?.Mensaje);
    }

    private async Task GuardarAsync()
    {
        var contenido = System.Text.Json.JsonSerializer.SerializeToElement(Carrito.Guardar(), TokiApi.Json);
        var r = await Api.PutAsync<Vacio>("/api/ventas/en-espera", new { Id = Carrito.VentaId, TurnoId, Etiqueta = string.IsNullOrWhiteSpace(_etiqueta) ? "Venta" : _etiqueta.Trim(), Contenido = contenido, Total = Carrito.Total });
        if (!r.Ok) { _error = r.Problema!.Mensaje; return; }
        Carrito.Vaciar();
        await OnCerrar.InvokeAsync();
    }

    private async Task RetomarAsync(VentaEnEspera v)
    {
        var guardado = System.Text.Json.JsonSerializer.Deserialize<CarritoGuardado>(v.Contenido, TokiApi.Json);
        if (guardado is null) { _error = "No se pudo leer esa venta."; return; }
        var r = await Api.DeleteAsync<Vacio>($"/api/ventas/en-espera/{v.Id}?turnoId={TurnoId}");
        if (!r.Ok) { _error = r.Problema!.Mensaje; return; }
        Carrito.Restaurar(guardado);
        await OnCerrar.InvokeAsync();
    }

    private async Task DescartarAsync(VentaEnEspera v)
    {
        var r = await Api.DeleteAsync<Vacio>($"/api/ventas/en-espera/{v.Id}?turnoId={TurnoId}");
        _error = r.Problema?.Mensaje;
        await CargarAsync();
    }
}
