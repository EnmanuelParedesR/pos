@inherits LayoutComponentBase
@implements IDisposable
@inject Sesion Sesion
@inject TokiApi Api
@inject NavigationManager Nav

@if (_listo)
{
    <div style="min-height:100vh;display:flex;flex-direction:column">
        <header class="esc-barra-estado">
            <div class="esc-barra-estado__grupo">
                <Logo SobreMarco="true" />
                @if (Sesion.Turno is { } t)
                {
                    <span style="font-weight:600">@t.Caja</span>
                }
                @if (Sesion.Nombre is { } nombre)
                {
                    <span>@nombre</span>
                }
                @if (Sesion.Turno is { } turno)
                {
                    <span class="tenue">Turno abierto @Formato.Hora(turno.AbiertoUtc)</span>
                }
            </div>
            <div class="esc-barra-estado__grupo">
                @if (_enLinea)
                {
                    <span class="tenue">En línea</span>
                }
                else
                {
                    <span class="esc-sin-internet" role="status">Sin conexión con el servidor · reintentando</span>
                }
                <span style="font-weight:600">@Formato.Hora(DateTimeOffset.Now)</span>
            </div>
        </header>
        <main style="flex:1 1 auto;display:flex;flex-direction:column;min-height:0">
            @Body
        </main>
    </div>
    <DialogoAutorizacion />
}

@code {
    private static readonly string[] Libres = ["configurar", "entrar"];
    private bool _listo, _enLinea = true;
    private Timer? _reloj;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        Sesion.Cambio += AlCambiar;
        Nav.LocationChanged += AlNavegar;
        Guardia();
        _listo = true;
        // Every 15 s: the clock and whether the store server answers (amber, never red: principle 3).
        _reloj = new Timer(_ => InvokeAsync(VerificarAsync), null, TimeSpan.Zero, TimeSpan.FromSeconds(15));
    }

    private async Task VerificarAsync()
    {
        var r = await Api.GetAsync<Vacio>("/health");
        _enLinea = r.Problema?.Codigo != Problema.SinServidor;
        StateHasChanged();
    }

    private void AlNavegar(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => Guardia();

    private void Guardia()
    {
        var ruta = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (!Sesion.Emparejado && ruta != "configurar") Nav.NavigateTo("configurar");
        else if (Sesion.Emparejado && !Sesion.Abierta && !Libres.Contains(ruta)) Nav.NavigateTo("entrar");
    }

    private void AlCambiar() => InvokeAsync(() =>
    {
        if (Sesion.Expirada) Nav.NavigateTo("entrar?expirada=1");
        StateHasChanged();
    });

    public void Dispose()
    {
        Sesion.Cambio -= AlCambiar;
        Nav.LocationChanged -= AlNavegar;
        _reloj?.Dispose();
    }
}
