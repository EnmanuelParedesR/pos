@page "/venta"
@inject TokiApi Api
@inject Sesion Sesion
@inject Carrito Carrito
@inject NavigationManager Nav

<div class="venta" @onkeydown="TeclaAsync">
    <section class="venta__izquierda" aria-label="Productos">
        <form class="esc-fila" style="flex-wrap:nowrap" @onsubmit="EscanearAsync">
            <label class="esc-tarjeta" style="flex:1 1 auto;display:flex;align-items:center;gap:10px;padding:0 12px;border-color:var(--borde-control);border-width:2px">
                <Icono Nombre="codigo" />
                <input @ref="_escaner" class="venta__escaner" placeholder="Escanee o escriba el código o PLU" aria-label="Código de barras o PLU"
                       autocomplete="off" @bind="_codigo" @bind:event="oninput" />
                <Tecla>F2</Tecla>
            </label>
            <Boton Tipo="submit" Tecla="Enter">Agregar</Boton>
        </form>

        @if (_aviso is { } a)
        {
            <Aviso Tipo="a.Tipo" Titulo="@a.Titulo">
                <ChildContent>@a.Detalle</ChildContent>
                <Accion><Boton Variante="Boton.Variantes.Fantasma" aria-label="Cerrar aviso" OnClick="() => _aviso = null"><Icono Nombre="x" /></Boton></Accion>
            </Aviso>
        }

        <div class="esc-fila" role="group" aria-label="Categorías">
            @foreach (var c in _categorias)
            {
                <button type="button" class="esc-chip" aria-pressed="@(c.Id == _categoria ? "true" : "false")" @onclick="() => CategoriaAsync(c.Id)">@c.Nombre</button>
            }
        </div>

        <div class="venta__mosaicos">
            @foreach (var p in _productos)
            {
                <button type="button" class="esc-mosaico" @onclick="() => TocarAsync(p)">
                    <span class="esc-mosaico__nombre">@p.Nombre</span>
                    <span class="esc-mosaico__precio">@Formato.ConMoneda(p.Precio)@(p.Unidad == "Libra" ? " / lb" : "")</span>
                </button>
            }
            @if (_productos.Count == 0)
            {
                <div class="esc-tenue">@(_categorias.Count == 0 ? "No hay productos todavía. Agréguelos en Administración → Productos." : "Esta categoría no tiene productos.")</div>
            }
        </div>
    </section>

    <section class="venta__carrito esc-tarjeta" aria-label="Venta actual">
        <div class="venta__cliente">
            <button type="button" class="esc-boton esc-boton--fantasma" style="justify-content:flex-start;flex:1 1 auto;min-width:0" @onclick="() => Abrir(Panel.Cliente)">
                <Icono Nombre="usuario" />
                <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(Carrito.Cliente?.Nombre ?? Carrito.NombreManual ?? "Cliente de contado")</span>
                <span class="esc-pildora esc-pildora--neutra">@(Carrito.Comprobante == TipoEcf.CreditoFiscal31 ? "Crédito fiscal" : "Consumo")</span>
                <Tecla>F6</Tecla>
            </button>
        </div>

        <ol class="venta__lineas" aria-label="Líneas">
            @foreach (var l in Carrito.Lineas)
            {
                <li class="venta__linea @(l.Id == Carrito.Seleccionada ? "activa" : "")" @onclick="() => Carrito.Seleccionada = l.Id" aria-current="@(l.Id == Carrito.Seleccionada)">
                    <div style="min-width:0">
                        <div style="font-weight:600">@l.Nombre</div>
                        <div class="esc-subtitulo">
                            @Formato.Cantidad(l.Cantidad, l.Unidad) × @Formato.Pesos(l.Precio)
                            @if (l.PrecioCambiado is not null) { <span> · precio cambiado</span> }
                            @if (l.MontoDescuento > 0) { <span> · desc. −@Formato.Pesos(l.MontoDescuento)</span> }
                            @if (l.CodigoEtiqueta is not null) { <span> · etiqueta</span> }
                        </div>
                    </div>
                    <div class="esc-num" style="font-size:var(--t-17);font-weight:700">@Formato.Pesos(l.Total)</div>
                </li>
            }
        </ol>

        @if (Carrito.Vacio && _ultima is { } v)
        {
            <div class="venta__lista" role="status">
                <Aviso Tipo="Aviso.Tipos.Exito" Titulo="@($"Venta guardada · {v.ENcf}")" />
                @if (v.Cambio > 0)
                {
                    <div class="esc-etiqueta">Devuelta</div>
                    <Dinero Valor="v.Cambio" Tamano="52" />
                }
                <Boton OnClick="() => Abrir(Panel.Comprobante)"><Icono Nombre="impresora" /> Ver factura</Boton>
            </div>
        }
        else if (Carrito.Vacio)
        {
            <div class="venta__lista esc-tenue">Escanee el primer producto.</div>
        }

        <div class="venta__totales">
            @if (Carrito.Descuentos > 0)
            {
                <div class="esc-fila" style="justify-content:space-between"><span class="esc-tenue">Descuentos</span><span>−@Formato.Pesos(Carrito.Descuentos)</span></div>
            }
            <div class="esc-fila" style="justify-content:space-between;align-items:baseline">
                <span class="esc-etiqueta">Total · @Carrito.Articulos @(Carrito.Articulos == 1 ? "línea" : "líneas")</span>
                <Dinero Valor="Carrito.Total" Tamano="44" />
            </div>
            <Boton Variante="Boton.Variantes.Primario" Dinero="true" Tecla="F12" Deshabilitado="@(Carrito.Vacio || Sesion.Turno is null)" OnClick="() => Abrir(Panel.Cobrar)">Cobrar</Boton>
        </div>
    </section>
</div>

<nav class="esc-barra-teclas" aria-label="Teclas">
    <button type="button" @onclick="() => AbrirLinea(Panel.Cantidad)" disabled="@(Carrito.LineaSeleccionada is null)"><Tecla>F3</Tecla> Cantidad</button>
    <button type="button" @onclick="() => AbrirLinea(Panel.Precio)" disabled="@(Carrito.LineaSeleccionada is null)"><Tecla>F4</Tecla> Precio</button>
    <button type="button" @onclick="() => Abrir(Panel.Espera)"><Tecla>F5</Tecla> Espera</button>
    <button type="button" @onclick="() => AbrirLinea(Panel.Descuento)" disabled="@(Carrito.LineaSeleccionada is null)"><Tecla>F7</Tecla> Descuento</button>
    <button type="button" @onclick="Quitar" disabled="@(Carrito.LineaSeleccionada is null)"><Tecla>Supr</Tecla> Quitar línea</button>
    <button type="button" @onclick="() => Abrir(Panel.Anular)" disabled="@Carrito.Vacio"><Tecla>F8</Tecla> Anular venta</button>
    <button type="button" @onclick="() => Abrir(Panel.Caja)"><Tecla>F9</Tecla> Caja</button>
</nav>

@switch (_panel)
{
    case Panel.Cobrar:
        <DialogoCobro TurnoId="Sesion.Turno!.TurnoId" OnCerrar="Cerrar" OnVendida="VendidaAsync" />
        break;
    case Panel.Cantidad or Panel.Precio or Panel.Descuento when Carrito.LineaSeleccionada is { } l:
        <DialogoLinea Linea="l" Modo="@_panel.ToString()" OnCerrar="Cerrar" OnListo="CambiarLinea" />
        break;
    case Panel.Peso when _pendiente is { } p:
        <DialogoLinea Linea="@(new LineaCarrito(p.ProductoId, p.PresentacionId, p.Nombre, p.Unidad, p.Precio, 0m))" Modo="Peso" OnCerrar="Cerrar" OnListo="AgregarPesado" />
        break;
    case Panel.Cliente:
        <DialogoCliente OnCerrar="Cerrar" />
        break;
    case Panel.Espera:
        <DialogoEspera TurnoId="Sesion.Turno!.TurnoId" OnCerrar="Cerrar" />
        break;
    case Panel.Caja:
        <MenuCaja OnCerrar="Cerrar" />
        break;
    case Panel.Comprobante when _ultima is { } u:
        <DialogoComprobante Comprobante="u.Comprobante" OnCerrar="Cerrar" />
        break;
    case Panel.Anular:
        <Dialogo Titulo="¿Anular esta venta?" Subtitulo="Se borran todas las líneas. Todavía no se ha cobrado nada." OnCerrar="Cerrar">
            <Pie>
                <Boton OnClick="Cerrar" Tecla="Esc">No, seguir vendiendo</Boton>
                <Boton Variante="Boton.Variantes.Peligro" OnClick="Anular" Tecla="Enter" autofocus>Sí, anular</Boton>
            </Pie>
        </Dialogo>
        break;
}

@code {
    private enum Panel { Ninguno, Cobrar, Cantidad, Precio, Descuento, Peso, Cliente, Espera, Caja, Comprobante, Anular }
    private sealed record AvisoVenta(Aviso.Tipos Tipo, string Titulo, string? Detalle = null);

    private Panel _panel;
    private string? _codigo;
    private AvisoVenta? _aviso;
    private List<Categoria> _categorias = [];
    private Guid? _categoria;
    private List<ProductoResumen> _productos = [];
    private ProductoPorCodigo? _pendiente;
    private VentaRegistrada? _ultima;
    private ElementReference _escaner;
    private bool _enfocar = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Sesion.Abierta) return;
        Sesion.Turno ??= (await Api.GetAsync<TurnoActual>("/api/caja/turnos/actual")).Valor;
        if (Sesion.Turno is null)
        {
            Nav.NavigateTo("abrir-caja");
            return;
        }
        _categorias = (await Api.GetAsync<List<Categoria>>("/api/inventario/categorias")).Valor?.Where(c => c.Activa).ToList() ?? [];
        if (_categorias.Count > 0) await CategoriaAsync(_categorias[0].Id);
    }

    // The scanner never gets lost (principle 2): focus goes back to it after every action.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enfocar && _panel == Panel.Ninguno)
        {
            _enfocar = false;
            try { await _escaner.FocusAsync(); }
            catch (InvalidOperationException) { } // not rendered yet (redirecting)
        }
    }

    private async Task CategoriaAsync(Guid id)
    {
        _categoria = id;
        _productos = (await Api.GetAsync<List<ProductoResumen>>($"/api/inventario/productos?categoriaId={id}")).Valor ?? [];
        _enfocar = true;
    }

    private async Task EscanearAsync()
    {
        var codigo = _codigo?.Trim();
        _codigo = "";
        _enfocar = true;
        if (string.IsNullOrEmpty(codigo)) return;
        if (Carrito.TieneEtiqueta(codigo))
        {
            _aviso = new(Aviso.Tipos.Aviso, "Esta etiqueta ya está en la venta.", "Cada etiqueta de peso se cobra una sola vez. Si es otro paquete, pese de nuevo.");
            return;
        }
        var r = await Api.GetAsync<ProductoPorCodigo>($"/api/inventario/productos/por-codigo/{Uri.EscapeDataString(codigo)}");
        if (r.Valor is not { } p)
        {
            _aviso = r.Problema!.Codigo switch
            {
                "Inventario.CodigoNoEncontrado" => new(Aviso.Tipos.Error, $"No se encontró el código {codigo}.", "Búsquelo en las categorías o escriba su PLU."),
                "Inventario.EtiquetaMalLeida" => new(Aviso.Tipos.Error, "La etiqueta se leyó mal.", "Vuelva a escanearla o escriba el PLU."),
                "Inventario.ProductoInactivo" => new(Aviso.Tipos.Aviso, "Ese producto está desactivado.", "Un supervisor puede activarlo en Productos."),
                _ => new(Aviso.Tipos.Error, r.Problema.Mensaje),
            };
            return;
        }
        Agregar(p, codigo);
    }

    private void Agregar(ProductoPorCodigo p, string? codigo)
    {
        var conEtiqueta = p.CantidadEtiqueta is not null || p.MontoEtiqueta is not null;
        if (p.Unidad == "Libra" && !conEtiqueta)
        {
            // shortcut: the weight is typed (no scale driver yet, Toki.Hardware.Balanzas); read IScale here when it exists.
            _pendiente = p;
            _panel = Panel.Peso;
            return;
        }
        Carrito.Agregar(p, conEtiqueta ? codigo : null);
        _ultima = null;
        _aviso = p.Notas.Length > 0 ? new(Aviso.Tipos.Info, string.Join(" · ", p.Notas)) : null;
        _enfocar = true;
    }

    private void TocarAsync(ProductoResumen p) =>
        Agregar(new ProductoPorCodigo(p.Id, null, p.Nombre, p.Unidad, p.TasaItbis, p.Precio, p.PrecioMayorista, 1m, null, null, [], p.Existencia), null);

    private void AgregarPesado(LineaCarrito l)
    {
        if (_pendiente is { } p && l.Cantidad > 0)
        {
            Carrito.Agregar(p, null, l.Cantidad);
            _ultima = null;
            _aviso = null;
        }
        Cerrar();
    }

    private void CambiarLinea(LineaCarrito l)
    {
        Carrito.Cambiar(l);
        Cerrar();
    }

    private void Quitar()
    {
        if (Carrito.Seleccionada is { } id) Carrito.Quitar(id);
        _enfocar = true;
    }

    private void Anular()
    {
        Carrito.Vaciar();
        _aviso = new(Aviso.Tipos.Info, "Venta anulada antes de cobrar.");
        Cerrar();
    }

    private void Abrir(Panel p)
    {
        if (p == Panel.Cobrar && (Carrito.Vacio || Sesion.Turno is null)) return;
        if (p == Panel.Anular && Carrito.Vacio) return;
        _panel = p;
    }

    private void AbrirLinea(Panel p)
    {
        if (Carrito.LineaSeleccionada is not null) _panel = p;
    }

    private void Cerrar()
    {
        (_panel, _pendiente, _enfocar) = (Panel.Ninguno, null, true);
    }

    private Task VendidaAsync(VentaRegistrada v)
    {
        _ultima = v;
        _aviso = null;
        Carrito.Vaciar();
        Cerrar();
        return Task.CompletedTask;
    }

    private async Task TeclaAsync(KeyboardEventArgs e)
    {
        if (_panel != Panel.Ninguno) return; // the open dialog owns the keyboard
        switch (e.Key)
        {
            case "F2": _enfocar = true; break;
            case "F3": AbrirLinea(Panel.Cantidad); break;
            case "F4": AbrirLinea(Panel.Precio); break;
            case "F5": Abrir(Panel.Espera); break;
            case "F6": Abrir(Panel.Cliente); break;
            case "F7": AbrirLinea(Panel.Descuento); break;
            case "F8": Abrir(Panel.Anular); break;
            case "F9": Abrir(Panel.Caja); break;
            case "F12": Abrir(Panel.Cobrar); break;
            case "Delete": Quitar(); break;
            case "ArrowUp" or "ArrowDown" when Carrito.Lineas.Count > 0:
                var i = Carrito.Lineas.ToList().FindIndex(l => l.Id == Carrito.Seleccionada);
                i = Math.Clamp(i + (e.Key == "ArrowUp" ? -1 : 1), 0, Carrito.Lineas.Count - 1);
                Carrito.Seleccionada = Carrito.Lineas[i].Id;
                break;
        }
        await Task.CompletedTask;
    }
}
