@page "/configurar"
@inject TokiApi Api
@inject Sesion Sesion
@inject NavigationManager Nav

<div class="esc-pagina" style="max-width:960px;margin:0 auto;width:100%">
    <div>
        <h1 class="esc-titulo">Configurar este equipo</h1>
        <p class="esc-subtitulo">Se hace una sola vez. Elija si esta es la PC principal de una tienda nueva o una caja más de una tienda que ya usa Toki.</p>
    </div>

    <div class="esc-fila" role="tablist" aria-label="Modo">
        <button type="button" role="tab" class="esc-chip" aria-pressed="@(_modo == Modo.Unir ? "true" : "false")" aria-selected="@(_modo == Modo.Unir)" @onclick="() => Cambiar(Modo.Unir)">Unir a una tienda</button>
        <button type="button" role="tab" class="esc-chip" aria-pressed="@(_modo == Modo.Instalar ? "true" : "false")" aria-selected="@(_modo == Modo.Instalar)" @onclick="() => Cambiar(Modo.Instalar)">Primera instalación</button>
    </div>

    @if (_modo == Modo.Unir)
    {
        <form class="esc-tarjeta esc-tarjeta--relleno esc-col" style="gap:16px;max-width:520px" @onsubmit="UnirAsync">
            <div>
                <div style="font-size:var(--t-20);font-weight:700">Código del dueño</div>
                <div class="esc-subtitulo">En la PC principal: Configuración → Equipos → Generar código. Vale 10 minutos.</div>
            </div>
            <label class="esc-campo">
                <span>Código de 8 dígitos</span>
                <input class="esc-entrada esc-entrada--grande" inputmode="numeric" autocomplete="off" maxlength="8" @bind="_codigo" @bind:event="oninput"
                       aria-invalid="@(_error is not null)" style="letter-spacing:0.3em" autofocus />
            </label>
            @if (_error is not null)
            {
                <Aviso Titulo="@_error" />
            }
            <Boton Tipo="submit" Variante="Boton.Variantes.Primario" Tecla="Enter" Deshabilitado="@(_codigo?.Length != 8 || _enviando)">Unir este equipo</Boton>
        </form>
    }
    else
    {
        <form class="esc-tarjeta esc-tarjeta--relleno esc-col" style="gap:16px;max-width:620px" @onsubmit="InstalarAsync">
            <div>
                <div style="font-size:var(--t-20);font-weight:700">Tienda nueva</div>
                <div class="esc-subtitulo">Esta PC queda como la principal y usted como administrador. Después agrega cajeros y cajas.</div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px">
                <label class="esc-campo"><span>Su nombre</span><input class="esc-entrada" @bind="_nombre" maxlength="100" autocomplete="name" /></label>
                <label class="esc-campo"><span>Su código para entrar</span><input class="esc-entrada" @bind="_usuario" maxlength="20" autocomplete="off" /></label>
                <label class="esc-campo"><span>PIN (4 a 8 dígitos)</span><input class="esc-entrada" type="password" inputmode="numeric" @bind="_pin" maxlength="8" autocomplete="new-password" /></label>
                <label class="esc-campo"><span>Nombre de este equipo</span><input class="esc-entrada" @bind="_equipo" maxlength="100" /></label>
            </div>
            @if (_error is not null)
            {
                <Aviso Titulo="@_error" />
            }
            <Boton Tipo="submit" Variante="Boton.Variantes.Primario" Deshabilitado="@_enviando">Instalar Toki</Boton>
        </form>
    }
</div>

@code {
    private enum Modo { Unir, Instalar }
    private Modo _modo = Modo.Unir;
    private string? _codigo, _error, _nombre, _usuario, _pin;
    private string _equipo = "PC principal";
    private bool _enviando;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.CargarAsync();
        if (Sesion.Emparejado) Nav.NavigateTo("entrar");
    }

    private void Cambiar(Modo m) => (_modo, _error) = (m, null);

    private async Task UnirAsync()
    {
        _enviando = true;
        var r = await Api.PostAsync<Emparejado>("/api/identidad/dispositivos/emparejar", new { Codigo = _codigo });
        _enviando = false;
        if (r.Valor is { } e)
        {
            await Sesion.EmparejarAsync(e.Token);
            Nav.NavigateTo("entrar");
            return;
        }
        _error = r.Problema!.Codigo switch
        {
            "Identidad.CodigoEmparejamientoInvalido" => "Ese código no sirve o ya venció. Pida uno nuevo al dueño.",
            "Licencia.LimiteCajas" => "La licencia no permite más cajas. El dueño puede revocar una que ya no use.",
            _ => r.Problema.Mensaje,
        };
    }

    private async Task InstalarAsync()
    {
        if (string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_usuario) || _pin is not { Length: >= 4 and <= 8 } || !_pin.All(char.IsAsciiDigit))
        {
            _error = "Complete su nombre, su código y un PIN de 4 a 8 dígitos.";
            return;
        }
        _enviando = true;
        var r = await Api.PostAsync<Instalado>("/api/identidad/instalacion", new Instalar(_nombre.Trim(), _usuario.Trim(), _pin, _equipo.Trim()));
        _enviando = false;
        if (r.Valor is { } i)
        {
            await Sesion.EmparejarAsync(i.TokenDispositivo);
            Nav.NavigateTo("entrar");
            return;
        }
        _error = r.Problema!.Codigo == "Identidad.YaInstalado" ? "Esta tienda ya está instalada. Use \"Unir a una tienda\" con un código del dueño." : r.Problema.Mensaje;
    }
}
