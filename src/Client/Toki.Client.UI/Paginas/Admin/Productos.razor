@page "/admin/productos"
@inject TokiApi Api
@inject Sesion Sesion

<Admin Titulo="Productos" Subtitulo="Precios con ITBIS incluido. Busque por nombre o PLU.">
    <Acciones>
        @if (Sesion.Puede("productos.gestionar"))
        {
            <div class="esc-fila">
                <Boton OnClick="() => _categoriaNueva = true">Nueva categoría</Boton>
                <Boton Variante="Boton.Variantes.Primario" Deshabilitado="@(_categorias.Count == 0)" OnClick="Nuevo"><Icono Nombre="mas" /> Nuevo producto</Boton>
            </div>
        }
    </Acciones>
    <ChildContent>
        <form class="esc-fila" @onsubmit="CargarAsync">
            <label class="esc-tarjeta" style="flex:1 1 280px;display:flex;align-items:center;gap:10px;padding:0 12px;border-color:var(--borde-control)">
                <Icono Nombre="buscar" />
                <input class="venta__escaner" style="height:44px;font-size:var(--t-15);font-weight:400" placeholder="Buscar por nombre o PLU" aria-label="Buscar producto" @bind="_buscar" />
            </label>
            <select class="esc-select" style="width:auto" aria-label="Categoría" @bind="_categoria" @bind:after="CargarAsync">
                <option value="">Todas las categorías</option>
                @foreach (var c in _categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
            <Boton Tipo="submit">Buscar</Boton>
        </form>
        @if (_categorias.Count == 0 && !_cargando)
        {
            <Aviso Tipo="Aviso.Tipos.Info" Titulo="Empiece creando una categoría (por ejemplo Res, Pollo o Colmado) y luego sus productos." />
        }
        <div class="esc-tarjeta esc-tabla-marco">
            <table class="esc-tabla" style="min-width:720px">
                <thead><tr><th>Producto</th><th>Categoría</th><th>Se vende</th><th class="esc-num">Precio RD$</th><th>ITBIS</th><th class="esc-num">Existencia</th></tr></thead>
                <tbody>
                    @foreach (var p in _productos)
                    {
                        <tr class="seleccionable" tabindex="0" @onclick="() => EditarAsync(p.Id)" @onkeydown='e => e.Key == "Enter" ? EditarAsync(p.Id) : Task.CompletedTask'>
                            <td style="font-weight:600">@p.Nombre @if (!p.Activo) { <span class="esc-pildora esc-pildora--neutra">inactivo</span> }</td>
                            <td>@p.Categoria</td>
                            <td>@Nombres.Unidad(p.Unidad)</td>
                            <td class="esc-num" style="font-weight:600">@Formato.Pesos(p.Precio)</td>
                            <td>@Nombres.Itbis(p.TasaItbis)</td>
                            <td class="esc-num" style="@(p.Existencia < 0 ? "color:var(--aviso);font-weight:700" : "")">@(p.Existencia is { } e ? Formato.Cantidad(e, p.Unidad) : "—")</td>
                        </tr>
                    }
                    @if (_productos.Count == 0)
                    {
                        <tr><td colspan="6" class="esc-tenue">@(_cargando ? "Cargando…" : "No hay productos que coincidan.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
</Admin>

@if (_categoriaNueva)
{
    <Dialogo Titulo="Nueva categoría" OnCerrar="() => _categoriaNueva = false">
        <ChildContent>
            <label class="esc-campo"><span>Nombre</span><input class="esc-entrada" maxlength="80" @bind="_nombreCategoria" autofocus /></label>
            <label class="esc-campo"><span>Color del mosaico</span><input type="color" class="esc-entrada" style="padding:4px;width:120px" @bind="_colorCategoria" /></label>
            @if (_error is not null) { <Aviso Titulo="@_error" /> }
        </ChildContent>
        <Pie>
            <Boton OnClick="() => _categoriaNueva = false" Tecla="Esc">Cancelar</Boton>
            <Boton Variante="Boton.Variantes.Primario" OnClick="CrearCategoriaAsync">Crear</Boton>
        </Pie>
    </Dialogo>
}

@if (_editando is { } f)
{
    <Dialogo Titulo="@(f.Id is null ? "Nuevo producto" : "Editar producto")" Ancho="true" OnCerrar="() => _editando = null">
        <ChildContent>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
                <label class="esc-campo" style="grid-column:1/-1"><span>Nombre</span><input class="esc-entrada" maxlength="150" @bind="f.Nombre" autofocus /></label>
                <label class="esc-campo"><span>Categoría</span>
                    <select class="esc-select" @bind="f.CategoriaId">
                        @foreach (var c in _categorias) { <option value="@c.Id">@c.Nombre</option> }
                    </select>
                </label>
                <label class="esc-campo"><span>Se vende</span>
                    <select class="esc-select" @bind="f.Unidad">
                        <option value="@UnidadMedida.Libra">Por libra</option>
                        <option value="@UnidadMedida.Unidad">Por unidad</option>
                    </select>
                </label>
                <label class="esc-campo"><span>PLU (balanza, opcional)</span><input class="esc-entrada" inputmode="numeric" maxlength="6" @bind="f.Plu" /></label>
                <label class="esc-campo"><span>ITBIS</span>
                    <select class="esc-select" @bind="f.TasaItbis">
                        <option value="@TasaItbis.Exento">Exento</option>
                        <option value="@TasaItbis.General18">18 %</option>
                        <option value="@TasaItbis.Reducida16">16 %</option>
                        <option value="@TasaItbis.Cero">0 %</option>
                    </select>
                </label>
                <label class="esc-campo"><span>Precio RD$ (con ITBIS)</span><input class="esc-entrada esc-num" inputmode="decimal" @bind="f.Precio" /></label>
                <label class="esc-campo"><span>Precio mayorista (opcional)</span><input class="esc-entrada esc-num" inputmode="decimal" @bind="f.PrecioMayorista" /></label>
                @if (f.Id is null)
                {
                    <label class="esc-campo"><span>Costo sin ITBIS</span><input class="esc-entrada esc-num" inputmode="decimal" @bind="f.Costo" /></label>
                    <label class="esc-campo"><span>Existencia inicial</span><input class="esc-entrada esc-num" inputmode="decimal" @bind="f.Existencia" /></label>
                    <label class="esc-campo"><span>Código de barras (opcional)</span><input class="esc-entrada" maxlength="50" @bind="f.Codigo" /></label>
                }
                <label class="esc-campo"><span>Existencia mínima</span><input class="esc-entrada esc-num" inputmode="decimal" @bind="f.StockMinimo" /></label>
            </div>
            <label class="esc-fila"><input type="checkbox" style="width:22px;height:22px" @bind="f.VenderSinExistencia" /> Se puede vender aunque no haya existencia</label>
            @if (f.Id is not null)
            {
                <label class="esc-fila"><input type="checkbox" style="width:22px;height:22px" @bind="f.Activo" /> Activo (aparece en la caja)</label>
            }
            @if (_error is not null) { <Aviso Titulo="@_error" /> }
        </ChildContent>
        <Pie>
            <Boton OnClick="() => _editando = null" Tecla="Esc">Cancelar</Boton>
            <Boton Variante="Boton.Variantes.Primario" Deshabilitado="_enviando" OnClick="GuardarAsync">Guardar</Boton>
        </Pie>
    </Dialogo>
}

@code {
    private sealed class Ficha
    {
        public Guid? Id; public int Version; public string Nombre = ""; public Guid CategoriaId; public UnidadMedida Unidad = UnidadMedida.Libra;
        public string? Plu, Codigo, Precio, PrecioMayorista, Costo = "0", Existencia = "0", StockMinimo = "0";
        public TasaItbis TasaItbis = TasaItbis.Exento; public bool VenderSinExistencia = true, Activo = true;
    }

    private List<Categoria> _categorias = [];
    private List<ProductoResumen> _productos = [];
    private string? _buscar, _categoria, _error, _nombreCategoria;
    private string _colorCategoria = "#0B5CAD";
    private Ficha? _editando;
    private bool _cargando = true, _enviando, _categoriaNueva;

    protected override async Task OnInitializedAsync()
    {
        _categorias = (await Api.GetAsync<List<Categoria>>("/api/inventario/categorias")).Valor ?? [];
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var q = $"buscar={Uri.EscapeDataString(_buscar ?? "")}&incluirInactivos=true" + (string.IsNullOrEmpty(_categoria) ? "" : $"&categoriaId={_categoria}");
        var r = await Api.GetAsync<List<ProductoResumen>>($"/api/inventario/productos?{q}");
        (_productos, _cargando) = (r.Valor ?? [], false);
    }

    private void Nuevo() => (_editando, _error) = (new Ficha { CategoriaId = Guid.TryParse(_categoria, out var c) ? c : _categorias[0].Id }, null);

    private async Task EditarAsync(Guid id)
    {
        if (!Sesion.Puede("productos.gestionar")) return;
        var r = await Api.GetAsync<ProductoDetalle>($"/api/inventario/productos/{id}");
        if (r.Valor is not { } p) return;
        string N(decimal? v) => v?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) ?? "";
        (_editando, _error) = (new Ficha
        {
            Id = p.Id, Version = p.Version, Nombre = p.Nombre, CategoriaId = p.CategoriaId, Unidad = p.Unidad, Plu = p.Plu, TasaItbis = p.TasaItbis,
            Precio = N(p.Precio), PrecioMayorista = N(p.PrecioMayorista), StockMinimo = N(p.StockMinimo), VenderSinExistencia = p.VenderSinExistencia, Activo = p.Activo,
        }, null);
    }

    private async Task CrearCategoriaAsync()
    {
        var r = await Api.PostAsync<Creado>("/api/inventario/categorias", new { Nombre = _nombreCategoria?.Trim(), Color = _colorCategoria.ToUpperInvariant(), Notas = Array.Empty<string>() });
        if (!r.Ok) { _error = r.Problema!.Mensaje; return; }
        (_categoriaNueva, _nombreCategoria, _error) = (false, null, null);
        _categorias = (await Api.GetAsync<List<Categoria>>("/api/inventario/categorias")).Valor ?? [];
    }

    private async Task GuardarAsync()
    {
        if (_editando is not { } f) return;
        if (Formato.LeerNumero(f.Precio) is not > 0 || string.IsNullOrWhiteSpace(f.Nombre)) { _error = "Escriba el nombre y un precio mayor que cero."; return; }
        var precio = Formato.LeerNumero(f.Precio)!.Value;
        var mayorista = Formato.LeerNumero(f.PrecioMayorista);
        var minimo = Formato.LeerNumero(f.StockMinimo) ?? 0;
        var plu = string.IsNullOrWhiteSpace(f.Plu) ? null : f.Plu.Trim();
        _enviando = true;
        Problema? p;
        if (f.Id is null)
        {
            var codigos = string.IsNullOrWhiteSpace(f.Codigo) ? null : new[] { f.Codigo.Trim() };
            p = (await Api.PostAsync<Creado>("/api/inventario/productos", new CrearProducto(f.Nombre.Trim(), f.CategoriaId, f.Unidad, plu, f.TasaItbis, precio, mayorista,
                Formato.LeerNumero(f.Costo) ?? 0, f.VenderSinExistencia, minimo, codigos, Formato.LeerNumero(f.Existencia) ?? 0))).Problema;
        }
        else
        {
            p = (await Api.PutAsync<Vacio>($"/api/inventario/productos/{f.Id}", new ActualizarProducto(f.Version, f.Nombre.Trim(), f.CategoriaId, f.Unidad, plu, f.TasaItbis,
                precio, mayorista, f.VenderSinExistencia, minimo, f.Activo))).Problema;
        }
        _enviando = false;
        if (p is null)
        {
            _editando = null;
            await CargarAsync();
            return;
        }
        _error = p.Codigo switch
        {
            "Inventario.PluDuplicado" => "Ese PLU ya lo tiene otro producto.",
            "Inventario.CodigoDuplicado" => "Ese código de barras ya lo tiene otro producto.",
            "Concurrencia" => "Alguien cambió este producto mientras lo editaba. Ciérrelo y ábralo de nuevo.",
            "Inventario.SinPermisoPrecios" => "Su usuario no puede cambiar precios.",
            _ => p.Mensaje,
        };
    }
}
