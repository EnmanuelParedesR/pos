@* Talia, the owner's assistant (TK-273): the Abastalia tag in amber with a face, inside a blue circle (amber on blue 4.1:1, face on amber 9.9:1).
   She looks straight at the owner; a mood changes only the eyes and the mouth. Never on the sale, charge or cash count screens (docs/mascota.md). *@
<svg class="esc-talia" aria-hidden="true" width="@Size" height="@Size" viewBox="0 0 120 120">
    <circle cx="60" cy="60" r="60" fill="#0B5CAD"></circle>
    <g transform="translate(60 60) scale(.74) translate(-60 -60)">
        <path d="M44 14 H98 Q106 14 106 22 V98 Q106 106 98 106 H22 Q14 106 14 98 V44 Z M47.5 37 A10.5 10.5 0 1 0 26.5 37 A10.5 10.5 0 1 0 47.5 37 Z" fill="#FFC233" fill-rule="evenodd" stroke="#FFC233" stroke-width="6" stroke-linejoin="round"></path>
        <g fill="#14181D" stroke="#14181D">
            @switch (Mood)
            {
                case Moods.Happy:
                    <path d="M47.5 65 Q54 55 60.5 65 M73.5 65 Q80 55 86.5 65" fill="none" stroke-width="6.5" stroke-linecap="round"></path>
                    <path d="M50 77 Q67 95 84 77" fill="none" stroke-width="7" stroke-linecap="round"></path>
                    break;
                case Moods.Thinking:
                    <circle cx="58" cy="57" r="6.5"></circle>
                    <circle cx="84" cy="57" r="6.5"></circle>
                    <path d="M58 81 Q67 86 76 81" fill="none" stroke-width="7" stroke-linecap="round"></path>
                    break;
                default:
                    <circle cx="54" cy="62" r="6.5"></circle>
                    <circle cx="80" cy="62" r="6.5"></circle>
                    <path d="M52 78 Q67 92 82 78" fill="none" stroke-width="7" stroke-linecap="round"></path>
                    break;
            }
        </g>
    </g>
</svg>

@code {
    public enum Moods { Attentive, Happy, Thinking }

    [Parameter] public int Size { get; set; } = 28;
    [Parameter] public Moods Mood { get; set; }
}
