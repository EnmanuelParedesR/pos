@* Logo C5: the tag with the winking eye and the "a" (TK-267). On the dark frame the word is light; on light surfaces it is dark. *@
<span class="esc-logo" style="font-size:@(Size * 7 / 10)px; color:@(OnFrame ? "var(--frame-text)" : "var(--text)")">
    <svg role="img" aria-label="Abastalia" width="@Size" height="@Size" viewBox="0 0 120 120">
        <path d="M44 24 H96 Q104 24 104 32 V88 Q104 96 96 96 H44 L16 60 Z" fill="#0B5CAD" stroke="#0B5CAD" stroke-width="6" stroke-linejoin="round"></path>
        <circle cx="35" cy="60" r="8" fill="#FFFFFF"></circle>
        <circle cx="32.5" cy="60" r="3.8" fill="#14181D"></circle>
        <path d="M60 50 Q63 44 72 44 Q84 44 84 56 V84 M84 64 H71 Q59 64 59 74 Q59 84 71 84 Q80 84 84 76" fill="none" stroke="#FFFFFF" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    @if (WithName)
    {
        <span aria-hidden="true">abastalia</span>
    }
</span>

@code {
    [Parameter] public int Size { get; set; } = 22;
    [Parameter] public bool WithName { get; set; } = true;
    [Parameter] public bool OnFrame { get; set; }
}
