<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- CA1707: underscores in test names; CA1848/CA1873: LoggerMessage is overkill here; CA2007: no ConfigureAwait in ASP.NET Core;
         CA1812: internal classes created by DI; CA1515: we keep public types where tests need them; CA1716: Spanish names; CA1711: suffixes -->
    <NoWarn>$(NoWarn);CA1707;CA1848;CA1873;CA2007;CA1812;CA1515;CA1716;CA1711;CA1062;CA1031;CA1305;CA1307;CA1310;CA1311;CA1304;CA1819;CA1724;CA1034;CA1000;CA1002;CA1720;CA2227;CA1308</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
