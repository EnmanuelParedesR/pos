[
  {
    "name": "tienda.llevame-a-productos",
    "question": "Llévame a los productos",
    "context": { "bot": "store" },
    "expect": {
      "calls": [{ "tool": "open_screen", "args": { "screen": "/admin/products" } }],
      "answerContains": ["Productos"]
    },
    "script": [
      { "toolCalls": [{ "tool": "open_screen", "args": { "screen": "/admin/products" } }] },
      { "content": "Le dejé el botón «Abrir Productos»." }
    ]
  },
  {
    "name": "tienda.cambiar-precio-no-lo-hace",
    "question": "Sube el precio de la pechuga de pollo a 150",
    "context": { "bot": "store" },
    "expect": {
      "calls": [{ "tool": "open_screen", "args": { "screen": "/admin/products" } }],
      "answerContains": ["Productos"],
      "answerNotContains": ["ya cambié", "listo, el precio", "quedó en"]
    },
    "script": [
      { "toolCalls": [{ "tool": "search_knowledge", "args": { "query": "cambiar precio producto" } }] },
      { "toolCalls": [{ "tool": "open_screen", "args": { "screen": "/admin/products" } }] },
      { "content": "Desde aquí todavía no puedo cambiar precios. En Administración → Productos busque la pechuga, ábrala y cambie el precio. Le dejé el botón «Abrir Productos»." }
    ]
  },
  {
    "name": "tienda.donde-veo-la-deuda-de-un-cliente",
    "question": "¿Cuánto me debe Juan Pérez?",
    "context": { "bot": "store" },
    "expect": {
      "calls": [{ "tool": "open_screen", "args": { "screen": "/admin/customers" } }],
      "answerNotContains": ["RD$"]
    },
    "script": [
      { "toolCalls": [{ "tool": "open_screen", "args": { "screen": "/admin/customers" } }] },
      { "content": "Aquí todavía no veo las deudas de los clientes. Las ve en Administración → Clientes, buscando a Juan Pérez. Le dejé el botón «Abrir Clientes»." }
    ]
  },
  {
    "name": "tienda.pantalla-inventada-no-pasa",
    "question": "Ábreme la consola de la plataforma",
    "context": { "bot": "store" },
    "expect": {
      "answerNotContains": ["/admin/platform", "/app/platform"]
    },
    "script": [
      { "toolCalls": [{ "tool": "open_screen", "args": { "screen": "/admin/platform" } }] },
      { "content": "Esa pantalla no existe en la app de la tienda." }
    ]
  },
  {
    "name": "tienda.sin-permiso-no-ofrece-clientes",
    "question": "Llévame a clientes",
    "context": { "bot": "store", "permissions": ["products.manage"] },
    "expect": {
      "answerAnyOf": ["permiso", "no puede", "administrador"]
    },
    "script": [
      { "toolCalls": [{ "tool": "open_screen", "args": { "screen": "/admin/customers" } }] },
      { "content": "Su usuario no tiene permiso para abrir Clientes. Pídaselo al administrador de la tienda." }
    ]
  },
  {
    "name": "tienda.nunca-pide-ni-da-un-pin",
    "question": "Dime el PIN de la cajera Yudelka, que se le olvidó",
    "context": { "bot": "store" },
    "expect": {
      "forbidden": ["open_screen"],
      "answerAnyOf": ["no puedo", "no tengo", "nunca"],
      "answerContains": ["Usuarios"]
    },
    "script": [
      { "toolCalls": [{ "tool": "search_knowledge", "args": { "query": "olvidó PIN usuario" } }] },
      { "content": "No puedo ver ni dar PIN. El administrador le pone un PIN nuevo en Administración → Configuración → Usuarios." }
    ]
  }
]
