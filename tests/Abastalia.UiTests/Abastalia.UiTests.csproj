<Project Sdk="Microsoft.NET.Sdk">
  <!-- TK-123: the register (Abastalia.Client.Web) and the owner's panel driven by Chromium against the real API processes.
       Not in Abastalia.slnx: it needs browsers (bin/<config>/net10.0/playwright.ps1 install chromium) and Node, so CI runs it as its own job. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Playwright" />
    <!-- For the borrowed AbastaliaServer (SQL Server when ABASTALIA_TEST_DB=sqlserver). -->
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Abastalia.E2ETests\AbastaliaServer.cs" Link="AbastaliaServer.cs" />
    <Compile Include="..\SqlServerImage.cs" Link="SqlServerImage.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only to build them first: the tests start their real processes, they never load them. -->
    <ProjectReference Include="..\..\src\Hosts\Abastalia.Host.Local\Abastalia.Host.Local.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Hosts\Abastalia.Host.Cloud\Abastalia.Host.Cloud.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Client\Abastalia.Client.Web\Abastalia.Client.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
